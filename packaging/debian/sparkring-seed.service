[Unit]
Description=SparkRing one-time worker preparation access
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/sparkring/seed_sshd_config

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p /run/sshd
ExecStart=/usr/sbin/sshd -D -e -f /etc/sparkring/seed_sshd_config
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
