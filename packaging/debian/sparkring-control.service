[Unit]
Description=SparkRing private administration network
Wants=network-online.target
After=network-online.target NetworkManager.service docker.service
Before=sparkring-fabric.service
ConditionPathExists=/etc/sparkring/control.json

[Service]
Type=oneshot
ExecStart=/usr/bin/sparkring node control-up
RemainAfterExit=yes
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
