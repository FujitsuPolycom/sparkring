#!/bin/sh
set -eu
if [ "$1" = configure ]; then
    /usr/bin/sparkring node initialize
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable --now avahi-daemon.service lldpd.service
        systemctl enable sparkring-agent.service
        systemctl restart sparkring-agent.service
        # Restore the units that were enabled when the package was last
        # removed (recorded by prerm). Administration units start at once so
        # the installer can reach this node. The fabric and hairpin units are
        # only enabled for the next boot, because package installation never
        # changes the data network or restarts a ConnectX driver.
        recorded=/var/lib/sparkring/package-enabled-units
        if [ -f "$recorded" ]; then
            while read -r unit; do
                case "$unit" in
                    sparkring-fabric.service|sparkring-hairpin.service) systemctl enable "$unit" ;;
                    sparkring-*) systemctl enable --now "$unit" ;;
                esac
            done < "$recorded"
            rm -f "$recorded"
        fi
    fi
fi
