[Unit]
Description=Check and repair the SparkRing administration tunnel: links, endpoints, firewall rules and DNS (started by its timer, link changes and ConnectX driver restarts)
After=network-online.target
ConditionPathExists=/etc/sparkring/control.json

[Service]
Type=oneshot
ExecStart=/usr/bin/sparkring node control-up
ExecStartPost=/usr/bin/systemctl start --no-block sparkring-control.service sparkring-access.service sparkring-fabric.service
