[Unit]
Description=SparkRing host observations and approved fabric route and setting restoration
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/sparkring node agent
Restart=on-failure
RestartSec=10
RuntimeDirectory=sparkring
RuntimeDirectoryMode=0755
# Shared operator quiet file and research holds must survive package stop/start.
RuntimeDirectoryPreserve=yes
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/run/sparkring

[Install]
WantedBy=multi-user.target
