runtime/transport_profiles/tp2-rocenante-adaptive/roce/** -text whitespace=cr-at-eol
runtime/transport_profiles/tp2-rocenante-adaptive/LICENSE -text whitespace=cr-at-eol

# Canonical sources and generated compatibility exports use identical bytes.
integrations/vllm/** text eol=lf
spark_transport/fabric/** text eol=lf
profiles/** text eol=lf

runtime/releases/glm53-dflash-sircl-overlay/overlay.tar.gz -text
