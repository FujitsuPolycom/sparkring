performance/records/glm53-flash/r33-image020-*-sparkcache-20260911.md text eol=lf
runtime/deepseek0731-gb10/patches/*.patch whitespace=-trailing-space

# Runtime overlays use byte-level hashes; these sources use LF on every platform.
spark_transport/integrations/vllm/*.py text eol=lf
spark_transport/experiments/glm53_rocenante_overlay/** text eol=lf
spark_transport/experiments/cx7_hairpin_diagonal/** text eol=lf
