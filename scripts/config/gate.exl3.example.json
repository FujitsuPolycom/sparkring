{
  "schema": "sparkring-acceptance-gate-config/v1",
  "ssh": {
    "command": ["ssh", "-o", "BatchMode=yes"]
  },
  "runtime": {
    "lock_path": "recipes/glm52-exl3-tr3-3.25bpw.json",
    "attestation_commands": [
      [
        "python",
        "scripts/sparkring_exl3_launcher.py",
        "--site",
        ".sparkring/bootstrap-exl3/site.yaml",
        "--profile",
        ".sparkring/bootstrap-exl3/launch.json",
        "--execute",
        "verify-image"
      ],
      [
        "python",
        "scripts/sparkring_exl3_launcher.py",
        "--site",
        ".sparkring/bootstrap-exl3/site.yaml",
        "--profile",
        ".sparkring/bootstrap-exl3/launch.json",
        "--execute",
        "verify-model"
      ]
    ],
    "timeout_seconds": 1800
  },
  "fabric": {
    "qualifier": "spark_transport/scripts/qualify_direct_cable.py",
    "probe_binary": "/opt/sparkring/bin/spark_transport_probe",
    "iterations": 10000,
    "model_down_probe": {
      "command": ["<YOUR_PUBLIC_MODEL_DOWN_PROBE_ENTRYPOINT>"],
      "per_rank": true,
      "timeout_seconds": 1800
    }
  },
  "launch": {
    "start_command": [
      "python",
      "scripts/sparkring_exl3_lmcache_launcher.py",
      "--site",
      ".sparkring/bootstrap-exl3/site.yaml",
      "--profile",
      ".sparkring/bootstrap-exl3/launch.json",
      "--execute",
      "--confirmation",
      "START-EXL3-LMCACHE-CS512-ALL-FOUR",
      "start"
    ],
    "stop_command": [
      "python",
      "scripts/sparkring_exl3_lmcache_launcher.py",
      "--site",
      ".sparkring/bootstrap-exl3/site.yaml",
      "--profile",
      ".sparkring/bootstrap-exl3/launch.json",
      "--execute",
      "--confirmation",
      "START-EXL3-LMCACHE-CS512-ALL-FOUR",
      "rollback"
    ],
    "rollback_verify_command": [
      "python",
      "scripts/sparkring_exl3_lmcache_launcher.py",
      "--site",
      ".sparkring/bootstrap-exl3/site.yaml",
      "--profile",
      ".sparkring/bootstrap-exl3/launch.json",
      "--execute",
      "verify-rollback"
    ],
    "rank_status_command": [
      "sh",
      "-lc",
      "set -eu; engine=glm52-sparkring-exl3-lmcache-cs512-r{rank}; server=glm52-sparkring-lmcache-cs512-server-r{rank}; test \"$(docker inspect -f '{{.State.Running}}' \"$engine\")\" = true; test \"$(docker inspect -f '{{.State.Running}}' \"$server\")\" = true; test \"$(docker inspect -f '{{.RestartCount}}' \"$engine\")\" = 0; test \"$(docker inspect -f '{{.RestartCount}}' \"$server\")\" = 0; test \"$(docker inspect -f '{{.State.OOMKilled}}' \"$engine\")\" = false; test \"$(docker inspect -f '{{.State.OOMKilled}}' \"$server\")\" = false; test \"$(docker inspect -f '{{index .Config.Labels \"org.sparkring.exl3-profile\"}}' \"$engine\")\" = glm52-exl3-tr3-3.25bpw-lmcache-cs512; test \"$(docker inspect -f '{{index .Config.Labels \"org.sparkring.exl3-profile\"}}' \"$server\")\" = glm52-exl3-tr3-3.25bpw-lmcache-cs512; test \"$(docker inspect -f '{{index .Config.Labels \"org.sparkring.component\"}}' \"$engine\")\" = engine; test \"$(docker inspect -f '{{index .Config.Labels \"org.sparkring.component\"}}' \"$server\")\" = lmcache-server; engine_logs=$(docker logs \"$engine\" 2>&1); server_logs=$(docker logs \"$server\" 2>&1); ! printf '%s' \"$engine_logs\" | grep -E 'CUDA out of memory|OutOfMemoryError|OOMKilled'; ! printf '%s' \"$server_logs\" | grep -E 'CUDA out of memory|OutOfMemoryError|OOMKilled'; curl -fsS http://127.0.0.1:18081/healthcheck >/dev/null; curl -fsS http://127.0.0.1:18081/status; docker stats --no-stream --format '{{json .}}' \"$engine\" \"$server\"; nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw --format=csv,noheader"
    ],
    "ready_timeout_seconds": 4200,
    "stop_timeout_seconds": 900
  },
  "api": {
    "scheme": "http",
    "rank_bases": {}
  },
  "acceptance": {
    "expected_generation_path": ".sparkring/acceptance/exl3-expected-generation.json",
    "served_model_name": "glm-5.2-exl3-tr3-3.25bpw",
    "prompt": "Explain in one concise paragraph why a four-node ring has four physical edges.",
    "seed": 20260807,
    "max_tokens": 128
  },
  "performance": {
    "cells": [
      {"concurrency": 1, "max_tokens": 128, "minimum_tokens": 120, "repetitions": 3, "ignore_eos": true},
      {"concurrency": 2, "max_tokens": 128, "minimum_tokens": 120, "repetitions": 3, "ignore_eos": true},
      {"concurrency": 4, "max_tokens": 128, "minimum_tokens": 120, "repetitions": 3, "ignore_eos": true},
      {"concurrency": 8, "max_tokens": 128, "minimum_tokens": 120, "repetitions": 3, "ignore_eos": true}
    ],
    "band": {
      "C1": {"aggregate_tokens_per_second": {"min": 13.5}},
      "C2": {"aggregate_tokens_per_second": {"min": 20.0}},
      "C4": {"aggregate_tokens_per_second": {"min": 32.0}},
      "C8": {"aggregate_tokens_per_second": {"min": 42.0}}
    }
  },
  "extensions": {
    "pre_shutdown": [
      {
        "id": "broader-correctness",
        "title": "Multi-case cache-bound fixed-seed token-ID correctness",
        "command": [
          "python",
          "scripts/exl3_correctness_gate.py",
          "--config",
          ".sparkring/acceptance/exl3-correctness-cache.json",
          "--site",
          ".sparkring/bootstrap-exl3/site.yaml",
          "--base-url",
          "http://<RANK0_MANAGEMENT_ADDRESS>:8000",
          "--model",
          "glm-5.2-exl3-tr3-3.25bpw",
          "--attribution-arm",
          "d-mtp2-apc1-lmcache1",
          "--activation-receipt",
          ".sparkring/acceptance/exl3-live-arm-receipt.json",
          "--profile",
          ".sparkring/bootstrap-exl3/launch.json",
          "--cache-metric-probe",
          "cache-long-prefix-json=.sparkring/acceptance/cache-long-prefix-json-metric.json",
          "--cache-metric-probe",
          "cache-long-prefix-recall=.sparkring/acceptance/cache-long-prefix-recall-metric.json",
          "--repetitions",
          "3",
          "--execute",
          "run"
        ],
        "timeout_seconds": 3600,
        "mutates_remote": false,
        "require_json_status": true
      },
      {
        "id": "lmcache-boundaries",
        "title": "LMCache cold/warm and restart-boundary attribution",
        "command": [
          "python",
          "scripts/exl3_cache_acceptance.py",
          "--site",
          ".sparkring/bootstrap-exl3/site.yaml",
          "--profile",
          ".sparkring/bootstrap-exl3/launch.json",
          "--base-url",
          "http://<RANK0_MANAGEMENT_ADDRESS>:8000",
          "--model",
          "glm-5.2-exl3-tr3-3.25bpw",
          "--probe-id",
          "<UNIQUE_ACCEPTANCE_RUN_ID>",
          "--execute",
          "--confirmation",
          "RUN-EXL3-CACHE-BOUNDARY-ALL-FOUR",
          "run"
        ],
        "timeout_seconds": 14400,
        "mutates_remote": true,
        "require_json_status": true
      }
    ]
  },
  "matrix": {
    "serving": {
      "tensor_parallel_size": 4,
      "decode_context_parallel_size": 4,
      "mtp_mode": "static",
      "mtp_tokens": 2,
      "max_model_len": 524288,
      "kv_cache_bytes_per_rank": 4500000000,
      "max_num_seqs": 8
    },
    "required_concurrencies": [1, 2, 4, 8]
  },
  "preflight": {
    "result_path": null
  }
}
