# Research-only SIRCL overlay for the four-Spark DeepSeek profile.
# Pass this after the canonical rank environment with a second docker
# --env-file. Replace every angle-bracket placeholder independently per rank.
# Peer 0 must be reachable through device 0; peer 1 through device 1.

PYTHONPATH=/opt/spark-vllm
SPARK_TP4_LIBRARY=/opt/sparkring/spark_transport/libspark_transport_capi.so

VLLM_SPARK_TP4_MODE=custom
VLLM_SPARK_TP4_GRAPH_WIDTH4096_RESEARCH=1
VLLM_SPARK_SHARED_CAPTURE_STREAM=1
VLLM_SPARK_TP4_GRAPH_Q1=0
VLLM_SPARK_TP4_GRAPH_DUAL_PORT_Q40=0

SPARK_TP4_PEER0=<DIRECT_PEER_ADDRESS_ON_DEVICE0>
SPARK_TP4_PEER1=<DIRECT_PEER_ADDRESS_ON_DEVICE1>
SPARK_TP4_DEVICE0=rocep1s0f0
SPARK_TP4_DEVICE1=rocep1s0f1
SPARK_TP4_GID0=3
SPARK_TP4_GID1=3

SPARK_TP4_GRAPH_CONTROL_PORT0=9970
SPARK_TP4_GRAPH_CONTROL_PORT1=9971
SPARK_TP4_GRAPH_SUBMIT_CPU=10
SPARK_TP4_GRAPH_PROGRESS_CPU=11
SPARK_TP4_MAX_INFLIGHT=64
SPARK_TP4_CONTROL_CONNECT_TIMEOUT_SECONDS=10
SPARK_TP4_FLIGHT_RECORDER=0
SPARK_TP4_GRAPH_STATUS_PATH=/cache/jit/deepseek-sircl-rank<RANK>.json
