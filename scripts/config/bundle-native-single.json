{
  "schema": "sparkring-runtime-bundle/v1",
  "bundle_id": "native-single",
  "confirmation": "START-native-single",
  "services": [
    {
      "service_id": "engine",
      "role": "serving",
      "source": {
        "kind": "runtime-profile",
        "path": "contributor-example.json"
      },
      "readiness": {
        "kind": "http-get",
        "port": "site-api",
        "path": "/health",
        "timeout_seconds": 30,
        "interval_seconds": 5
      }
    }
  ]
}
