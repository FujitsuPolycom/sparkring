# One file per rank. Values are literal KEY=VALUE, without shell expansion.
NODE_RANK=<0_TO_3>
MASTER_ADDR=<RANK0_IP>
HOST_IP=<THIS_RANK_IP>
MODEL_HOST_PATH=<ABSOLUTE_CHECKPOINT_DIRECTORY>
ENGRAM_HOST_PATH=<ABSOLUTE_MIA_PACKED_DIRECTORY>
STATE_HOST_PATH=<ABSOLUTE_PRIVATE_STATE_DIRECTORY>
CACHE_HOST_PATH=<ABSOLUTE_CACHE_DIRECTORY>
API_KEY_FILE=<ABSOLUTE_FILE_ONE_KEY_PER_LINE>
NCCL_SO_HOST_PATH=<ABSOLUTE_PATCHED_NCCL_LIBRARY>
NCCL_SO_SHA256=<SHA256_OF_RESOLVED_LIBRARY>
IMAGE=local/sparkring-deepseek-v41:sglang
IMAGE_ID=<sha256:YOUR_BUILT_IMAGE_ID>
API_PORT=8000
MASTER_PORT=20000
CONTEXT_LENGTH=262144
CHUNKED_PREFILL_SIZE=4096
MAX_RUNNING_REQUESTS=8
MAX_TOTAL_TOKENS=1500000
MEM_FRACTION_STATIC=0.90
NCCL_SOCKET_IFNAME=<MANAGEMENT_INTERFACE>
GLOO_SOCKET_IFNAME=<MANAGEMENT_INTERFACE>
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_IB_GID_INDEX=<GID_INDEX>
# Optional profiled tables inside STATE_HOST_PATH. Absent tables use verify-all.
#DSPARK_SPS_TABLE=/state/dspark_sps.json
#DSPARK_STS_TABLE=/state/dspark_sts.json
