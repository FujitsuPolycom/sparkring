# One file per rank. Values are literal KEY=VALUE, without shell expansion.
NODE_RANK=<0_TO_3>
MASTER_ADDR=<RANK0_IP>
HOST_IP=<THIS_RANK_IP>
MODEL_HOST_PATH=<ABSOLUTE_CHECKPOINT_DIRECTORY>
ENGRAM_HOST_PATH=<ABSOLUTE_MIA_PACKED_DIRECTORY>
STATE_HOST_PATH=<ABSOLUTE_PRIVATE_STATE_DIRECTORY>
CACHE_HOST_PATH=<ABSOLUTE_CACHE_DIRECTORY>
API_KEY_FILE=<ABSOLUTE_FILE_ONE_KEY_PER_LINE>
NCCL_SO_HOST_PATH=<ABSOLUTE_PATCHED_NCCL_LIBRARY>
NCCL_SO_SHA256=<SHA256_OF_RESOLVED_LIBRARY>
IMAGE=local/sparkring-deepseek-v41:sglang
IMAGE_ID=<sha256:YOUR_BUILT_IMAGE_ID>
API_PORT=8000
MASTER_PORT=20000
CONTEXT_LENGTH=262144
CHUNKED_PREFILL_SIZE=4096
MAX_RUNNING_REQUESTS=8
# Admit a prefill when one slot is available; values above 1 batch admissions.
MIN_FREE_SLOTS_DELAY=1
MAX_TOTAL_TOKENS=1500000
MEM_FRACTION_STATIC=0.90
NCCL_SOCKET_IFNAME=<MANAGEMENT_INTERFACE>
GLOO_SOCKET_IFNAME=<MANAGEMENT_INTERFACE>
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_IB_GID_INDEX=<GID_INDEX>
# Optional profiled tables inside STATE_HOST_PATH. Absent tables use verify-all.
#DSPARK_SPS_TABLE=/state/dspark_sps.json
#DSPARK_STS_TABLE=/state/dspark_sts.json
# Optional serving controls; admission defaults to 1 above, others use image defaults.
# MoE runner for the routed experts: flashinfer_mxfp4 for the stock checkpoint,
# flashinfer_cutlass for nvidia/DeepSeek-V4.1-Flash-NVFP4 (required: the MXFP4 runner
# does not slice that checkpoint's per-expert input scales under EP).
#MOE_RUNNER_BACKEND=flashinfer_mxfp4
# SGLang holds new prefills until N slots are free for DFlash-family speculation once
# MAX_RUNNING_REQUESTS >= 8 (2 slots at 8). 1 disables the delayer; 0 keeps SGLang's default.
#MIN_FREE_SLOTS_DELAY=0
# Completion cap: fills an omitted max_tokens and clamps larger values. 0 = engine fill.
#DSV41_MAX_NEW_TOKENS=32768
# Decode-side repetition stop (finish_reason=stop, matched=repetition). 0 disables.
#DSV41_LOOP_ABORT=1
# Mount the prepared SGLang overlay that routes the MXFP4 DSpark draft experts of a hybrid
# NVFP4 checkpoint to the CUTLASS MoE method on SM120. Requires --prepare with this set.
#NVFP4_DRAFT_OVERLAY=0
