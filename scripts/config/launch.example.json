{
  "schema": "sparkring-public-launch/v1",
  "engine": "docker",
  "container_name": "glm52-sparkring-nf3",
  "model_host_path": "/srv/models/GLM-5.2-MXFP8-NVFP4-NF3-Hybrid",
  "mtp_draft_host_path": "/srv/models/GLM-5.2-NF3-MTP-Draft",
  "shm_size": "16g",
  "startup_timeout_seconds": 3600,
  "environment": {
    "CUTE_DSL_ARCH": "sm_121a",
    "FASTSAFETENSORS_UNIFIED_MEM": "0",
    "B12X_DENSE_SPLITK_TURBO": "1",
    "B12X_MOE_FORCE_A16": "1",
    "B12X_W4A16_TC_DECODE": "1",
    "HYBRID_B12X_MAX_TOKENS": "4096",
    "HYBRID_KEPT": "b12x_nf3",
    "HYBRID_MXFP8_NATIVE": "1",
    "HYBRID_MXFP8_TIER_JSON": "/opt/venv/lib/python3.12/site-packages/mxfp8_tier.json",
    "HYBRID_NF3": "b12x_nf3",
    "HYBRID_TIER": "both",
    "MAX_JOBS": "1",
    "NCCL_ALGO": "Ring",
    "NCCL_CROSS_NIC": "1",
    "NCCL_CUMEM_ENABLE": "0",
    "NCCL_IB_DISABLE": "0",
    "NCCL_IB_GID_INDEX": "3",
    "NCCL_IB_MERGE_NICS": "0",
    "NCCL_IB_SUBNET_AWARE_ROUTING": "1",
    "NCCL_NET": "IB",
    "NCCL_NET_PLUGIN": "none",
    "NCCL_SKIP_TREE_CONNECT": "1",
    "SPARK_ADAPTIVE_MTP_CONTROL": "1",
    "SPARK_CONTEXT_CACHE_ENABLE": "0",
    "SPARK_GLM52_MTP_INDEX_REUSE": "1",
    "SPARK_TP4_ALLGATHER_BASE_PORT": "10200",
    "SPARK_TP4_CONTROL_CONNECT_TIMEOUT_SECONDS": "10",
    "SPARK_TP4_LIBRARY": "/opt/sparkring/spark_transport/libspark_transport_capi.so",
    "SPARK_TP4_VOCAB_EAGER_STAGING_TIMEOUT_SECONDS": "1200",
    "TORCHINDUCTOR_COMPILE_THREADS": "1",
    "TORCH_CUDA_ARCH_LIST": "12.1a",
    "VLLM_ADAPTIVE_SPEC_DEPTHS": "2,4",
    "VLLM_ALLOW_LONG_MAX_MODEL_LEN": "1",
    "VLLM_DCP_GLOBAL_TOPK": "1",
    "VLLM_DCP_SHARD_DRAFT": "1",
    "VLLM_DSV4_INDEXER_SP": "1",
    "VLLM_FASTSAFETENSORS_QUEUE_SIZE": "-1",
    "VLLM_NCCL_SO_PATH": "/opt/sparkring/nccl/libnccl.so.2",
    "VLLM_NO_USAGE_STATS": "1",
    "VLLM_PREFIX_CACHE_RETENTION_INTERVAL": null,
    "VLLM_SPARK_MTP_ADAPTIVE_WINDOW": "32",
    "VLLM_SPARK_MTP_MODE_ID": "adaptive-mtp2-4-window32",
    "VLLM_SPARK_MTP_TOKENS": "4",
    "VLLM_SPARK_MAX_QUERY_ROWS": "40",
    "VLLM_SPARK_NF3_PROFILE": "reference-four-spark-adaptive-2-4-c8",
    "VLLM_SPARK_NF3_SINGLE_COMPILE_RANGE": "0",
    "VLLM_SPARK_NF3_STARTUP_PROFILE_MAX_TOKENS": "2",
    "VLLM_SPARK_NF3_WORKSPACE_RESERVE_BYTES": "805306368",
    "VLLM_SPARK_TRUE_ADAPTIVE_DRAFT": "1",
    "VLLM_SPARK_TP4_ALLGATHER_MODE": "custom",
    "VLLM_SPARK_TP4_MODE": "custom",
    "VLLM_SPARK_TP4_VOCAB_MODE": "custom",
    "VLLM_USE_AOT_COMPILE": "0",
    "VLLM_USE_B12X_FP8_GEMM": "1",
    "VLLM_USE_B12X_MOE": "1",
    "VLLM_USE_B12X_SPARSE_INDEXER": "1",
    "VLLM_USE_V2_MODEL_RUNNER": "1"
  },
  "extra_vllm_args": [
    "--dcp-comm-backend",
    "ag_rs",
    "--attention-backend",
    "B12X_MLA_SPARSE",
    "--hf-overrides",
    "{\"index_topk_pattern\":\"FFFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSS\"}",
    "--kv-cache-dtype",
    "fp8",
    "--enable-prefix-caching",
    "--gpu-memory-utilization",
    "0.89",
    "--no-enable-flashinfer-autotune",
    "--enforce-eager",
    "--enable-auto-tool-choice",
    "--load-format",
    "fastsafetensors",
    "--served-model-name",
    "glm-5.2-nf3-hybrid",
    "--reasoning-parser",
    "glm45",
    "--tool-call-parser",
    "glm47",
    "--host",
    "0.0.0.0",
    "--speculative-config",
    "{\"model\":\"{draft_path}\",\"method\":\"mtp\",\"num_speculative_tokens\":4,\"draft_attention_backend\":\"B12X_MLA_SPARSE\",\"adaptive_speculative_tokens_window\":32}",
    "--max-num-batched-tokens",
    "4096"
  ]
}
