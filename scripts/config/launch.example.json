{
  "schema": "sparkring-public-launch/v1",
  "engine": "docker",
  "container_name": "glm52-sparkring-public",
  "model_host_path": "/srv/models/GLM-5.2-MXFP4-Experts-GPTQ",
  "shm_size": "16g",
  "startup_timeout_seconds": 3600,
  "environment": {
    "CUTE_DSL_ARCH": "sm_121a",
    "NCCL_ALGO": "Ring",
    "NCCL_CROSS_NIC": "1",
    "NCCL_CUMEM_ENABLE": "0",
    "NCCL_IB_DISABLE": "0",
    "NCCL_IB_GID_INDEX": "3",
    "NCCL_IB_MERGE_NICS": "0",
    "NCCL_IB_SUBNET_AWARE_ROUTING": "1",
    "NCCL_NET": "IB",
    "NCCL_NET_PLUGIN": "none",
    "NCCL_SKIP_TREE_CONNECT": "1",
    "SPARK_TP4_LIBRARY": "/opt/sparkring/spark_transport/libspark_transport_capi.so",
    "TORCH_CUDA_ARCH_LIST": "12.1a",
    "VLLM_ADAPTIVE_SPEC_DEPTHS": "2,4",
    "VLLM_ALLOW_LONG_MAX_MODEL_LEN": "1",
    "VLLM_DCP_GLOBAL_TOPK": "1",
    "VLLM_DCP_SHARD_DRAFT": "1",
    "VLLM_DSV4_INDEXER_SP": "1",
    "VLLM_NCCL_SO_PATH": "/opt/sparkring/nccl/libnccl.so.2",
    "VLLM_SPARK_MTP_ADAPTIVE_WINDOW": "32",
    "VLLM_SPARK_MTP_MODE_ID": "adaptive-mtp2-4-window32",
    "VLLM_SPARK_MTP_TOKENS": "4",
    "VLLM_SPARK_TP4_ALLGATHER_MODE": "custom",
    "VLLM_SPARK_TP4_MODE": "custom",
    "VLLM_SPARK_TP4_VOCAB_MODE": "custom",
    "VLLM_USE_B12X_MOE": "1",
    "VLLM_USE_B12X_SPARSE_INDEXER": "1"
  },
  "extra_vllm_args": [
    "--dcp-comm-backend",
    "ag_rs",
    "--attention-backend",
    "B12X_MLA_SPARSE",
    "--kv-cache-dtype",
    "nvfp4_ds_mla",
    "--enable-prefix-caching",
    "--gpu-memory-utilization",
    "0.88",
    "--enforce-eager",
    "--load-format",
    "safetensors",
    "--served-model-name",
    "glm-5.2",
    "--host",
    "0.0.0.0",
    "--speculative-config",
    "{\"model\":\"{model_path}/mtp-draft\",\"method\":\"mtp\",\"num_speculative_tokens\":4,\"draft_attention_backend\":\"B12X_MLA_SPARSE\",\"adaptive_speculative_tokens_window\":32}",
    "--max-num-batched-tokens",
    "4096"
  ]
}
