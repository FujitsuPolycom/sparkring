{
  "schema": "sparkring-runtime-bundle/v1",
  "bundle_id": "example-template",
  "confirmation": "START-YOUR-BUNDLE",
  "services": [
    {
      "service_id": "example-sidecar",
      "role": "cache",
      "source": {
        "kind": "structured-container",
        "path": "your-sidecar.json"
      },
      "readiness": {
        "kind": "http-get",
        "port": 6556,
        "path": "/v1/health",
        "timeout_seconds": 30,
        "interval_seconds": 5
      }
    },
    {
      "service_id": "example-engine",
      "role": "serving",
      "depends_on": ["example-sidecar"],
      "source": {
        "kind": "runtime-profile",
        "path": "your-profile.json"
      },
      "readiness": {
        "kind": "http-get",
        "port": "site-api",
        "path": "/health",
        "timeout_seconds": 30,
        "interval_seconds": 5
      }
    }
  ]
}
