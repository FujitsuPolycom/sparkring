{
  "schema": "sparkring-runtime-bundle/v1",
  "bundle_id": "exl3-lmcache-bridge",
  "services": [
    {
      "service_id": "lmcache-servers",
      "role": "cache",
      "source": {
        "kind": "canonical-exl3-lmcache-cs512",
        "path": "exl3-profile-fixture.json"
      }
    },
    {
      "service_id": "exl3-engine",
      "role": "serving",
