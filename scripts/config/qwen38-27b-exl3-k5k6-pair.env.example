# Per-rank environment for Qwen3.8-27B EXL3 K5/K6 on a directly cabled
# two-Spark pair. Copy this file once per rank and replace the four
# placeholders. The launch procedure is in
# docs/QWEN38_27B_EXL3_K5K6_PAIR_QUICKSTART.md.
#
#   <FABRIC_IFNAME>   the interface carrying the direct rank-to-rank cable
#   <RANK_FABRIC_IP>  this rank's IPv4 address on that interface
#   <NCCL_IB_HCA>     the one RoCE device attached to the direct cable
#   <GID_INDEX>       the RoCEv2 GID index encoding RANK_FABRIC_IP

LD_PRELOAD=/ws/nccl-patched/libnccl.so.2
VLLM_NCCL_SO_PATH=/ws/nccl-patched/libnccl.so.2

NCCL_SOCKET_IFNAME=<FABRIC_IFNAME>
GLOO_SOCKET_IFNAME=<FABRIC_IFNAME>
VLLM_HOST_IP=<RANK_FABRIC_IP>

NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_IB_DISABLE=0
NCCL_IB_HCA=<NCCL_IB_HCA>
NCCL_IB_GID_INDEX=<GID_INDEX>
NCCL_IB_SUBNET_AWARE_ROUTING=0
NCCL_IB_MERGE_NICS=0
NCCL_PROTO=LL,LL128,Simple
NCCL_P2P_LEVEL=SYS
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN

VLLM_EXL3_GRAPH_DECODE=1
VLLM_EXL3_PREFILL_FP8=1
VLLM_EXL3_PREFILL_RECONSTRUCT_M=256
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1

CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_DEVICE_MAX_CONNECTIONS=32
HF_HOME=/root/.cache/huggingface
HF_HUB_OFFLINE=1
XDG_CACHE_HOME=/ws/cache/jit
TRITON_CACHE_DIR=/ws/cache/jit/triton
VLLM_CACHE_ROOT=/ws/cache/jit/vllm
VLLM_NO_USAGE_STATS=1
