# Per-rank environment for Qwen3.8-27B EXL3 K5/K6 on the four-Spark
# direct-cable cycle. Copy this file once per rank and replace the four
# placeholders. The launch procedure is in
# docs/QWEN38_27B_EXL3_K5K6_QUICKSTART.md.
#
#   <RENDEZVOUS_IFNAME>  the rank's management interface used by vLLM, Gloo,
#                        and NCCL bootstrap TCP
#   <RANK_RENDEZVOUS_IP> this rank's address on the management interface
#   <NCCL_IB_HCA>        the two cycle-facing RoCE devices in local ring order
#   <NCCL_IB_GID_INDEX>  the RoCEv2 index for the fabric IPv4 address on both
#                        devices; `show_gids` lists it
#
# The prepared runtime work directory is mounted at /ws. Its patched NCCL
# library must have SHA-256
# e69a8c240f45d10166bcd901d99db78bb63147adda66e586d8dd505c6d608b54.

LD_PRELOAD=/ws/nccl-patched/libnccl.so.2
VLLM_NCCL_SO_PATH=/ws/nccl-patched/libnccl.so.2

NCCL_SOCKET_IFNAME=<RENDEZVOUS_IFNAME>
GLOO_SOCKET_IFNAME=<RENDEZVOUS_IFNAME>
VLLM_HOST_IP=<RANK_RENDEZVOUS_IP>

NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_IB_DISABLE=0
NCCL_IB_HCA=<NCCL_IB_HCA>
NCCL_IB_GID_INDEX=<NCCL_IB_GID_INDEX>
NCCL_IB_SUBNET_PREFIX_LEN=24
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_IB_MERGE_NICS=0
NCCL_ALGO=Ring
NCCL_PROTO=LL,LL128,Simple
NCCL_P2P_LEVEL=SYS
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_SKIP_TREE_CONNECT=1
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN

VLLM_EXL3_GRAPH_DECODE=1
VLLM_EXL3_PREFILL_FP8=1
VLLM_EXL3_PREFILL_RECONSTRUCT_M=256

CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_DEVICE_MAX_CONNECTIONS=32
HF_HOME=/root/.cache/huggingface
HF_HUB_OFFLINE=1
XDG_CACHE_HOME=/ws/cache/jit
TRITON_CACHE_DIR=/ws/cache/jit/triton
VLLM_CACHE_ROOT=/ws/cache/jit/vllm
VLLM_NO_USAGE_STATS=1
