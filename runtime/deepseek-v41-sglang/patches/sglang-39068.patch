+++ b/python/sglang/kernels/ops/attention/dsv4/candidate_blocks.py
@@ -62,6 +62,29 @@ def _candidate_mask_kernel(
     tl.store(OUT + row * WIDTH + cols, values, cols < WIDTH)
 
 
+@triton.jit
