#!/usr/bin/env bash
# Copy this file to a rank-local path and replace the five required site
# values. Byte counts are per rank. Every serving setting below may be
# overridden without rebuilding the image.

# Required site values. HOST_IP differs per rank; MASTER_ADDR is rank 0.
HOST_IP='REPLACE_WITH_THIS_RANK_ADDRESS'
MASTER_ADDR='REPLACE_WITH_RANK0_ADDRESS'
TARGET_MODEL_HOST_PATH='/REPLACE/TARGET_MODEL_HOST_PATH'
DFLASH_MODEL_HOST_PATH='/REPLACE/DFLASH_MODEL_HOST_PATH'
CACHE_HOST_ROOT='/REPLACE/DEDICATED_RANK_LOCAL_CACHE_ROOT'

# Immutable public Linux/ARM64 image and its local Docker image ID.
IMAGE_REF='ghcr.io/fujitsupolycom/sparkring-glm53-sparkcache@sha256:e34aa58fda32c2cc63bc70de680b50c5f2bb69c1e0ad3c5bce0782c6501f7d34'
IMAGE_ID='sha256:058b17b49ee3b5ffd805fa4a17e4d9efcb885f92349b98a8c8623bd7f0f96dd4'
CONTAINER_PREFIX='glm53-flash-gb10'
SERVED_MODEL_NAME='glm-5.3-flash'
PORT=8015
MASTER_PORT=29775
SHM_SIZE='32g'

# Distributed topology.
TENSOR_PARALLEL_SIZE=4
PIPELINE_PARALLEL_SIZE=1
DECODE_CONTEXT_PARALLEL_SIZE=4
# GLM-5.3 uses four-token KV interleaving for DCP2 and DCP4. `auto`
# selects 1 for DCP1 and 4 for DCP2/DCP4.
CP_KV_CACHE_INTERLEAVE_SIZE='auto'
# `auto` disables full-CKV prefill gather for DCP1 and enables it for
# DCP2/DCP4. Set 0 or 1 only when isolating the gather path.
B12X_MLA_CKV_GATHER='auto'
B12X_MLA_CKV_GATHER_MAX_TOKENS=524288
NODE_COUNT=4

# Request scheduling and device-memory allocation.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
PREFILL_SCHEDULE_INTERVAL=2
# Per-request multimodal limits. Set either value to zero to disable that
# modality without rebuilding the image.
MULTIMODAL_INPUTS=1
MAX_IMAGES_PER_PROMPT=4
MAX_VIDEOS_PER_PROMPT=1
# `auto` selects 26 GiB for DCP1, 30 GiB for DCP2, or 24 GiB for DCP4. An
# explicit positive byte count overrides this policy.
KV_CACHE_MEMORY_BYTES='auto'
GPU_MEMORY_UTILIZATION=0.80
KV_CACHE_DTYPE='fp8'

# BF16 external DFlash speculation.
SPECULATION_METHOD='dflash'
NUM_SPECULATIVE_TOKENS=7
DRAFT_TENSOR_PARALLEL_SIZE=4
DRAFT_KV_CACHE_DTYPE='auto'
DRAFT_SAMPLE_METHOD='probabilistic'
REJECTION_SAMPLE_METHOD='standard'

# Model kernels and compilation.
ATTENTION_BACKEND='B12X'
MOE_BACKEND='b12x'
LINEAR_BACKEND='b12x'
KDA_PREFILL_BACKEND='flashkda'
LOAD_FORMAT='fastsafetensors'
CUDAGRAPH_MODE='FULL_AND_PIECEWISE'
MAX_CUDAGRAPH_CAPTURE_SIZE=128

# The manager-page geometry is part of the persistent-cache identity.
SPARKCACHE_ENABLED=1
# `read-write` restores and publishes. `restore-only` reuses existing entries
# without capturing one-off prompts. `store-only` and `disabled` are diagnostic.
SPARKCACHE_ACCESS_MODE='read-write'
# Retain a verified shared GPU prefix long enough to serve extended queues.
# SparkCache may release it earlier when vLLM needs the KV blocks.
SPARKCACHE_SHARED_PREFIX_LEASE_TTL_SECONDS=300
# The published DCP4 profile uses `tail-cow-v2`. The complete-snapshot rollback
# uses `snapshot-v1` and a separate `glm53-flash-dcp4-snapshot-v1` directory.
# Publication schema is part of cache identity; the directory name only
# selects rank-local files.
SPARKCACHE_CACHE_NAMESPACE='glm53-flash-dcp4-page-tail-cow-v2'
JIT_CACHE_NAMESPACE='glm53-flash-sm121-vllm-22ffe140-b12x-6255090a'
JIT_MONITOR_VERBOSE=0
DFLASH_WARMUP=1
DFLASH_WARMUP_CONCURRENCIES='1,2,4,8,16'
DFLASH_WARMUP_SHAPE_WORDS='8,24,56,120,248'
DFLASH_WARMUP_MAX_TOKENS=16
DFLASH_WARMUP_TIMEOUT_SECONDS=600

# Rank zero exposes scheduler liveness separately from API readiness.
SPARKRING_LIVENESS_ENABLED=1
SPARKRING_LIVENESS_PORT=8016
SPARKRING_LIVENESS_BLOCKED_SECONDS=60
# Keep this above the 300-second shared-prefix lease so normal retention warns
# only after the lease has had time to release its GPU pages.
SPARKRING_IDLE_KV_WARN_SECONDS=330
SPARKRING_LIVENESS_STALE_SECONDS=15
SPARKRING_LIVENESS_SAMPLE_SECONDS=2

# Research-only SIRCL tensor-parallel all-reduce. The bundle directory must
# contain the Python adapter modules and libspark_transport_capi.so built from
# one recorded SparkRing source revision. Each peer address must be reachable
# through the device in the same numbered slot.
SIRCL_ENABLED=0
SIRCL_BUNDLE_HOST_ROOT=''
SPARK_TP4_PEER0=''
SPARK_TP4_PEER1=''
SPARK_TP4_DEVICE0='rocep1s0f0'
SPARK_TP4_DEVICE1='rocep1s0f1'
SPARK_TP4_GID0=3
SPARK_TP4_GID1=3
SPARK_TP4_GRAPH_CONTROL_PORT0=9970
SPARK_TP4_GRAPH_CONTROL_PORT1=9971
SPARK_TP4_GRAPH_SUBMIT_CPU=10
SPARK_TP4_GRAPH_PROGRESS_CPU=11
SPARK_TP4_MAX_INFLIGHT=64
SPARK_TP4_CONTROL_CONNECT_TIMEOUT_SECONDS=10
# Research-only: derive replay sequence on-device and use the existing round-0
# producer doorbell as the host notification, bypassing the mapped command ring.
SPARK_TP4_GRAPH_DIRECT_DOORBELL=0
# Research-only eager prefill transport for contiguous TP4 BF16 [Q, 4096]
# tensors. `sync` admits Q1024/Q2048/Q4096/Q8192 and synchronizes the caller
# stream around the native operation. `fused` uses one caller-stream launch,
# admits every Q from 128 through 8192, and requires `dual` rail mode.
VLLM_SPARK_TP4_BIDIRECTIONAL_PREFILL=0
VLLM_SPARK_TP4_BIDIRECTIONAL_PREFILL_RAIL_MODE='single'
VLLM_SPARK_TP4_BIDIRECTIONAL_PREFILL_EXPOSURE='sync'
SPARK_TP4_BIDIRECTIONAL_PREFILL_CONTROL_PORT0=19000
SPARK_TP4_BIDIRECTIONAL_PREFILL_CONTROL_PORT1=19001
# A dual-rail deployment configures both RDMA device functions on each of the
# rank's two existing cabled ring edges. All four peer addresses and all four
# device names must be distinct on each rank; no additional cable is required.
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_PEER0=''
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_PEER1=''
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_DEVICE0=''
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_DEVICE1=''
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_GID0=3
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_GID1=3
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_CONTROL_PORT0=19100
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_CONTROL_PORT1=19101
SPARK_TP4_BIDIRECTIONAL_PREFILL_TIMEOUT_SECONDS=120
# Diagnostic only. The timer remains dormant until the operator creates
# ${CACHE_HOST_ROOT}/sircl-replay-timing.arm and stops after this many FULL
# graph replays. CUDA completion polling stays on the low-rate status thread.
SPARK_CUDAGRAPH_REPLAY_TIMING=0
SPARK_CUDAGRAPH_REPLAY_TIMING_SAMPLES=512
# Required only when timing stock NCCL with SIRCL_ENABLED=0. A SIRCL run
# reuses SIRCL_BUNDLE_HOST_ROOT for the same diagnostic module.
SPARK_CUDAGRAPH_REPLAY_TIMING_BUNDLE_HOST_ROOT=''

SPARKCACHE_PUBLICATION_SCHEMA='tail-cow-v2'
SPARKCACHE_CLEAR_ONCE='auto'
SPARKCACHE_MAX_BYTES=42949672960
SPARKCACHE_LOW_WATERMARK_BYTES=34359738368
SPARKCACHE_TTL_SECONDS=0
SPARKCACHE_MIN_SPAN_TOKENS=4096
SPARKCACHE_MAX_SPAN_TOKENS=1048576
SPARKCACHE_LOAD_THREADS=8
SPARKCACHE_MAX_PENDING_RESTORES=8
SPARKCACHE_CUDA_RESTORE_IO_WORKERS=8
SPARKCACHE_CUDA_ARENA_BYTES=268435456
# Two bounded capture slots let the background publisher consume one capture
# while a later request uses the other. Set to 0 for synchronous publication.
SPARKCACHE_ASYNC_PAGE_CAPTURE=1
SPARKCACHE_ASYNC_CAPTURE_SLOT_BYTES='auto'
SPARKCACHE_ASYNC_CAPTURE_SLOT_COUNT=2

# Rank-to-rank transport.
SOCKET_IFNAME='enP7s7'
NCCL_IB_HCA='rocep1s0f0,rocep1s0f1'
NCCL_IB_GID_INDEX=3
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4

# Host CPU and loader concurrency.
OMP_NUM_THREADS=16
TORCHINDUCTOR_COMPILE_THREADS=1
FASTSAFETENSORS_QUEUE_SIZE=1

# Include usage.prompt_tokens_details.cached_tokens whenever a response carries
# usage. Streaming clients must request usage with stream_options.include_usage.
# Set to 0 to omit prompt_tokens_details from API responses.
ENABLE_PROMPT_TOKENS_DETAILS=1

# Optional OpenAI-compatible bearer authentication. Unset (the default) serves
# keyless, exactly as before. When set, the path must be a readable regular
# file with mode 0600 holding one key per line; every non-empty line is passed
# to vLLM in a single --api-key option.
#API_KEYS_FILE='/REPLACE/RANK_LOCAL_API_KEYS_FILE'
