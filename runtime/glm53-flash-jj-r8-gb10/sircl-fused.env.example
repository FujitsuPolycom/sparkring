# Implemented fused SIRCL performance-testing overlay for GLM-5.3 TP4/DCP4.
# Append this file to a rank-local copy of runtime.env.example, then replace
# every value marked REPLACE. The base runtime settings remain unchanged.

# The bundle contains the public Python overlay, its generated manifest, and
# libspark_transport_capi.so built from the source tree identified by
# sircl-public-build-receipt.json.
SIRCL_ENABLED=1
SIRCL_BUNDLE_HOST_ROOT='/REPLACE/ABSOLUTE/SIRCL_BUNDLE_PATH'

# Primary clockwise and counter-clockwise ring links.
SPARK_TP4_PEER0='REPLACE_WITH_PRIMARY_PEER_0_ADDRESS'
SPARK_TP4_PEER1='REPLACE_WITH_PRIMARY_PEER_1_ADDRESS'
SPARK_TP4_DEVICE0='rocep1s0f0'
SPARK_TP4_DEVICE1='rocep1s0f1'
SPARK_TP4_GID0=3
SPARK_TP4_GID1=3

# Captured width-4096 collectives use graph-native SIRCL. The launcher sets
# custom mode, shared capture-stream integration, and the width-4096 graph
# adapter. Direct doorbells remove the mapped host-command-ring submission.
SPARK_TP4_GRAPH_CONTROL_PORT0=9970
SPARK_TP4_GRAPH_CONTROL_PORT1=9971
SPARK_TP4_GRAPH_SUBMIT_CPU=10
SPARK_TP4_GRAPH_PROGRESS_CPU=11
SPARK_TP4_MAX_INFLIGHT=64
SPARK_TP4_CONTROL_CONNECT_TIMEOUT_SECONDS=10
SPARK_TP4_GRAPH_DIRECT_DOORBELL=1

# Eager contiguous TP4 BF16 [Q, 4096] tensors use the fused SIRCL session for
# Q128 through Q8192. The secondary values select the second RDMA device
# function on each existing cabled ring edge, not another cable or a diagonal.
VLLM_SPARK_TP4_BIDIRECTIONAL_PREFILL=1
VLLM_SPARK_TP4_BIDIRECTIONAL_PREFILL_RAIL_MODE='dual'
VLLM_SPARK_TP4_BIDIRECTIONAL_PREFILL_EXPOSURE='fused'
SPARK_TP4_BIDIRECTIONAL_PREFILL_CONTROL_PORT0=19000
SPARK_TP4_BIDIRECTIONAL_PREFILL_CONTROL_PORT1=19001
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_PEER0='REPLACE_WITH_SECONDARY_PEER_0_ADDRESS'
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_PEER1='REPLACE_WITH_SECONDARY_PEER_1_ADDRESS'
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_DEVICE0='REPLACE_WITH_SECONDARY_DEVICE_0'
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_DEVICE1='REPLACE_WITH_SECONDARY_DEVICE_1'
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_GID0=3
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_GID1=3
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_CONTROL_PORT0=19100
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_CONTROL_PORT1=19101
SPARK_TP4_BIDIRECTIONAL_PREFILL_TIMEOUT_SECONDS=120
