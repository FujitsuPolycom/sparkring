    ],
    "reviewed_overlay_policy": [
      "mtp_has_independent_draft_state = speculative_config is not None and speculative_config.method == 'mtp' and (speculative_config.draft_model_config is not None) and bool({'Glm5NextMTPModel', 'Qwen3_8FlashNextMTP'} & set(speculative_config.draft_model_config.hf_config.architectures or ()))",
      "self.mamba_has_prefill_checkpoint_blocks = self.has_mamba_layers and (not self.use_eagle or (speculative_config is not None and speculative_config.use_dflash()) or mtp_has_independent_draft_state) and all((not isinstance(group.kv_cache_spec, MambaSpec) or group.kv_cache_spec.num_prefill_checkpoint_blocks > 0 for group in kv_cache_config.kv_cache_groups))"
    ],
    "conclusion": "The only AST changes classify independent Qwen MTP draft state and enable existing checkpoint capacity. All other scheduler AST nodes and the other nine lease-contract files retain identity. No lease acquisition, release, dispatch, fence, invalidation or post-forward callback changes."
