+@lru_cache(maxsize=None)
+def _checkpoint_program(
+    device: torch.device,
+    channels: int,
+    state_length: int,
+    state_capacity: int,
+    state_stride: int,
+):
+    """Resolve once per static layout during R37's eager mixed warmup.
+
+    Compile at each dtype's minimum alignment so any valid contiguous metadata
+    view can be supplied later. No request count, offset, slot ID, or tensor
+    address belongs in this cache key.
+    """
+    raise_if_kernel_resolution_frozen(
+        "triton checkpoint warmup", target=_export_checkpoint_kernel,
+        cache_key=(device, channels, state_length, state_capacity, state_stride),
+    )
+    with torch.cuda.device(device):
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("warm up mixed PLE before capturing checkpoint export")
+        bf16 = _CompilePointer(torch.bfloat16, 2)
+        i32 = _CompilePointer(torch.int32, 4)
+        i64 = _CompilePointer(torch.int64, 8)
+        boolean = _CompilePointer(torch.bool, 1)
+        program = _export_checkpoint_kernel.warmup(
