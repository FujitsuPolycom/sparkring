+@pytest.mark.parametrize("count", [0, 3, True, 2.0])
+def test_caps_reject_invalid_checkpoint_capacity(count):
+    with pytest.raises(ValueError, match="max_checkpoints"):
+        impl.Caps(
+            device="cuda:0",
