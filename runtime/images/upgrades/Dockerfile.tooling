ARG PARENT
FROM ${PARENT} AS native-system-tools
ARG ELFUTILS_VERSION=0.190-1.1ubuntu0.1
# DeepGEMM's C++ exception diagnostics require the libdwfl development headers.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libdw-dev=${ELFUTILS_VERSION} libelf-dev=${ELFUTILS_VERSION} \
      libdw1t64=${ELFUTILS_VERSION} libelf1t64=${ELFUTILS_VERSION} && \
    c++ -std=c++20 -fsyntax-only -x c++ -include elfutils/libdwfl.h /dev/null && \
    mkdir -p /opt/sparkring/compiler && \
    dpkg-query -W libdw-dev libelf-dev libdw1t64 libelf1t64 > /opt/sparkring/compiler/elfutils-packages.txt
LABEL org.sparkring.compiler.elfutils-version=${ELFUTILS_VERSION}

FROM native-system-tools AS tooling
COPY inputs/ /build-tooling-inputs/
COPY tooling.py /build-tooling-inputs/tooling.py
RUN /opt/venv/bin/python -S /build-tooling-inputs/tooling.py verify --root /build-tooling-inputs
RUN /opt/venv/bin/python -m pip install --no-index --no-deps /build-tooling-inputs/wheels/*.whl
RUN mkdir /tmp/rust-install && \
    tar -xf /build-tooling-inputs/rust-1.95.0-aarch64-unknown-linux-gnu.tar.xz -C /tmp/rust-install && \
    /tmp/rust-install/rust-1.95.0-aarch64-unknown-linux-gnu/install.sh --prefix=/opt/rust --without=rust-docs --disable-ldconfig && \
    /opt/rust/bin/rustc --version && /opt/rust/bin/cargo --version && \
    rm -rf -- /tmp/rust-install
ENV PATH=/opt/rust/bin:${PATH}
ENTRYPOINT ["/opt/venv/bin/python"]
