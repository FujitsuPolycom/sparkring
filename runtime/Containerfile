# SparkRing reproducible runtime builder (public lane scaffold)
#
# Multi-stage, aarch64-only, CUDA 13.x devel -> runtime, target sm_121
# (NVIDIA GB10 / DGX Spark).
#
# EVERY version-shaped value arrives as an ARG supplied by build-runtime.sh,
# which reads runtime-lock.json. Nothing version-shaped is hardcoded in this
# file's body. If an ARG is missing the build fails closed at the first
# `test -n` guard rather than silently building something unpinned.
#
# HONEST BUILD-TIME NOTE: compiling vLLM from source for a single arch
# (sm_121) on a GB10-class aarch64 host takes on the order of 1.5-3 hours;
# on an emulated (qemu/binfmt) x86 host it can exceed 12 hours and is not
# recommended. NCCL adds ~10-20 minutes. Plan accordingly and use
# --build-arg MAX_JOBS to bound memory pressure.

# ---------------------------------------------------------------------------
# Pins (all injected from runtime-lock.json by build-runtime.sh)
# ---------------------------------------------------------------------------
ARG BASE_DEVEL_IMAGE
ARG BASE_RUNTIME_IMAGE
ARG CUDA_ARCH
ARG PYTHON_VERSION
ARG TORCH_CUDA_VERSION
ARG TORCH_SPEC
ARG TORCH_INDEX_URL
ARG VLLM_REPO
ARG VLLM_COMMIT
ARG SPARKINFER_REPO
ARG SPARKINFER_COMMIT
ARG FLASHINFER_REPO
ARG FLASHINFER_COMMIT
ARG FLASHINFER_PYTHON_VERSION
ARG FLASHINFER_JIT_CACHE_SPEC
ARG FLASHINFER_JIT_CACHE_SHA256
ARG FLASHINFER_WHEEL_INDEX
ARG DEEPGEMM_REPO
ARG DEEPGEMM_COMMIT
ARG DEEPGEMM_VERSION
ARG NCCL_REPO
ARG NCCL_COMMIT
ARG MODEL_REPO_ID
ARG MODEL_REVISION
ARG MODEL_CONFIG_SHA256
ARG RUNTIME_ID
ARG MAX_JOBS=8

# ===========================================================================
# Stage 1 — patched switchless NCCL
# ===========================================================================
FROM ${BASE_DEVEL_IMAGE} AS nccl-build
ARG NCCL_REPO
ARG NCCL_COMMIT
ARG CUDA_ARCH
ARG MAX_JOBS

RUN test -n "${NCCL_REPO}" && test -n "${NCCL_COMMIT}" && test -n "${CUDA_ARCH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential devscripts debhelper fakeroot \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN git clone "${NCCL_REPO}" nccl \
    && cd nccl \
    && git checkout "${NCCL_COMMIT}" \
    && test "$(git rev-parse HEAD)" = "${NCCL_COMMIT}"

# Patch series from the in-repo switchless-ring experiment
# (spark_transport/experiments/nccl_switchless_ring/):
#   1. nccl-2.30.7-skip-tree-pat.patch            (skip Tree/PAT connect)
#   2. nccl-2.30.7-advertise-all-listener-gids.patch (advertise all RoCE GIDs)
# Applied with `git apply --check` first (no fuzz, no fallback).
# Exactly the two 2.30.7 patches pinned in runtime-lock.json (nccl.patches) —
# no globbing, so stray patch files in the experiment dir can never leak in.
COPY spark_transport/experiments/nccl_switchless_ring/nccl-2.30.7-skip-tree-pat.patch \
     spark_transport/experiments/nccl_switchless_ring/nccl-2.30.7-advertise-all-listener-gids.patch \
     /build/nccl-patches/
RUN cd nccl \
    && for p in /build/nccl-patches/*.patch; do \
         echo "applying $p"; \
         git apply --check "$p" || { echo "FATAL: NCCL patch preimage mismatch: $p" >&2; exit 1; }; \
         git apply "$p"; \
       done

RUN cd nccl \
    && make -j"${MAX_JOBS}" src.build \
         NVCC_GENCODE="-gencode=arch=compute_${CUDA_ARCH},code=sm_${CUDA_ARCH}" \
    && mkdir -p /out/nccl \
    && cp -a build/lib/libnccl.so* /out/nccl/ \
    && sha256sum /out/nccl/libnccl.so.* | tee /out/nccl/SHA256SUMS

# ===========================================================================
# Stage 2 — vLLM + pinned python stack + fail-closed patch overlay
# ===========================================================================
FROM ${BASE_DEVEL_IMAGE} AS vllm-build
ARG CUDA_ARCH
ARG PYTHON_VERSION
ARG TORCH_CUDA_VERSION
ARG TORCH_SPEC
ARG TORCH_INDEX_URL
ARG VLLM_REPO
ARG VLLM_COMMIT
ARG SPARKINFER_REPO
ARG SPARKINFER_COMMIT
ARG FLASHINFER_REPO
ARG FLASHINFER_COMMIT
ARG FLASHINFER_PYTHON_VERSION
ARG FLASHINFER_JIT_CACHE_SPEC
ARG FLASHINFER_JIT_CACHE_SHA256
ARG FLASHINFER_WHEEL_INDEX
ARG DEEPGEMM_REPO
ARG DEEPGEMM_COMMIT
ARG DEEPGEMM_VERSION
ARG MAX_JOBS

RUN test -n "${VLLM_COMMIT}" && test -n "${TORCH_SPEC}" && test -n "${CUDA_ARCH}" \
    && test -n "${SPARKINFER_COMMIT}" && test -n "${FLASHINFER_PYTHON_VERSION}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential cmake ninja-build ccache \
        python3 python3-venv python3-dev libibverbs-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN test "$(python3 -c 'import platform; print(platform.python_version())')" = \
        "${PYTHON_VERSION}"

# Pinned torch first (own index), then the publicly fetchable portion of the
# audited freeze. Reviewed file:// entries are installed from pinned inputs
# later in this stage.
COPY runtime/pip-freeze.txt /build/pip-freeze.txt
COPY runtime/prepare-public-requirements.py /build/prepare-public-requirements.py
RUN pip install --no-cache-dir "${TORCH_SPEC}" --index-url "${TORCH_INDEX_URL}" \
    && test "$(python3 -c 'import torch; print(torch.version.cuda)')" = \
         "${TORCH_CUDA_VERSION}" \
    && python3 /build/prepare-public-requirements.py \
         --freeze /build/pip-freeze.txt \
         --output /build/public-requirements.txt \
    && pip install --no-cache-dir \
         --extra-index-url "${TORCH_INDEX_URL}" \
         -r /build/public-requirements.txt

# vLLM from the pinned public commit, source build for sm_121 only.
# NOTE: this is the multi-hour step (see header).
WORKDIR /build
RUN git clone "${VLLM_REPO}" vllm \
    && cd vllm \
    && git checkout "${VLLM_COMMIT}" \
    && git submodule update --init --recursive
ENV TORCH_CUDA_ARCH_LIST="12.1" \
    CMAKE_CUDA_ARCHITECTURES="${CUDA_ARCH}" \
    VLLM_TARGET_DEVICE=cuda
RUN cd vllm \
    && MAX_JOBS="${MAX_JOBS}" pip install --no-cache-dir --no-build-isolation -v .

# Pinned kernel/companion packages. Source commits determine the installed
# b12x, FlashInfer-Python and DeepGEMM trees.
RUN pip install --no-cache-dir \
        "git+${SPARKINFER_REPO}@${SPARKINFER_COMMIT}" \
    && git clone "${FLASHINFER_REPO}" /build/flashinfer \
    && cd /build/flashinfer \
    && git checkout "${FLASHINFER_COMMIT}" \
    && test "$(git rev-parse HEAD)" = "${FLASHINFER_COMMIT}" \
    && git submodule update --init --recursive \
    && FLASHINFER_LOCAL_VERSION=cu132 pip install --no-cache-dir . \
    && test "$(python3 -c 'from importlib.metadata import version; print(version("flashinfer-python"))')" = \
         "${FLASHINFER_PYTHON_VERSION}" \
    && printf '%s --hash=sha256:%s\n' \
         "${FLASHINFER_JIT_CACHE_SPEC}" "${FLASHINFER_JIT_CACHE_SHA256}" \
         > /build/flashinfer-jit-cache.requirements.txt \
    && pip install --no-cache-dir --no-deps --require-hashes \
         --extra-index-url "${FLASHINFER_WHEEL_INDEX}" \
         -r /build/flashinfer-jit-cache.requirements.txt \
    && git clone "${DEEPGEMM_REPO}" /build/deepgemm \
    && cd /build/deepgemm \
    && git checkout "${DEEPGEMM_COMMIT}" \
    && test "$(git rev-parse HEAD)" = "${DEEPGEMM_COMMIT}" \
    && git submodule update --init --recursive \
    && pip install --no-cache-dir . \
    && test "$(python3 -c 'from importlib.metadata import version; print(version("deep-gemm"))')" = \
         "${DEEPGEMM_VERSION}"

COPY runtime/verify-frozen-packages.py /build/verify-frozen-packages.py
RUN python3 /build/verify-frozen-packages.py --freeze /build/pip-freeze.txt

# ---------------------------------------------------------------------------
# Fail-closed patch overlay (runtime/patches/**).
#
# apply-patches.py verifies, for EVERY patch, the sha256 of the exact
# preimage file inside the installed tree BEFORE applying, uses git apply
# without fuzz, and aborts the whole build on any mismatch. Philosophy and
# manifest schema follow spark_transport/experiments/fail_closed_mod_overlay/.
#
# runtime/patches/vllm/ currently ships the two independently written,
# preimage-pinned SparkCache compatibility patches. The larger reference
# overlay remains withheld pending provenance cleanup; see its README.
# ---------------------------------------------------------------------------
COPY runtime/patches /build/patches
COPY runtime/apply-patches.py /build/apply-patches.py
RUN python3 /build/apply-patches.py \
        --patches-root /build/patches \
        --site-packages "$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
        --log /var/log/sparkring/patch-apply.jsonl \
        --fail-closed

# spark_transport (probes + libspark_transport_capi.so), sm_121.
COPY spark_transport /build/spark_transport
COPY runtime/public-overlay-files.json /build/public-overlay-files.json
COPY runtime/build-public-overlay.py /build/build-public-overlay.py
RUN python3 /build/build-public-overlay.py \
        --repo /build \
        --spec /build/public-overlay-files.json \
        --output /out/public-overlay
RUN cmake -S /build/spark_transport -B /build/spark_transport_build \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCH}" \
    && cmake --build /build/spark_transport_build --parallel "${MAX_JOBS}" \
    && ctest --test-dir /build/spark_transport_build --output-on-failure \
    && mkdir -p /out/spark_transport \
    && find /build/spark_transport_build -maxdepth 1 \
         \( -name 'libspark_transport_capi*.so' -o -name 'spark_tp4_*probe*' -o -name 'spark_transport_probe' \) \
         -exec cp -a {} /out/spark_transport/ \; \
    && sha256sum /out/spark_transport/* | tee /out/spark_transport/SHA256SUMS

# ===========================================================================
# Stage 3 — runtime image + immutable manifest
# ===========================================================================
FROM ${BASE_RUNTIME_IMAGE} AS runtime
ARG RUNTIME_ID
ARG VLLM_COMMIT
ARG SPARKINFER_COMMIT
ARG FLASHINFER_COMMIT
ARG NCCL_COMMIT
ARG MODEL_REPO_ID
ARG MODEL_REVISION
ARG MODEL_CONFIG_SHA256

RUN test -n "${RUNTIME_ID}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 libibverbs1 ibverbs-providers \
    && rm -rf /var/lib/apt/lists/*

COPY --from=vllm-build /opt/venv /opt/venv
COPY --from=vllm-build /out/spark_transport /opt/sparkring/spark_transport
COPY --from=vllm-build /out/public-overlay /opt/spark-vllm
COPY --from=nccl-build /out/nccl /opt/sparkring/nccl
COPY --from=vllm-build /var/log/sparkring /var/log/sparkring
ENV PATH=/opt/venv/bin:$PATH \
    LD_PRELOAD=/opt/sparkring/nccl/libnccl.so.2 \
    SPARKRING_RUNTIME_ID=${RUNTIME_ID}

# Immutable runtime manifest: pins, wheel hashes, .so hashes, applied-patch
# hashes, model identity pin. generate-manifest.py fails the build if any
# component it expects is absent or hash-inconsistent.
COPY runtime/generate-manifest.py /opt/sparkring/generate-manifest.py
COPY runtime/verify-runtime.py /opt/sparkring/verify-runtime.py
COPY runtime/public-capability-gate.py /opt/sparkring/public-capability-gate.py
COPY runtime/public-model-preflight.py /opt/sparkring/public-model-preflight.py
COPY runtime/public-entrypoint.sh /opt/sparkring/public-entrypoint.sh
COPY runtime/runtime-lock.json /opt/sparkring/runtime-lock.json
RUN set -e; \
    args="--lock /opt/sparkring/runtime-lock.json --runtime-id ${RUNTIME_ID}"; \
    args="$args --tree venv=/opt/venv --tree public-overlay=/opt/spark-vllm --with-packages"; \
    for f in /opt/sparkring/nccl/libnccl.so.* /opt/sparkring/spark_transport/*; do \
        case "$f" in *SHA256SUMS) continue;; esac; \
        [ -f "$f" ] && args="$args --native-lib $f"; \
    done; \
    if [ -f /var/log/sparkring/patch-apply.jsonl ]; then \
        args="$args --patch-log /var/log/sparkring/patch-apply.jsonl"; \
    fi; \
    python3 /opt/sparkring/generate-manifest.py $args --image-digest external \
        --output /opt/sparkring/runtime-manifest.json \
    && chmod 0555 /opt/sparkring/public-entrypoint.sh \
    && chmod 0444 /opt/sparkring/runtime-manifest.json

LABEL org.sparkring.runtime_id=${RUNTIME_ID} \
      org.sparkring.vllm_commit=${VLLM_COMMIT} \
      org.sparkring.sparkinfer_commit=${SPARKINFER_COMMIT} \
      org.sparkring.flashinfer_commit=${FLASHINFER_COMMIT} \
      org.sparkring.nccl_commit=${NCCL_COMMIT} \
      org.sparkring.model_repo=${MODEL_REPO_ID} \
      org.sparkring.model_revision=${MODEL_REVISION} \
      org.sparkring.model_config_sha256=${MODEL_CONFIG_SHA256}

ENTRYPOINT ["/opt/sparkring/public-entrypoint.sh"]
