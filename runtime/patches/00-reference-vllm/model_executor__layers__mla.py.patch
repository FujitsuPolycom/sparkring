+# ── NVFP4 MLA per-layer outer-scale calibration (koush 4959a3f half (a),
+# WRAPPER-SYMMETRIC variant) ────────────────────────────────────────────────
+#
+# The b12x-hybrid nvfp4_ds_mla record is SELF-DESCRIBING: the writer
+# (b12x-hybrid attention/mla/kv_cache.py) quantizes each group of 16 latent
+# dims with scale byte = e4m3(group_amax / 6) at an implicit global scale of
+# 1.0, and the readers (decode_math s1/s6 via _nvfp4_pair_bfloat2) dequantize
+# fp4 * e4m3-group-scale with NO outer scale.  Feeding the writer x/s_l
+# therefore makes every reader hand attention x/s_l — koush's tree restored
+# s_l inside the CuTe kernels (companion PR to lukealonso/b12x, `latent_scale`
+# runtime scalar); our kernels have no such parameter.
+#
+# Instead we compensate ALGEBRAICALLY at this wrapper, which needs no kernel
+# or backend change and is exact by bilinearity:
+#
+#   cache/latent side:  kv_cache <- x / s_l          (both K-nope and V lanes)
+#   query side:         q_nope   <- q_nope * s_l
+#   output side:        attn_out <- attn_out * s_l
+#
+#   logits = (s_l * q_nope) @ W_UK @ (x / s_l) + q_pe @ k_pe   = exact
+#   output = s_l * [ softmax(exact logits) @ W_UV @ (x / s_l) ] = exact
+#
+# Every latent consumer inside mla_attn is covered: the paged-cache writer
+# (do_kv_cache_update + the VLLM_B12X_KV_STREAM variant), the DCP CKV-gather
+# current-chunk append (set_ckv_current_chunk_kv receives this same tensor;
+# gathered history moves as raw 368 B records, byte-level), and the decode
+# quota path all see the SAME uniformly scaled tensor; q_nope reaches logits
+# only through the linear W_UK_T bmm; attn_out passes only through
+# scalar-exact LSE merges (incl. the sigmoid(lse - sink) fold) and the linear
+# W_UV projection before returning here.  The RoPE lane (k_pe / q_pe) is a
+# disjoint tensor and stays bit-for-bit untouched.
+#
+# The quality win: with the implicit global scale fixed at 1.0, layers whose
+# latent groups have small amax push the e4m3 scale byte into its subnormal
+# floor (poor relative precision; below ~2^-10 the byte rounds to zero and the
+# writer zeroes the whole group).  Dividing by the calibrated
+# s_l ~ amax_layer/(6*448) repositions group scales near the top of the e4m3
+# range.  KV records written under a given s_l are only ever read under the
+# same s_l (loaded once at init, constant for the process lifetime).
+#
+# DO NOT combine this wrapper-symmetric scheme with a koush-style kernel-side
+# latent_scale restore: the two would double-apply s_l.
+#
+# Gate: VLLM_NVFP4_MLA_SCALES_FILE (unset -> scale 1.0 -> all three branches
+# below are constant-false under Dynamo -> byte-identical behavior).
+_NVFP4_MLA_SCALES_ENV = "VLLM_NVFP4_MLA_SCALES_FILE"
+_NVFP4_MLA_SCALES_FORMAT = "nvfp4_ds_mla_outer_scale_v1"
+_NVFP4_MLA_NUM_LAYERS = 78
+_NVFP4_MLA_LATENT_DIM = 512
+_NVFP4_MLA_SCALE_DENOMINATOR = 6.0 * 448.0
+_NVFP4_MLA_LAYER_RE = re.compile(r"(?:^|\.)layers\.(\d+)(?:\.|$)")
+
+# Calibration CAPTURE (Part A of the same feature): when
+# VLLM_NVFP4_MLA_CALIB_DIR is set, each MLA layer dumps row-subsampled copies
+# of its PRISTINE compressed latent (kv_c_normed, the exact writer input) for
+# the offline scale fit (glm-dcp2/tools/nvfp4-mla-calibrate.py).  Calibration
+# runs must be eager (use the -eager launcher) and must NOT set the scales
+# file (enforced below).  Unset -> zero code on the forward path.
+_NVFP4_MLA_CALIB_DIR_ENV = "VLLM_NVFP4_MLA_CALIB_DIR"
+_NVFP4_MLA_CALIB_DIR = os.getenv(_NVFP4_MLA_CALIB_DIR_ENV, "").strip()
+
+# Per-token NoPE global scale (task #52 Phase-1 precision): the b12x writer
+# stores fp32 s_tok = max(token_amax/2688, 1e-12) at record bytes [356, 360)
+# and the b12x readers fold it into the group-scale dequant — the principled,
+# self-describing replacement for this wrapper's STATIC per-layer outer-scale
+# scheme. The two are MUTUALLY EXCLUSIVE: combining them would double-apply a
+# latent rescale (the static path pre-divides the latent AND compensates on
+# the q/output side, while the per-token records already carry their own
+# magnitude). Enforced below at layer init.
+_NVFP4_MLA_PER_TOKEN_SCALE_ENV = "VLLM_NVFP4_MLA_PER_TOKEN_SCALE"
+
