+# ---------------------------------------------------------------------------
+# VLLM_B12X_MLA_DECODE_GATHER_V2 ("Doc-1"): exact-global-top-k sparse CKV
+# gather for DCP DECODE. Successor to the Tier-3 per-rank-quota gather
+# (VLLM_B12X_MLA_DECODE_SPARSE_GATHER); mutually exclusive with it — when
+# both envs are set, V2 wins and the quota path is force-disabled.
+#
+# Design (serial v1):
+#   1. The indexer finalizes the EXACT global top-k (its default
+#      VLLM_DCP_GLOBAL_TOPK=1 merge, _merge_b12x_dcp_topk) — identical
+#      merged GLOBAL logical ids on every DCP rank. No indexer layout fork,
+#      unlike quota, so indexer/attention can never disagree on a batch.
+#   2. Each rank causally masks the ids (id < per-row global causal len)
+#      and derives per-owner record counts ARITHMETICALLY from the same
+#      merged list — all ranks compute identical [dcp, rows] counts, no
+#      extra collective (_v2_mask_topk_and_count_kernel).
+#   3. Each owner packs ITS selected records locally
+#      (triton_convert_dcp_global_index_to_local_index compaction +
+#      index_select from its own paged cache) — the doc's "option 3":
+#      physical slots never cross ranks, so paged cache layout divergence,
+#      prefix sharing, block reuse and eviction are all immaterial.
+#   4. One FIXED-SIZE records all-gather over get_dcp_group() (pynccl,
+#      caller-owned persistent output; NO dedicated communicator — the
+#      ckv-prefetch comm costs >1.3GB at boot peak, boot O).
+#   5. _quota_compact_kernel (reused, QK=topk) concatenates the per-rank
+#      valid prefixes into one index row over the gathered layout; each
+#      rank then runs its LOCAL TP heads against the complete selected
+#      set — no Q-head all-gather, no LSE merge (mla_attention's existing
+#      dcp_decode_quota_eligible gate covers V2 too).
+#
+# Serial path correctness note (current token): do_kv_cache_update runs
+# BEFORE forward_mqa, so the decode step's own tokens are already in the
+# paged cache when the pack runs — no current-token patch is needed. The
+# patch (_append_current_chunk_to_gathered mechanism) becomes necessary
+# only in the PREFETCH pipeline, where a gather is issued before the
+# target layer's KV update (see the scaffold notes in
+# _dcp_decode_gather_v2).
+#
+# Memory (per worker, allocated once at init when enabled): the arena is
+# (1 + dcp) * rows_cap * topk * record_bytes. rows_cap defaults to
+# (1 + num_speculative_tokens): an MTP-K verify step runs up to K+1 query
+# rows per request and rows do NOT share gathered records (no cross-row
+# dedup — doc's "MTP rows honestly" point), so the arena carries one
+# record set per row. Production numbers (topk=2048, DCP4, rows_cap=4):
+# nvfp4 368 B -> 15.1 MiB, fp8 656 B -> 26.9 MiB. Never-grow, module
+# level, shared by all layers (layers execute serially).
+# ---------------------------------------------------------------------------
+
+
+def _decode_gather_v2_rows_cap(vllm_config) -> int:
+    """Max decode query rows the V2 gather serves; larger batches fall back.
+
+    Builder and impl both call this so their verdicts can never diverge.
+    Default = 1 + num_speculative_tokens (the doc's BS=1 scope: one request
+    with all its MTP rows). VLLM_B12X_MLA_DECODE_GATHER_V2_MAX_ROWS raises
+    it for concurrency experiments (validation ladder step 9) at
+    (1 + dcp) * topk * record_bytes of arena per extra row.
+    """
+    q_per_req = 1
+    spec = getattr(vllm_config, "speculative_config", None)
+    if spec is not None and getattr(spec, "num_speculative_tokens", None):
+        q_per_req = 1 + int(spec.num_speculative_tokens)
+    return _env_int("VLLM_B12X_MLA_DECODE_GATHER_V2_MAX_ROWS", q_per_req)
+
+
+_DECODE_GATHER_V2_STATE: dict[tuple[str, int | None], dict[str, Any]] = {}
+
+
+def _get_decode_gather_v2_state(
+    device: torch.device,
+    *,
+    rows_cap: int,
+    topk_tokens: int,
+    dcp_world_size: int,
+    record_bytes: int,
+) -> dict[str, Any]:
+    """One persistent V2 gather arena per worker GPU, shared by all layers.
+
+    Same discipline as _CKV_GATHER_WORKSPACES: allocated at init (never
+    lazily), never grows, and EVERY tensor the gather reads or writes in
+    eager verify steps lives here — per-call device allocations in
+    per-layer paths are earlyoom fuel on 121 GB unified boxes (the Tier-3
+    eager allocator inflation, ~1 GB steady-state, OPT-LOG 07-17 late).
+    Layout (records of ``record_bytes``):
+      [0, rows_cap*topk)                      local packed (this rank)
+      [rows_cap*topk, (1+dcp)*rows_cap*topk)  gathered (rank-major)
+    """
+    key = (device.type, device.index)
+    config = (rows_cap, topk_tokens, dcp_world_size, record_bytes)
+    state = _DECODE_GATHER_V2_STATE.get(key)
+    if state is not None:
+        if state["config"] != config:
+            raise RuntimeError(
+                "decode gather V2 arena cannot be reshaped after layers "
+                f"retain aliases: existing={state['config']} requested={config}"
+            )
+        return state
+    packed_cap_records = rows_cap * topk_tokens
+    state = {
+        "config": config,
+        "packed_cap_records": packed_cap_records,
+        "arena": torch.empty(
+            ((1 + dcp_world_size) * packed_cap_records, record_bytes),
+            dtype=torch.uint8,
+            device=device,
+        ),
+        "masked_ids": torch.empty(
+            (rows_cap, topk_tokens), dtype=torch.int32, device=device
+        ),
+        "counts": torch.empty(
+            (dcp_world_size * rows_cap,), dtype=torch.int32, device=device
+        ),
+        "pack_index": torch.empty(
+            (packed_cap_records,), dtype=torch.int64, device=device
+        ),
+    }
+    _DECODE_GATHER_V2_STATE[key] = state
+    return state
+
+
+@triton.jit
+def _v2_mask_topk_and_count_kernel(
+    ids_ptr,
+    lens_ptr,
+    masked_ptr,
+    counts_ptr,
+    rows,
+    ids_stride0,
+    ids_stride1,
+    DCP: tl.constexpr,
+    INTERLEAVE: tl.constexpr,
+    TOPK: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    """Causally mask merged GLOBAL top-k ids; count records per owner rank.
+
+    Every DCP rank runs this on the SAME merged id list, so all ranks
+    derive identical counts[DCP, rows] with no collective. For a causally
+    masked id every owner-side block-table lookup succeeds, so
+    _convert_dcp_global_index_to_local_index's validity reduces to
+    ownership — each owner's local pack keeps EXACTLY counts[owner, row]
+    entries, which is what makes the collective-free compaction sound.
+    """
+    row = tl.program_id(0)
+    seq_len = tl.load(lens_ptr + row)
+    offs = tl.arange(0, BLOCK_K)
+    lane_mask = offs < TOPK
+    ids = tl.load(
+        ids_ptr + row * ids_stride0 + offs * ids_stride1,
+        mask=lane_mask,
+        other=-1,
+    )
+    valid = (ids >= 0) & (ids < seq_len)
+    masked = tl.where(valid, ids, -1)
+    tl.store(masked_ptr + row * TOPK + offs, masked, mask=lane_mask)
+    owner = (ids // INTERLEAVE) % DCP
+    for seg in tl.static_range(DCP):
+        cnt = tl.sum((valid & (owner == seg)).to(tl.int32), axis=0)
+        tl.store(counts_ptr + seg * rows + row, cnt)
+
+
+def _v2_mask_topk_and_count(
+    topk_indices: torch.Tensor,
+    global_lens_per_token: torch.Tensor,
+    masked_out: torch.Tensor,
+    counts_out: torch.Tensor,
+    *,
+    dcp_size: int,
+    cp_kv_cache_interleave_size: int,
+) -> None:
+    rows, topk = topk_indices.shape
+    if tuple(masked_out.shape) != (rows, topk):
+        raise ValueError("V2 gather masked-id scratch shape mismatch")
+    if counts_out.numel() < dcp_size * rows:
+        raise ValueError("V2 gather counts scratch is too small")
+    if any(
+        tensor.dtype != torch.int32
+        for tensor in (
+            topk_indices,
+            global_lens_per_token,
+            masked_out,
+            counts_out,
+        )
+    ):
+        raise TypeError("V2 gather mask/count metadata must be int32")
+    if (
+        not masked_out.is_contiguous()
+        or not counts_out.is_contiguous()
+        or not global_lens_per_token.is_contiguous()
+        or global_lens_per_token.numel() < rows
+    ):
+        raise ValueError("V2 gather mask/count buffers must be contiguous")
+    block_k = triton.next_power_of_2(topk)
+    _v2_mask_topk_and_count_kernel[(rows,)](
+        topk_indices,
+        global_lens_per_token,
+        masked_out,
+        counts_out,
+        rows,
+        topk_indices.stride(0),
+        topk_indices.stride(1),
+        DCP=dcp_size,
+        INTERLEAVE=cp_kv_cache_interleave_size,
+        TOPK=topk,
+        BLOCK_K=block_k,
+        num_warps=4 if block_k <= 256 else 8,
+    )
+
