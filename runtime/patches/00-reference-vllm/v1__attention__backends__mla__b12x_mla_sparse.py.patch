+# ---------------------------------------------------------------------------
+# VLLM_B12X_KV_STREAM (stream separation, step 2): run this layer's paged
+# KV-cache write (do_kv_cache_update), the sync CKV history gather, and the
+# prefetch-consume current-chunk append on ONE process-global dedicated KV
+# stream — for gather-eligible EAGER PREFILL batches only (decode, mixed,
+# capture, profile and gather-denied batches stay inline on main). Mirrors
+# sparse_attn_indexer's VLLM_B12X_INDEXER_STREAM machinery: one lazy global
+# stream + a layer-index-keyed event registry.
+#   * LAUNCH: kv_stream_do_kv_cache_update (called from the eager
+#     unified_mla_kv_cache_update custom-op body) hops the write onto the KV
+#     stream; forward_mqa's early block (_kv_stream_gather_early) then
+#     issues the gather/append on the same stream BEFORE the indexer join
+#     and the top-k remap, so it overlaps the main-stream q pipeline and —
+#     with VLLM_B12X_INDEXER_STREAM — the indexer body.
+#   * JOIN: forward_mqa waits the layer's event right where the inline sync
+#     gather used to complete, i.e. before the attention kernel consumes the
+#     gathered arena; because the write event was recorded on the SAME
+#     stream earlier, that join also orders every later main-stream reader
+#     of the paged cache after the side-streamed write.
+#   * SAFETY: dcp_prefill_ckv_gather_eligible's deny path drains ALL pending
+#     KV events (and acquires the dcp comm token) before any main-stream
+#     paged-cache consumer or get_dcp_group() collective can run.
+#   * COMMS: the gather's all-gather stays on get_dcp_group() (the dedicated
+#     ckv-prefetch communicator is banned: >1.3GB at boot peak) and is
+#     event-serialized against the indexer merge via sparse_attn_indexer's
+#     module-level dcp comm token.
+# Default off -> byte-identical inert.
+# ---------------------------------------------------------------------------
+
+_KV_STREAM_ENV = "VLLM_B12X_KV_STREAM"
+# ONE global KV side stream, created lazily on first use (NOT per layer).
+_kv_stream: "torch.cuda.Stream | None" = None
+# layer index -> event recorded on the KV stream after that layer's last
+# side-streamed KV work (write, then gather/append; later records overwrite
+# earlier ones — same stream, so waiting the newest covers all of them).
+_kv_stream_events: dict[int, "torch.cuda.Event"] = {}
+
+
+def _get_kv_stream(device: torch.device) -> "torch.cuda.Stream":
+    global _kv_stream
+    if _kv_stream is None:
+        _kv_stream = torch.cuda.Stream(device=device)
+    return _kv_stream
+
+
+def _wait_kv_stream_events(layer_idx: "int | None" = None) -> None:
+    """Make the CURRENT stream wait on pending KV-stream events.
+
+    ``layer_idx=None`` drains every pending event (the conservative safety
+    join used before any main-stream paged-cache consumer on the non-gather
+    route). Entries are cleared once waited. No-op when nothing is pending,
+    so decode / env-off callers pay only a dict truthiness check.
+    """
+    if not _kv_stream_events:
+        return
+    if layer_idx is None:
+        events = list(_kv_stream_events.values())
+        _kv_stream_events.clear()
+    else:
+        event = _kv_stream_events.pop(layer_idx, None)
+        if event is None:
+            return
+        events = [event]
+    current = torch.cuda.current_stream()
+    for event in events:
+        current.wait_event(event)
 
 
