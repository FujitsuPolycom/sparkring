+@triton.jit
+def _quota_compact_kernel(
+    counts_ptr,
+    out_ptr,
+    nsa_ptr,
+    rows,
+    QK: tl.constexpr,
+    DCP: tl.constexpr,
+    TOPK: tl.constexpr,
+):
+    """Compact per-rank quota segments into a valid-prefix index row.
+
+    counts: [DCP, rows] valid records per segment (arithmetic-derived).
+    out:    [rows, TOPK] slots into the gathered [DCP, rows, QK] flat layout.
+    """
+    row = tl.program_id(0)
+    if row >= rows:
+        return
+    write = 0
+    for seg in tl.static_range(DCP):
+        cnt = tl.load(counts_ptr + seg * rows + row)
+        offs = tl.arange(0, QK)
+        slots = seg * rows * QK + row * QK + offs
+        mask = offs < cnt
+        tl.store(out_ptr + row * TOPK + write + offs, slots, mask=mask)
+        write += cnt
+    offs = tl.arange(0, TOPK)
+    tl.store(out_ptr + row * TOPK + offs, -1, mask=offs >= write)
+    tl.store(nsa_ptr + row, write)
+
