+def _parse_adaptive_spec_depth_ladder(num_speculative_tokens: int) -> list[int]:
+    """Selectable speculative depths (K values) for acceptance-length
+    adaptation, from env VLLM_ADAPTIVE_SPEC_DEPTHS (comma-separated ints,
+    default "2,4").
+
+    Defensive parsing: a malformed value falls back to the default rather
+    than aborting engine boot; depths outside [1, num_speculative_tokens]
+    are dropped (the full depth is appended separately by the caller). Keep
+    in sync with the floor-snap ladder parse in
+    vllm/v1/core/sched/scheduler.py.
+    """
+    raw = os.getenv("VLLM_ADAPTIVE_SPEC_DEPTHS", _ADAPTIVE_SPEC_DEPTHS_DEFAULT)
+    try:
+        depths = sorted(
+            {int(tok) for tok in raw.split(",") if tok.strip()}
+        )
+    except ValueError:
+        logger.warning(
+            "VLLM_ADAPTIVE_SPEC_DEPTHS=%r is not a comma-separated list of "
+            "ints; falling back to %r.",
+            raw,
+            _ADAPTIVE_SPEC_DEPTHS_DEFAULT,
+        )
+        depths = sorted(
+            {int(tok) for tok in _ADAPTIVE_SPEC_DEPTHS_DEFAULT.split(",")}
+        )
+    valid = [d for d in depths if 1 <= d <= num_speculative_tokens]
+    if valid != depths:
+        logger.warning(
+            "VLLM_ADAPTIVE_SPEC_DEPTHS=%r: dropped out-of-range depths "
+            "(valid range [1, %d]); using %s.",
+            raw,
+            num_speculative_tokens,
+            valid,
+        )
