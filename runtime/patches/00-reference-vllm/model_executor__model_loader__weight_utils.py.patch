@@ -903,6 +903,34 @@
 
     sorted_files = sorted(hf_weights_files, key=_natural_sort_key)
 
+    # INDEX-AUTHORITATIVE TENSOR FILTER (hybrid 07-19): in the merged hybrid
+    # checkpoint, festr2's expert shards ALSO contain BF16 dense/shared tensors
+    # that the stitched index deliberately maps to the RedHat extract shards.
+    # Without this filter the iterator yields every tensor in every kept file
+    # and load_weights KeyErrors (e.g. shared_experts.down_proj.weight). With an
+    # index present, only tensors the index maps TO THE FILE BEING READ are
+    # yielded. Normal checkpoints map every in-file tensor to its own file, so
+    # this is a no-op for them.
+    _allowed_by_file = None
+    if sorted_files:
+        _idx_p = os.path.join(
+            os.path.dirname(sorted_files[0]), "model.safetensors.index.json"
+        )
+        if os.path.isfile(_idx_p):
+            try:
+                with open(_idx_p) as _fh:
+                    _wm = json.load(_fh)["weight_map"]
+                _allowed_by_file = {}
+                for _n, _f in _wm.items():
+                    _allowed_by_file.setdefault(_f, set()).add(_n)
+            except Exception:
+                _allowed_by_file = None
+
+    def _index_excludes(st_file: str, name: str) -> bool:
+        if _allowed_by_file is None:
+            return False
+        return name not in _allowed_by_file.get(os.path.basename(st_file), ())
+
     fs_type = _get_fs_type(sorted_files)
     is_net_fs = fs_type in ("nfs", "nfs4", "lustre")
