+    # This warmup runs independently on every rank (no cross-rank pairing),
+    # so the PP sampled-token broadcast must be skipped on both ends or the
+    # ranks deadlock in pp_broadcast (each side waits for a partner that is
+    # busy with its own local warmup).
+    _prev_local = getattr(model_runner, "_pp_local_warmup", False)
+    model_runner._pp_local_warmup = True
+    try:
+        return _run_mixed_prefill_decode_warmup_impl(
+            model_runner,
+            worker_execute_model,
+            worker_sample_tokens,
+            num_tokens,
+            mixed_step_context=mixed_step_context,
+            req_id_prefix=req_id_prefix,
+        )
+    finally:
+        # Restore (do not blindly clear): this runs nested inside
+        # compile_or_warm_up_model, which owns the outer flag.
+        model_runner._pp_local_warmup = _prev_local
+
+
