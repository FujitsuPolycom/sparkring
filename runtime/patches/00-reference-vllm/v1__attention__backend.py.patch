+# nvfp4_ds_mla per-token NoPE global scale (task #52 Phase-1 precision): the
+# b12x writer stores fp32 s_tok at record bytes [356, 360) and the b12x
+# readers fold it into the group-scale dequant. Same env the b12x package
+# gates its reader kernels on; per-token records and legacy records are
+# mutually unreadable, so the flag must be process-lifetime constant.
+# Mutually exclusive with VLLM_NVFP4_MLA_SCALES_FILE (enforced at MLA layer
+# init in model_executor/layers/mla.py).
+_NVFP4_MLA_PER_TOKEN_SCALE_ENV = "VLLM_NVFP4_MLA_PER_TOKEN_SCALE"
+
+
+def _nvfp4_per_token_scale_enabled() -> bool:
+    raw = os.environ.get(_NVFP4_MLA_PER_TOKEN_SCALE_ENV)
+    return raw is not None and raw.strip().lower() in {"1", "true", "on", "yes"}
 
 
