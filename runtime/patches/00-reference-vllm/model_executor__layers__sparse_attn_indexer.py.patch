+def _indexer_sp_group() -> tuple[int, int] | None:
+    """(tp_size, tp_rank) when prefill indexer sequence-sharding is enabled.
+
+    VLLM_DSV4_INDEXER_SP=1 shards the prefill indexer scoring+topk by QUERY
