+                "B12X decode prewarm: MLA decode plan warmed "
+                "(num_splits=%d, chunks_per_split=%d, rows=%d).",
+                num_splits,
+                chunks_per_split,
+                rows,
+            )
+        except Exception:
+            failed += 1
+            logger.warning(
+                "B12X decode prewarm: MLA decode plan failed "
+                "(num_splits=%d, chunks_per_split=%d, rows=%d).",
+                num_splits,
+                chunks_per_split,
+                rows,
+                exc_info=True,
+            )
