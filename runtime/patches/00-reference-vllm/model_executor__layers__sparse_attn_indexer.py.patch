+        layers = get_forward_context().no_compile_layers
+    except Exception:
+        return None
+    for layer in layers.values():
+        impl = getattr(layer, "impl", None)
+        if impl is None:
+            continue
+        if hasattr(impl, "_sparse_mla_decode_forward") and hasattr(
+            impl, "_decode_plan"
