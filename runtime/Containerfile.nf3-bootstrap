# syntax=docker/dockerfile:1
#
# Thin NF3 layer assembled by scripts/bootstrap_nf3.py.
#
# The expensive ARM64 vLLM/Torch/CUDA foundation and SparkRing native
# transport come from the locally attested faststart image.  This layer only
# installs the pinned B12X package, the pinned MadeBy561 Spark-port files, and
# the two public NF3 safety adapters.

ARG FASTSTART_IMAGE
FROM ${FASTSTART_IMAGE}

ARG B12X_COMMIT
ARG SPARK_PORT_COMMIT
ARG SPARKRING_SOURCE_COMMIT
ARG INPUT_RECEIPT_SHA256
ARG SITE_PACKAGES=/opt/venv/lib/python3.12/site-packages

USER root

RUN test "$(uname -m)" = "aarch64" \
    && test -n "${B12X_COMMIT}" \
    && test -n "${SPARK_PORT_COMMIT}" \
    && test -n "${SPARKRING_SOURCE_COMMIT}" \
    && test -n "${INPUT_RECEIPT_SHA256}"

# Replace the complete package so files from the community base cannot leak
# into the pinned NF3 contract.
RUN rm -rf "${SITE_PACKAGES}/b12x"
COPY b12x/ "${SITE_PACKAGES}/b12x/"

COPY overlay/hybrid_loader.py "${SITE_PACKAGES}/hybrid_loader.py"
COPY overlay/nf3_kernel.py "${SITE_PACKAGES}/nf3_kernel.py"
COPY overlay/nf3_replan.py "${SITE_PACKAGES}/nf3_replan.py"
COPY overlay/nvfp4_kernel.py "${SITE_PACKAGES}/nvfp4_kernel.py"
COPY overlay/mxfp8_tier.json "${SITE_PACKAGES}/mxfp8_tier.json"

# These files are copied explicitly even though the faststart overlay also
# carries sitecustomize.  Doing so makes this final image self-contained and
# prevents an older cached faststart layer from silently omitting an NF3 guard.
COPY sparkring/sitecustomize.py /opt/spark-vllm/sitecustomize.py
COPY sparkring/spark_nf3_startup_profile_cap.py \
     /opt/spark-vllm/spark_nf3_startup_profile_cap.py
COPY sparkring/spark_nf3_workspace_reserve.py \
     /opt/spark-vllm/spark_nf3_workspace_reserve.py

COPY verify-nf3-bootstrap.py /opt/sparkring/verify-nf3-bootstrap.py
COPY input-receipt.json /opt/sparkring/nf3-bootstrap-input-receipt.json

# Every worker must arm the hybrid loader before vLLM imports ModelOpt.
RUN printf '%s\n' 'import hybrid_loader' \
      > "${SITE_PACKAGES}/sparkring_nf3_hybrid.pth"

ENV HYBRID_KEPT=b12x_nf3 \
    HYBRID_NF3=b12x_nf3 \
    HYBRID_TIER=both \
    HYBRID_MXFP8_TIER_JSON=/opt/venv/lib/python3.12/site-packages/mxfp8_tier.json \
    CUTE_DSL_ARCH=sm_121a \
    SPARKRING_NF3_B12X_COMMIT=${B12X_COMMIT} \
    SPARKRING_NF3_SPARK_PORT_COMMIT=${SPARK_PORT_COMMIT} \
    SPARKRING_NF3_SOURCE_COMMIT=${SPARKRING_SOURCE_COMMIT} \
    SPARKRING_NF3_INPUT_RECEIPT_SHA256=${INPUT_RECEIPT_SHA256}

# Import-only, GPU-free ABI gate. A source mismatch fails the image build.
RUN /opt/venv/bin/python /opt/sparkring/verify-nf3-bootstrap.py \
      --receipt /opt/sparkring/nf3-bootstrap-input-receipt.json \
      --expected-receipt-sha256 "${INPUT_RECEIPT_SHA256}" \
      --expected-b12x-commit "${B12X_COMMIT}" \
      --expected-spark-port-commit "${SPARK_PORT_COMMIT}" \
      --expected-sparkring-commit "${SPARKRING_SOURCE_COMMIT}" \
      --output /opt/sparkring/nf3-bootstrap-verification.json

LABEL org.opencontainers.image.title="SparkRing GLM-5.2 NF3" \
      org.opencontainers.image.description="ARM64/SM121 SparkRing NF3 runtime" \
      org.opencontainers.image.revision.b12x="${B12X_COMMIT}" \
      org.opencontainers.image.revision.spark_port="${SPARK_PORT_COMMIT}" \
      org.sparkring.source_commit="${SPARKRING_SOURCE_COMMIT}" \
      org.sparkring.input_receipt_sha256="${INPUT_RECEIPT_SHA256}" \
      org.sparkring.model_repo="madeby561/GLM-5.2-MXFP8-NVFP4-NF3-Hybrid" \
      org.sparkring.model_revision="66f3623dd8fefb5ca8046706912d5d31c8d196af" \
      org.sparkring.model_config_sha256="254974797e9f455716a30ab5505ba68272181b20b58a3693e54f94fb8056f3ef" \
      org.sparkring.model_index_sha256="6eb773222d932418dd0530c63aca498f86ef424da2a4526ccba76b59726da234"
