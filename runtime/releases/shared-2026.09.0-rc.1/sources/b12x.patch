+            prefix[name] = inputs[name][:length]
+        prefix.update(
+            num_tokens=length,
+            cu_seqlens=torch.tensor([0, length], dtype=torch.int32, device=device),
+            checkpoint_slots=torch.tensor([0], dtype=torch.int32, device=device),
