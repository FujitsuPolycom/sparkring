# syntax=docker/dockerfile:1.7

ARG VLLM_BASE
ARG ARM_BUILDER

FROM ${ARM_BUILDER} AS b12x-wheel
ARG B12X_COMMIT
ARG B12X_TREE
COPY bundle/sources/b12x /build/b12x
RUN test "$(git -C /build/b12x rev-parse HEAD)" = "${B12X_COMMIT}" \
 && test "$(git -C /build/b12x rev-parse 'HEAD^{tree}')" = "${B12X_TREE}" \
 && /opt/python/cp312-cp312/bin/python -m pip wheel \
      --no-deps --wheel-dir /out/wheels /build/b12x

FROM ${ARM_BUILDER} AS nccl-build
ARG NCCL_COMMIT
ARG NCCL_PATCHED_TREE
ARG NCCL_CUDA_ARCH
ARG MAX_JOBS=8
COPY bundle/sources/nccl /build/nccl
RUN test "$(git -C /build/nccl rev-parse HEAD)" = "${NCCL_COMMIT}" \
 && test "$(git -C /build/nccl write-tree)" = "${NCCL_PATCHED_TREE}" \
 && make -C /build/nccl -j"${MAX_JOBS}" src.build \
      NVCC_GENCODE="-gencode=arch=compute_${NCCL_CUDA_ARCH},code=sm_${NCCL_CUDA_ARCH}" \
 && mkdir -p /out/nccl \
 && cp -a /build/nccl/build/lib/libnccl.so* /out/nccl/ \
 && sha256sum /out/nccl/libnccl.so.2.30.7 > /out/nccl/libnccl.so.2.30.7.sha256

FROM ${VLLM_BASE}
ARG VLLM_COMMIT
ARG B12X_COMMIT
ARG B12X_TREE
ARG B12X_KDA_CONTRACT
ARG NCCL_COMMIT
ARG NCCL_PATCHED_TREE
ARG NCCL_PATCH_SHA256
ARG SOURCE_RECEIPT_SHA256
ARG SPARKRING_REVISION

COPY --from=b12x-wheel /out/wheels/ /opt/sparkring/wheelhouse/
RUN uv pip install --system --no-deps /opt/sparkring/wheelhouse/b12x-*.whl \
 && python3 -c "import b12x, inspect; from vllm.utils.b12x import get_b12x_sparse_mla, get_b12x_dsa_indexer, get_b12x_gdn_decode, get_b12x_mhc; gdn = get_b12x_gdn_decode(); assert get_b12x_sparse_mla(); assert get_b12x_dsa_indexer(); assert gdn; assert get_b12x_mhc(); assert gdn.Caps.__dataclass_fields__['kda_metadata_validation'].default == 'transactional'; bind_source = inspect.getsource(gdn.bind_kda); run_source = inspect.getsource(gdn.run_kda); assert 'mixed_qkv.shape[0]' in bind_source; assert 'state_indices.shape[0]' in bind_source; assert 'caps.kda_metadata_validation == \"transactional\"' in run_source"

COPY --from=nccl-build /out/nccl/ /opt/sparkring/nccl/
RUN cd /opt/sparkring/nccl \
 && test -s libnccl.so.2.30.7 \
 && ln -sfn libnccl.so.2.30.7 libnccl.so.2 \
 && ln -sfn libnccl.so.2 libnccl.so

COPY bundle/runtime/pins.json /opt/sparkring/runtime/pins.json
COPY bundle/runtime/verify_image.py /opt/sparkring/runtime/verify_image.py
COPY receipt.json /opt/sparkring/runtime/source-receipt.json
COPY bundle/runtime/SparkRing-LICENSE /usr/share/licenses/SparkRing/LICENSE
COPY bundle/runtime/LICENSES.md /usr/share/licenses/SparkRing/THIRD-PARTY-BOUNDARY.md
COPY bundle/sources/vllm/LICENSE /usr/share/licenses/vLLM/LICENSE
COPY bundle/sources/b12x/LICENSE /usr/share/licenses/B12X/LICENSE
COPY bundle/sources/nccl/LICENSE.txt /usr/share/licenses/NCCL/LICENSE.txt
COPY bundle/sources/nccl/ThirdPartyNotices.txt /usr/share/licenses/NCCL/ThirdPartyNotices.txt

ENV VLLM_PLUGINS= \
    VLLM_B12X_MOE_FP4_FORCE_A16=0 \
    CUTE_DSL_ARCH=sm_121a \
    FLASHINFER_CUDA_ARCH_LIST=12.1f \
    TORCH_CUDA_ARCH_LIST=12.1a \
    CMAKE_CUDA_ARCHITECTURES=121 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    LD_PRELOAD=/opt/sparkring/nccl/libnccl.so.2 \
    VLLM_NCCL_SO_PATH=/opt/sparkring/nccl/libnccl.so.2
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/dist-packages/nvidia/cu13/lib:${LD_LIBRARY_PATH}

# SparkRing supplies the `serve` subcommand and model path. The upstream image
# entrypoint already includes `serve`; override it so the launcher does not
# produce `vllm serve serve <model>`.
ENTRYPOINT ["vllm"]

LABEL org.opencontainers.image.title="SparkRing GLM-5.3 Flash ARM64 runtime" \
      org.opencontainers.image.description="Source-pinned GLM-5.3 Flash runtime for four DGX Spark systems" \
      org.opencontainers.image.source="https://github.com/FujitsuPolycom/sparkring" \
      org.opencontainers.image.revision="${SPARKRING_REVISION}" \
      org.opencontainers.image.licenses="LicenseRef-NVIDIA-Deep-Learning-Container AND Apache-2.0 AND BSD-3-Clause" \
      org.jovian.architecture="linux-arm64-sm121" \
      org.jovian.vllm.commit="${VLLM_COMMIT}" \
      org.jovian.b12x.commit="${B12X_COMMIT}" \
      org.jovian.b12x.tree="${B12X_TREE}" \
      org.jovian.b12x.kda-contract="${B12X_KDA_CONTRACT}" \
      org.jovian.transport="sparkring-nccl-2.30.7-source-built" \
      org.sparkring.nccl.commit="${NCCL_COMMIT}" \
      org.sparkring.nccl.patched-tree="${NCCL_PATCHED_TREE}" \
      org.sparkring.nccl.patch-sha256="${NCCL_PATCH_SHA256}" \
      org.sparkring.source-receipt-sha256="${SOURCE_RECEIPT_SHA256}"
