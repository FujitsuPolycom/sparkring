# Per-rank SIRCL environment for launch-ring.sh (docker --env-file syntax:
# NAME=value, no quotes, no shell expansion). Copy once per rank outside Git
# and replace every REPLACE_ value. Peer, device and GID assignments follow
# the managed-mesh fabric plan of the GLM-5.3 mesh profile
# (runtime/glm53-flash-jj-r8-gb10/sircl-fused.env.example documents the slot
# rules: slot 0 reaches rank XOR 1, slot 1 reaches rank XOR 3; odd ranks swap
# DEVICE0/DEVICE1). The rendered rank<N>.env of that profile carries the same
# assignments and may be copied instead.
SIRCL_ENABLED=1
# Bundle attestation values printed by the image's SIRCL manifest
# (/opt/sparkring/sircl/python/sparkring-overlay-manifest.json).
SPARKRING_SIRCL_MANIFEST_SHA256=c0fd5567442b08b908cc193f36d0864e262573c7e5d232509479a823cface742
SPARKRING_SIRCL_NATIVE_SHA256=bea00f2ba6051c2c0bcd2853aae894672aa7f1fe5a1d905edaa9120aabf74246
SPARK_TP4_LIBRARY=/opt/sparkring/sircl/libspark_transport_capi.so
VLLM_SPARK_TP4_MODE=custom
VLLM_SPARK_TP4_VOCAB_MODE=custom
SPARK_TP4_CAPABILITY_VOTE=1
SPARK_TP4_HEALTH_GATE=1
SPARK_TP4_FLIGHT_RECORDER=0
# Graph-only session on the primary rail pair (width-4096 decode collectives).
SPARK_TP4_PEER0=REPLACE_WITH_PRIMARY_PEER_0_FABRIC_ADDRESS
SPARK_TP4_PEER1=REPLACE_WITH_PRIMARY_PEER_1_FABRIC_ADDRESS
SPARK_TP4_DEVICE0=REPLACE_WITH_PRIMARY_DEVICE_0
SPARK_TP4_DEVICE1=REPLACE_WITH_PRIMARY_DEVICE_1
SPARK_TP4_GID0=3
SPARK_TP4_GID1=3
SPARK_TP4_CONTROL_PORT0=9970
SPARK_TP4_CONTROL_PORT1=9971
SPARK_TP4_GRAPH_CONTROL_PORT0=9970
SPARK_TP4_GRAPH_CONTROL_PORT1=9971
SPARK_TP4_CONTROL_CONNECT_TIMEOUT_SECONDS=10
SPARK_TP4_GRAPH_SUBMIT_CPU=10
SPARK_TP4_GRAPH_PROGRESS_CPU=11
SPARK_TP4_GRAPH_DIRECT_DOORBELL=1
SPARK_TP4_MAX_INFLIGHT=64
SPARK_TP4_GRAPH_STATUS_PATH=/cache/jit/sircl-graph-rankREPLACE_WITH_RANK.json
VLLM_SPARK_SHARED_CAPTURE_STREAM=1
VLLM_SPARK_TP4_GRAPH_WIDTH4096_RESEARCH=1
VLLM_SPARK_TP4_GRAPH_Q1=0
VLLM_SPARK_TP4_GRAPH_DUAL_PORT_Q40=0
# Fused bidirectional prefill session on both rail pairs ([Q <= 8192, 4096]).
VLLM_SPARK_TP4_BIDIRECTIONAL_PREFILL=1
VLLM_SPARK_TP4_BIDIRECTIONAL_PREFILL_RAIL_MODE=dual
VLLM_SPARK_TP4_BIDIRECTIONAL_PREFILL_EXPOSURE=fused
SPARK_TP4_BIDIRECTIONAL_PREFILL_CONTROL_PORT0=19000
SPARK_TP4_BIDIRECTIONAL_PREFILL_CONTROL_PORT1=19001
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_PEER0=REPLACE_WITH_SECONDARY_PEER_0_FABRIC_ADDRESS
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_PEER1=REPLACE_WITH_SECONDARY_PEER_1_FABRIC_ADDRESS
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_DEVICE0=REPLACE_WITH_SECONDARY_DEVICE_0
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_DEVICE1=REPLACE_WITH_SECONDARY_DEVICE_1
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_GID0=3
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_GID1=3
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_CONTROL_PORT0=19100
SPARK_TP4_BIDIRECTIONAL_PREFILL_SECONDARY_CONTROL_PORT1=19101
SPARK_TP4_BIDIRECTIONAL_PREFILL_TIMEOUT_SECONDS=120
