# Rank-local environment for launch-pair.sh (MiMo-V2.6-Flash-RL, two Sparks).
# Copy this file once per rank outside Git, replace every REPLACE_ value and
# pass the copy as the launcher's only argument. Sourced by bash: keep one
# assignment per line and quote values that contain spaces.

# 0 serves the API; 1 is the follower. Start rank 1 first.
RANK=REPLACE_WITH_0_OR_1
# This rank's management address (torch rendezvous and NCCL/Gloo bootstrap)
# and the management interface that carries it.
HOST_IP=REPLACE_WITH_THIS_RANK_MANAGEMENT_ADDRESS
MGMT_IFNAME=REPLACE_WITH_MANAGEMENT_INTERFACE
# Rank 0's management address, identical on both ranks.
MASTER_ADDR=REPLACE_WITH_RANK_0_MANAGEMENT_ADDRESS
# One RoCE device per PCIe domain on the direct cable, comma separated; the
# RoCEnante one-shot all-reduce uses both Socket Direct functions.
ROCE_HCA_PAIR=rocep1s0f0,roceP2p1s0f0
# Verified checkpoint directory (config.json, dflash/, model shards) and a
# separate writable compile-cache directory for this rank.
MODEL_DIR=REPLACE_WITH_ABSOLUTE_MODEL_DIRECTORY
CACHE_DIR=REPLACE_WITH_ABSOLUTE_CACHE_DIRECTORY
# Build with build-image.sh; use the same resulting image ID on every rank.
IMAGE=sparkring:mimo-b12x-6afb999-4f3028

# Optional overrides (defaults are the recipe's values):
# PORT=8000 MASTER_PORT=29639 SERVED_MODEL_NAME=mimo-v2.6-flash
# MAX_MODEL_LEN=262144 MAX_NUM_SEQS=16 MAX_BATCHED=8192
# KV_BYTES=12884901888 GPU_MEM=0.88 SPEC_TOKENS=5 CG_CAP=64 ROCE_AR=1
# MM=1|image|0  EXTRA_ENV=NAME=value,NAME2=value
