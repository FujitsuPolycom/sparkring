# Rank-local environment for launch-ring.sh (MiMo-V2.6-Flash-RL, four-Spark
# cycle with SIRCL over the managed mesh). Copy this file once per rank
# outside Git, replace every REPLACE_ value and pass the copy as the
# launcher's only argument. Sourced by bash: one assignment per line.

# 0 serves the API; 1, 2 and 3 are followers. Start 3, 2, 1, then 0.
RANK=REPLACE_WITH_0_TO_3
# This rank's management address (torch rendezvous and NCCL/Gloo bootstrap)
# and the management interface that carries it.
HOST_IP=REPLACE_WITH_THIS_RANK_MANAGEMENT_ADDRESS
MGMT_IFNAME=REPLACE_WITH_MANAGEMENT_INTERFACE
# Rank 0's management address, identical on every rank.
MASTER_ADDR=REPLACE_WITH_RANK_0_MANAGEMENT_ADDRESS
# The four RoCE device functions (both ports, both PCIe domains) with port
# numbers, in NCCL_IB_HCA syntax without the leading "=".
NCCL_IB_HCA_LIST=rocep1s0f0:1,rocep1s0f1:1,roceP2p1s0f0:1,roceP2p1s0f1:1
NCCL_IB_GID_INDEX=3
# Verified checkpoint directory and a separate writable compile-cache
# directory for this rank.
MODEL_DIR=REPLACE_WITH_ABSOLUTE_MODEL_DIRECTORY
CACHE_DIR=REPLACE_WITH_ABSOLUTE_CACHE_DIRECTORY
# Build with build-image.sh; use the same resulting image ID on every rank.
IMAGE=sparkring:mimo-b12x-6afb999-4f3028
# The rank's SIRCL environment file: a filled copy of sircl-rank.env.example.
SIRCL_ENV_FILE=REPLACE_WITH_ABSOLUTE_PATH_TO_THIS_RANK_SIRCL_ENV

# Optional overrides (defaults are the recipe's values):
# PORT=8020 MASTER_PORT=29776 SERVED_MODEL_NAME=mimo-v2.6-flash
# MAX_MODEL_LEN=262144 MAX_NUM_SEQS=16 MAX_BATCHED=8192
# KV_BYTES=21474836480 GPU_MEM=0.80 SPEC_TOKENS=5 CG_CAP=64
# SIRCL=1|0  MM=1|image|0  LINEAR_BACKEND=auto
# EXTRA_ENV=NAME=value,NAME2=value
