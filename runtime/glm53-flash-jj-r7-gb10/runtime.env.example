#!/usr/bin/env bash
# Copy this file to a rank-local path and replace the five required site
# values. Byte counts are per rank. Defaults reproduce the smoke-verified
# configuration; a changed serving setting is labeled unqualified.

# Required site values. HOST_IP differs per rank; MASTER_ADDR is rank 0.
HOST_IP='REPLACE_WITH_THIS_RANK_ADDRESS'
MASTER_ADDR='REPLACE_WITH_RANK0_ADDRESS'
TARGET_MODEL_HOST_PATH='/REPLACE/TARGET_MODEL_HOST_PATH'
DFLASH_MODEL_HOST_PATH='/REPLACE/DFLASH_MODEL_HOST_PATH'
CACHE_HOST_ROOT='/REPLACE/DEDICATED_RANK_LOCAL_CACHE_ROOT'

# Select exactly one published image.
IMAGE_VARIANT='base'
BASE_IMAGE_REF='ghcr.io/fujitsupolycom/sparkring-glm53-runtime@sha256:11922064b342de1fc98f0ef85e6648843c8fa7eb3e4f4353c6ad82d6e457dde0'
SPARKCACHE_IMAGE_REF='ghcr.io/fujitsupolycom/sparkring-glm53-sparkcache@sha256:f012dd915c0fff0be384820c2d72cd015b83b9b33c3f980445dd718a807cd0c5'
SPARKCACHE_DCP_IMAGE_REF=''
SPARKCACHE_DCP_IMAGE_ID=''
CONTAINER_PREFIX='glm53-jj-r7-gb10'
SERVED_MODEL_NAME='glm-5.3-flash-nvfp4-dflash2-bf16-t7-jj-r7-gb10'
PORT=8015
MASTER_PORT=29775
SHM_SIZE='32g'

# Distributed topology.
TENSOR_PARALLEL_SIZE=4
PIPELINE_PARALLEL_SIZE=1
DECODE_CONTEXT_PARALLEL_SIZE=1
# GLM-5.3 uses four-token KV interleaving for DCP2 and DCP4. `auto`
# selects 1 for DCP1 and 4 for DCP2/DCP4.
CP_KV_CACHE_INTERLEAVE_SIZE='auto'
# `auto` disables full-CKV prefill gather for DCP1 and enables it for
# DCP2/DCP4. Set 0 or 1 only when isolating the gather path.
B12X_MLA_CKV_GATHER='auto'
B12X_MLA_CKV_GATHER_MAX_TOKENS=524288
NODE_COUNT=4

# Request scheduling and device-memory allocation.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
PREFILL_SCHEDULE_INTERVAL=8
KV_CACHE_MEMORY_BYTES=32212254720
GPU_MEMORY_UTILIZATION=0.80
KV_CACHE_DTYPE='fp8'

# BF16 external DFlash speculation.
SPECULATION_METHOD='dflash'
NUM_SPECULATIVE_TOKENS=7
DRAFT_TENSOR_PARALLEL_SIZE=4
DRAFT_KV_CACHE_DTYPE='auto'
DRAFT_SAMPLE_METHOD='probabilistic'
REJECTION_SAMPLE_METHOD='standard'

# Model kernels and compilation.
ATTENTION_BACKEND='B12X'
MOE_BACKEND='b12x'
LINEAR_BACKEND='b12x'
KDA_PREFILL_BACKEND='flashkda'
LOAD_FORMAT='fastsafetensors'
CUDAGRAPH_MODE='FULL_AND_PIECEWISE'
MAX_CUDAGRAPH_CAPTURE_SIZE=128

# Distinct JIT/persistent namespaces prevent either image from reading the
# other variant's generated artifacts.
BASE_CACHE_NAMESPACE='jj-r7-gb10-base-v1'
SPARKCACHE_CACHE_NAMESPACE='jj-r7-gb10-page-tail-cow-v1'
SPARKCACHE_DCP_CACHE_NAMESPACE='jj-r8-gb10-manager-pages-v2'
SPARKCACHE_PUBLICATION_SCHEMA='snapshot-v1'
SPARKCACHE_CLEAR_ONCE='auto'
SPARKCACHE_MAX_BYTES=42949672960
SPARKCACHE_LOW_WATERMARK_BYTES=34359738368
SPARKCACHE_TTL_SECONDS=0
SPARKCACHE_MIN_SPAN_TOKENS=4096
SPARKCACHE_MAX_SPAN_TOKENS=1048576
SPARKCACHE_LOAD_THREADS=8
SPARKCACHE_MAX_PENDING_RESTORES=8
SPARKCACHE_CUDA_RESTORE_IO_WORKERS=8
SPARKCACHE_CUDA_ARENA_BYTES=268435456

# Rank-to-rank transport.
SOCKET_IFNAME='enP7s7'
NCCL_IB_HCA='rocep1s0f0,rocep1s0f1'
NCCL_IB_GID_INDEX=3
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4

# Host CPU and loader concurrency.
OMP_NUM_THREADS=16
TORCHINDUCTOR_COMPILE_THREADS=1
FASTSAFETENSORS_QUEUE_SIZE=1
