# syntax=docker/dockerfile:1
#
# Thin compatibility layer for the optional NVFP4-latent / FP8-RoPE KV
# profile. The validated NF3 image remains the expert-kernel source of truth;
# only the packed MLA reader is restored from the attested faststart image.

ARG NF3_IMAGE
ARG MLA_IMAGE

FROM ${MLA_IMAGE} AS mla_source
FROM ${NF3_IMAGE}

ARG SITE_PACKAGES=/opt/venv/lib/python3.12/site-packages
ARG NF3_IMAGE_ID
ARG MLA_IMAGE_ID
ARG SPARKRING_SOURCE_COMMIT

USER root

RUN test -n "${NF3_IMAGE_ID}" \
    && test -n "${MLA_IMAGE_ID}" \
    && test -n "${SPARKRING_SOURCE_COMMIT}"

RUN rm -rf "${SITE_PACKAGES}/b12x/attention/mla"
COPY --from=mla_source \
  /opt/venv/lib/python3.12/site-packages/b12x/attention/mla/ \
  "${SITE_PACKAGES}/b12x/attention/mla/"
COPY --from=mla_source \
  /opt/venv/lib/python3.12/site-packages/b12x/integration/mla.py \
  "${SITE_PACKAGES}/b12x/integration/mla.py"
COPY --from=mla_source \
  /opt/venv/lib/python3.12/site-packages/b12x/integration/sparse_mla_scratch.py \
  "${SITE_PACKAGES}/b12x/integration/sparse_mla_scratch.py"
COPY --from=mla_source \
  /opt/venv/lib/python3.12/site-packages/b12x/cute/fp4.py \
  "${SITE_PACKAGES}/b12x/cute/fp4.py"

COPY verify-nf3-nvfp4-rope8.py \
  /opt/sparkring/verify-nf3-nvfp4-rope8.py

RUN /opt/venv/bin/python /opt/sparkring/verify-nf3-nvfp4-rope8.py \
      --output /opt/sparkring/nf3-nvfp4-rope8-verification.json

ENV SPARKRING_KV_PROFILE=nvfp4-rope8

LABEL org.opencontainers.image.title="SparkRing GLM-5.2 NF3 + NVFP4 MLA" \
      org.opencontainers.image.description="NF3 experts with NVFP4 latent and FP8 RoPE KV storage" \
      org.sparkring.kv_profile="nvfp4-rope8" \
      org.sparkring.parent.nf3_image_id="${NF3_IMAGE_ID}" \
      org.sparkring.parent.mla_image_id="${MLA_IMAGE_ID}" \
      org.sparkring.source_commit="${SPARKRING_SOURCE_COMMIT}"
