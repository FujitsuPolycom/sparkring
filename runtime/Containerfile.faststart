# syntax=docker/dockerfile:1
#
# Fast public trial image for DGX Spark.
#
# This deliberately reuses the exact public ARM64 community image used by the
# reference deployment. It does NOT rebuild vLLM, Torch, FlashInfer,
# SparkInfer, or DeepGEMM. It still builds SparkRing's patched NCCL and native
# transport from public source and applies every Python change fail-closed.
#
# Build only through runtime/build-faststart.sh so the immutable pins are
# validated before Docker is invoked.

ARG BASE_IMAGE
ARG BASE_DEVEL_IMAGE

# ---------------------------------------------------------------------------
# Stage 1: prove the public base matches the recovered patch preimages, then
# install the recovered vLLM delta and the SparkRing PYTHONPATH overlay.
# This runs before native compilation so an incompatible base fails quickly.
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS overlay-base
USER root

RUN test "$(uname -m)" = "aarch64" \
    && test -x /opt/venv/bin/python \
    && test -x /opt/venv/bin/vllm \
    && if ! command -v git >/dev/null 2>&1; then \
         apt-get update \
         && apt-get install -y --no-install-recommends git \
         && rm -rf /var/lib/apt/lists/*; \
       fi

COPY runtime/patches /build/patches
COPY runtime/patches-faststart /build/patches-faststart
COPY runtime/apply-patches.py /build/apply-patches.py
RUN install -d -m 0755 /var/log/sparkring \
    && /opt/venv/bin/python /build/apply-patches.py \
         --patches-root /build/patches \
         --site-packages "$(/opt/venv/bin/python -c \
           'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
         --log /var/log/sparkring/patch-apply.jsonl \
         --compatible-base \
         --supplemental-root /build/patches-faststart \
         --fail-closed

COPY spark_transport /build/spark_transport
COPY runtime/public-overlay-files.json /build/public-overlay-files.json
COPY runtime/build-public-overlay.py /build/build-public-overlay.py
RUN /opt/venv/bin/python /build/build-public-overlay.py \
        --repo /build \
        --spec /build/public-overlay-files.json \
        --output /opt/spark-vllm \
    && install -d -m 0755 /opt/sparkring \
    && touch /opt/sparkring/.faststart-overlay-passed

# ---------------------------------------------------------------------------
# Stage 2: build patched NCCL 2.30.7 and SparkRing's native transport for GB10.
# ---------------------------------------------------------------------------
FROM ${BASE_DEVEL_IMAGE} AS native-build
ARG CUDA_ARCH=121
ARG NCCL_REPO
ARG NCCL_COMMIT
ARG MAX_JOBS=8

RUN test -n "${NCCL_REPO}" \
    && test -n "${NCCL_COMMIT}" \
    && test "$(uname -m)" = "aarch64"

RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential cmake ninja-build libibverbs-dev python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
# Force BuildKit to complete the fail-closed Python preimage gate before it
# spends time compiling native code.
COPY --from=overlay-base /opt/sparkring/.faststart-overlay-passed \
     /build/.faststart-overlay-passed
RUN git clone "${NCCL_REPO}" nccl \
    && cd nccl \
    && git checkout "${NCCL_COMMIT}" \
    && test "$(git rev-parse HEAD)" = "${NCCL_COMMIT}"

COPY spark_transport/experiments/nccl_switchless_ring/nccl-2.30.7-skip-tree-pat.patch \
     spark_transport/experiments/nccl_switchless_ring/nccl-2.30.7-advertise-all-listener-gids.patch \
     /build/nccl-patches/
RUN cd /build/nccl \
    && for patch in /build/nccl-patches/*.patch; do \
         git apply --check "${patch}" \
         || { echo "FATAL: NCCL patch preimage mismatch: ${patch}" >&2; exit 1; }; \
         git apply "${patch}"; \
       done \
    && make -j"${MAX_JOBS}" src.build \
         NVCC_GENCODE="-gencode=arch=compute_${CUDA_ARCH},code=sm_${CUDA_ARCH}" \
    && install -d -m 0755 /out/nccl \
    && cp -a build/lib/libnccl.so* /out/nccl/

COPY spark_transport /build/spark_transport
RUN cmake -S /build/spark_transport -B /build/spark_transport-build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCH}" \
        -DBUILD_TESTING=OFF \
    && cmake --build /build/spark_transport-build --parallel "${MAX_JOBS}" \
    && install -d -m 0755 /out/spark_transport \
    && find /build/spark_transport-build -maxdepth 1 \
         \( -name 'libspark_transport_capi*.so' \
            -o -name 'spark_tp4_*probe*' \
            -o -name 'spark_transport_probe' \) \
         -exec cp -a {} /out/spark_transport/ \; \
    && test -f /out/spark_transport/libspark_transport_capi.so

# ---------------------------------------------------------------------------
# Stage 3: assemble the exact thin layer and freeze its installed hashes.
# ---------------------------------------------------------------------------
FROM overlay-base AS runtime
ARG RUNTIME_ID
ARG SPARKRING_GIT_COMMIT
ARG MODEL_REPO_ID
ARG MODEL_REVISION
ARG MODEL_CONFIG_SHA256

RUN test -n "${RUNTIME_ID}" \
    && test -n "${SPARKRING_GIT_COMMIT}" \
    && test -n "${MODEL_REPO_ID}" \
    && test -n "${MODEL_REVISION}" \
    && test -n "${MODEL_CONFIG_SHA256}"

COPY --from=native-build /out/nccl /opt/sparkring/nccl
COPY --from=native-build /out/spark_transport /opt/sparkring/spark_transport

COPY runtime/generate-manifest.py /opt/sparkring/generate-manifest.py
COPY runtime/verify-runtime.py /opt/sparkring/verify-runtime.py
COPY runtime/public-capability-gate.py /opt/sparkring/public-capability-gate.py
COPY runtime/public-headless-abi-gate.py /opt/sparkring/public-headless-abi-gate.py
COPY runtime/public-model-preflight.py /opt/sparkring/public-model-preflight.py
COPY runtime/public-entrypoint.sh /opt/sparkring/public-entrypoint.sh
COPY runtime/faststart-lock.json /opt/sparkring/faststart-lock.json

RUN set -eu; \
    site_packages="$(/opt/venv/bin/python -c \
      'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    args="--lock /opt/sparkring/faststart-lock.json --runtime-id ${RUNTIME_ID}"; \
    args="${args} --tree public-overlay=/opt/spark-vllm --with-packages"; \
    args="${args} --patch-log /var/log/sparkring/patch-apply.jsonl"; \
    args="${args} --patch-root ${site_packages}"; \
    for file in /opt/sparkring/nccl/libnccl.so.* \
                /opt/sparkring/spark_transport/*; do \
      [ -f "${file}" ] && args="${args} --native-lib ${file}"; \
    done; \
    /opt/venv/bin/python /opt/sparkring/generate-manifest.py ${args} \
      --image-digest external \
      --output /opt/sparkring/runtime-manifest.json; \
    chmod 0555 /opt/sparkring/public-entrypoint.sh; \
    chmod 0444 /opt/sparkring/runtime-manifest.json

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/opt/spark-vllm \
    LD_PRELOAD=/opt/sparkring/nccl/libnccl.so.2 \
    SPARKRING_RUNTIME_ID=${RUNTIME_ID} \
    SPARKRING_MODEL_REPOSITORY=${MODEL_REPO_ID} \
    SPARKRING_MODEL_REVISION=${MODEL_REVISION} \
    SPARKRING_MODEL_CONFIG_SHA256=${MODEL_CONFIG_SHA256}

LABEL org.sparkring.lane="faststart" \
      org.sparkring.source_commit="${SPARKRING_GIT_COMMIT}" \
      org.sparkring.runtime_id="${RUNTIME_ID}" \
      org.sparkring.model_repo="${MODEL_REPO_ID}" \
      org.sparkring.model_revision="${MODEL_REVISION}"

ENTRYPOINT ["/opt/sparkring/public-entrypoint.sh"]
