#!/usr/bin/env bash
# Copy this file to a rank-local path, replace the five required site values,
# and pass the copy as the launcher's second argument. All byte counts are per
# rank. Values below reproduce the recorded configuration unless noted.

# Required site values. HOST_IP differs on every rank. MASTER_ADDR is rank 0.
HOST_IP='REPLACE_WITH_THIS_RANK_ADDRESS'
MASTER_ADDR='REPLACE_WITH_RANK0_ADDRESS'
TARGET_MODEL_HOST_PATH='/REPLACE/TARGET_MODEL_HOST_PATH'
DFLASH_MODEL_HOST_PATH='/REPLACE/DFLASH_MODEL_HOST_PATH'
CACHE_HOST_ROOT='/REPLACE/DEDICATED_RANK_LOCAL_CACHE_ROOT'

# Image, container, API, and distributed topology.
IMAGE_REF='sparkring-glm53-sparkcache:pr535-6da4865-sc59ac0b0-c8-exact-arm64'
CONTAINER_PREFIX='glm53-pr535-sc59ac-c8-01'
SERVED_MODEL_NAME='glm-5.3-flash-pr535-sc78-tp4'
PORT=8015
MASTER_PORT=29775
SHM_SIZE='32g'
TENSOR_PARALLEL_SIZE=4
PIPELINE_PARALLEL_SIZE=1
DECODE_CONTEXT_PARALLEL_SIZE=1
NODE_COUNT=4

# Request scheduling and device-memory allocation.
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=4096
KV_CACHE_MEMORY_BYTES=21474836480
GPU_MEMORY_UTILIZATION=0.80
KV_CACHE_DTYPE='fp8'

# Draft-model speculation. The recorded artifact uses BF16 DFlash with seven
# draft tokens. DRAFT_KV_CACHE_DTYPE=auto preserves the draft model's dtype.
SPECULATION_METHOD='dflash'
NUM_SPECULATIVE_TOKENS=7
DRAFT_TENSOR_PARALLEL_SIZE=4
DRAFT_KV_CACHE_DTYPE='auto'
DRAFT_SAMPLE_METHOD='probabilistic'
REJECTION_SAMPLE_METHOD='standard'

# Model kernels and compilation.
ATTENTION_BACKEND='B12X'
MOE_BACKEND='b12x'
LINEAR_BACKEND='b12x'
KDA_PREFILL_BACKEND='flashkda'
CUDAGRAPH_MODE='FULL_AND_PIECEWISE'
MAX_CUDAGRAPH_CAPTURE_SIZE=128

# Persistent-cache identity, retention, and bounded restore resources.
# Changing CACHE_NAMESPACE intentionally starts a logically separate cache.
CACHE_NAMESPACE='pr535-sc78-tp4-01'
SPARKCACHE_MAX_BYTES=42949672960
SPARKCACHE_LOW_WATERMARK_BYTES=34359738368
SPARKCACHE_TTL_SECONDS=0
SPARKCACHE_MIN_SPAN_TOKENS=4096
SPARKCACHE_MAX_SPAN_TOKENS=262144
SPARKCACHE_LOAD_THREADS=8
SPARKCACHE_MAX_PENDING_RESTORES=8
SPARKCACHE_CUDA_RESTORE_IO_WORKERS=8
SPARKCACHE_CUDA_ARENA_BYTES=268435456

# Rank-to-rank transport. Set SOCKET_IFNAME to the routable management/data
# interface used by both Gloo and NCCL. NCCL_IB_HCA may name multiple HCAs.
SOCKET_IFNAME='enP7s7'
NCCL_IB_HCA='rocep1s0f0,rocep1s0f1'
NCCL_IB_GID_INDEX=3
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4

# Host CPU and loader concurrency. These values are per rank.
OMP_NUM_THREADS=16
TORCHINDUCTOR_COMPILE_THREADS=1
FASTSAFETENSORS_QUEUE_SIZE=1
