ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root

ARG PROFILE_ID=glm52-exl3-tr3-3.25bpw
ARG BASE_IMAGE_ID
ARG CONTEXT_MANIFEST_SHA256
ARG SPARKINFER_COMMIT
ARG EXLLAMAV3_COMMIT
ARG VLLM_PORT_COMMIT

LABEL org.sparkring.exl3-profile="${PROFILE_ID}" \
      org.sparkring.parent.image-id="${BASE_IMAGE_ID}" \
      org.sparkring.exl3.context-manifest-sha256="${CONTEXT_MANIFEST_SHA256}" \
      org.sparkring.sparkinfer-commit="${SPARKINFER_COMMIT}" \
      org.sparkring.exllamav3-commit="${EXLLAMAV3_COMMIT}" \
      org.sparkring.vllm-port-commit="${VLLM_PORT_COMMIT}"

ENV CUDA_HOME=/usr/local/cuda \
    CUDACXX=/usr/local/cuda/bin/nvcc \
    CUTE_DSL_ARCH=sm_121a \
    TORCH_CUDA_ARCH_LIST=12.1a \
    MAX_JOBS=1

RUN /opt/venv/bin/python -m pip install --no-cache-dir --upgrade \
      "nvidia-cutlass-dsl==4.6.0" \
      "nvidia-cutlass-dsl-libs-base==4.6.0" \
      "nvidia-cutlass-dsl-libs-core==4.6.0" \
      "nvidia-cutlass-dsl-libs-cu12==4.6.0" \
      "nvidia-cutlass-dsl-libs-cu13==4.6.0"

COPY sources/sparkinfer/ /opt/sparkring-exl3/sources/sparkinfer/
RUN /opt/venv/bin/python -m pip install --no-cache-dir --no-deps \
      --no-build-isolation /opt/sparkring-exl3/sources/sparkinfer

COPY sources/exllamav3/ /opt/sparkring-exl3/sources/exllamav3/
RUN /opt/venv/bin/python -m pip install --no-cache-dir --no-deps \
      --no-build-isolation /opt/sparkring-exl3/sources/exllamav3

COPY overlay/vllm/ /opt/venv/lib/python3.12/site-packages/vllm/
COPY patch_sparse_profile_capacity.py /opt/sparkring-exl3/
RUN /opt/venv/bin/python \
      /opt/sparkring-exl3/patch_sparse_profile_capacity.py

COPY runtime-overlay/ /opt/spark-vllm/

COPY pins.json context-manifest.json verify_exl3_runtime.py \
     compose_runtime_manifest.py entrypoint.sh \
     /opt/sparkring-exl3/

RUN chmod 0755 /opt/sparkring-exl3/entrypoint.sh
RUN /opt/venv/bin/python /opt/sparkring-exl3/compose_runtime_manifest.py
RUN /opt/venv/bin/python /opt/sparkring-exl3/verify_exl3_runtime.py \
      --phase build

ENV VLLM_EXL3_EXT_PATH=/opt/venv/lib/python3.12/site-packages

ENTRYPOINT ["/opt/sparkring-exl3/entrypoint.sh"]
