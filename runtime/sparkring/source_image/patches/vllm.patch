+
+    def should_all_to_all(self, inp):
+        self.check_health()
+        try:
+            self._validate_input(inp)
+        except (TypeError, ValueError):
+            return False
+        return True
+
+    def _validate_input(self, inp):
+        if not isinstance(inp, torch.Tensor):
+            raise TypeError("owner input must be a torch.Tensor")
+        if inp.layout != torch.strided or not inp.is_cuda or inp.device != self.device:
+            raise ValueError("owner input must be a dense CUDA tensor on the runtime device")
+        if not inp.is_contiguous():
+            raise ValueError("owner input must be contiguous")
+        if inp.is_quantized or inp.is_conj() or inp.is_neg():
+            raise ValueError("owner input must expose physical, unmodified tensor bytes")
+        peer_bytes = validate_input_layout(inp.shape, inp.element_size(), self.max_input_bytes)
+        if inp.data_ptr() % PACK_BYTES:
+            raise ValueError("owner input pointer must be 16-byte aligned")
+        return peer_bytes
+
+    def all_to_all(self, inp, out=None, *, stream=None):
+        """Receive each source's quarter for this rank, in source-rank order.
+
+        All ranks must submit matching shape/dtype and collective order.
+        Input/output are equal-shaped, contiguous, aligned and nonoverlapping.
+        Work is asynchronous on the selected stream. Synchronize then call
+        check_health() before consuming externally observed results.
+        """
+        with self._lock:
+            self.check_health()
+            peer_bytes = self._validate_input(inp)
+            nbytes = peer_bytes * self.world_size
+            if out is not None:
+                if not isinstance(out, torch.Tensor):
+                    raise TypeError("owner out must be a torch.Tensor")
+                if (
+                    out.shape != inp.shape or out.dtype != inp.dtype
+                    or out.device != inp.device or out.layout != torch.strided
+                    or not out.is_contiguous() or out.is_conj() or out.is_neg()
+                    or out.is_quantized
+                ):
+                    raise ValueError("owner out must match input shape, dtype, device and contiguous layout")
+                if out.data_ptr() % PACK_BYTES:
+                    raise ValueError("owner out pointer must be 16-byte aligned")
+                if inp.data_ptr() < out.data_ptr() + nbytes and out.data_ptr() < inp.data_ptr() + nbytes:
