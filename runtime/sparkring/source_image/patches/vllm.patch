+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU admission, page-byte, and collective-ownership contracts."""
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import torch
+
+from vllm.config import CUDAGraphMode
+from vllm.v1.attention.backends.mla import compact_index_owner as owner
+
+
+def metadata(context=32768, **changes):
+    fields = dict(
+        num_reqs=1,
+        num_prefills=1,
+        num_decodes=0,
+        num_decode_tokens=0,
+        num_actual_tokens=8192,
+        is_spec_decode=False,
+        prefill_query_lens_cpu=torch.tensor([8192], dtype=torch.int32),
+        prefill_seq_lens_cpu=torch.tensor([context], dtype=torch.int32),
+    )
+    fields.update(changes)
+    return SimpleNamespace(**fields)
+
+
+class Context:
+    cudagraph_runtime_mode = CUDAGraphMode.NONE
+    is_dummy_run = False
+    ubatch_slices = None
+
+
+@pytest.fixture(autouse=True)
+def isolated_tensor_vote(monkeypatch):
+    monkeypatch.setattr(owner, "_tensor_vote", None)
+    monkeypatch.setattr(owner, "_local_widths_enabled", False)
+    monkeypatch.setattr(owner.envs, "VLLM_DCP_COMPACT_INDEX_TENSOR_VOTE", False)
+    monkeypatch.setattr(owner.envs, "VLLM_DCP_COMPACT_INDEX_LOCAL_WIDTHS", False)
+
+
+@pytest.mark.parametrize(
+    "context,pages", [(8192, 8), (16384, 16), (24576, 24), (32768, 32)]
+)
+def test_only_visible_complete_pages_are_transferred(context, pages):
+    geometry = owner.compact_geometry(context)
+    assert geometry.pages_per_source == (pages,) * 4
+    assert geometry.gathered_pages_per_source == pages
+    assert pages * owner.PAGE_BYTES == pages * (8192 + 256)
+
+
+def test_unequal_source_lengths_use_bounded_zero_padding():
+    geometry = owner.compact_geometry(8196)
+    assert geometry.pages_per_source == (9, 8, 8, 8)
+    assert geometry.gathered_pages_per_source == 9
+    source = (
+        torch.arange(40 * owner.PAGE_BYTES)
+        .remainder(256)
+        .to(torch.uint8)
+        .view(40, owner.PAGE_BYTES)
+    )
+    ids = torch.tensor([35, 1, 39, 2, 36, 3, 37, 4], dtype=torch.int32)
+    output = torch.full((9, owner.PAGE_BYTES), 0xA5, dtype=torch.uint8)
+    owner.copy_index_pages(source, ids, output)
+    assert torch.equal(output[:8], source[ids.long()])
+    assert torch.count_nonzero(output[8]) == 0
+    assert torch.equal(output[:8, 8192:], source[ids.long(), 8192:])
+
+
+def test_copy_pages_preserves_guarded_output_and_noncontiguous_physical_mapping():
+    backing = torch.randint(0, 256, (70, owner.PAGE_BYTES), dtype=torch.uint8)
+    source = backing[32:]
+    ids = torch.tensor([34, 35, 0, 1], dtype=torch.int32)
+    target = torch.full((6, owner.PAGE_BYTES), 0xA5, dtype=torch.uint8)
+    owner.copy_index_pages(source, ids, target[1:-1])
+    assert torch.equal(target[1:-1], backing[ids.long() + 32])
+    assert bool((target[[0, -1]] == 0xA5).all())
+
+
+def test_negative_physical_pages_are_zeroed_like_existing_scorer():
+    source = torch.randint(0, 256, (4, owner.PAGE_BYTES), dtype=torch.uint8)
+    ids = torch.tensor([2, -1, 0, -7], dtype=torch.int32)
+    output = torch.full((5, owner.PAGE_BYTES), 0xA5, dtype=torch.uint8)
+    safe_ids = torch.empty((32,), dtype=torch.int32)
+    invalid = torch.empty((32,), dtype=torch.bool)
+    owner.copy_index_pages(
+        source, ids, output, safe_page_ids=safe_ids, invalid_pages=invalid
+    )
+    assert torch.equal(output[0], source[2]) and torch.equal(output[2], source[0])
+    assert torch.count_nonzero(output[[1, 3, 4]]) == 0
+
+
+@pytest.mark.parametrize(
+    "changes",
+    [
+        {"num_reqs": 2},
+        {"num_prefills": 2},
+        {"num_decode_tokens": 1},
+        {"num_decodes": 1},
+        {"num_actual_tokens": 8191},
+        {"is_spec_decode": True},
+        {"prefill_query_lens_cpu": torch.tensor([8188], dtype=torch.int32)},
+        {"prefill_seq_lens_cpu": None},
+        {"prefill_seq_lens_cpu": torch.tensor([65536], dtype=torch.int32)},
+        {"prefill_seq_lens_cpu": torch.tensor([32768.0])},
+        {"prefill_seq_lens_cpu": torch.empty((1,), dtype=torch.int32, device="meta")},
+    ],
+)
+def test_ineligible_or_unknown_metadata_keeps_existing_path(changes):
+    assert owner.eligible_geometry(metadata(**changes), 8192) is None
+
+
+def test_global_cpu_prefill_length_controls_admission_not_dcp_local_length():
+    data = metadata(context=32768, seq_lens=torch.tensor([8192]))
+    assert owner.eligible_geometry(data, 8192) == owner.compact_geometry(32768)
+    data.prefill_seq_lens_cpu = torch.tensor([65536])
+    assert owner.eligible_geometry(data, 8192) is None
+    assert owner.eligible_geometry(metadata(), 2048) is None
+
+
+def install_vote(monkeypatch, disagree=False):
+    group = SimpleNamespace(world_size=4, cpu_group=object())
+    monkeypatch.setattr(owner, "get_dcp_group", lambda: group)
+    monkeypatch.setattr(owner, "_forward_ref", None)
+    monkeypatch.setattr(owner.torch.cuda, "is_current_stream_capturing", lambda: False)
+    calls = []
+
+    def vote(peers, local, group):
+        calls.append(local)
+        peers[:] = [local] * 4
+        if disagree:
+            peers[-1] = None
+
+    monkeypatch.setattr(owner.dist, "all_gather_object", vote)
+    return calls
+
+
+def test_batch_vote_is_reused_across_layers_but_not_across_forwards(monkeypatch):
+    calls = install_vote(monkeypatch)
+    context = Context()
+    for _ in range(4):
+        assert owner.agree_forward_geometry(
+            context, metadata(), 8192
+        ) == owner.compact_geometry(32768)
+    assert len(calls) == 1
+    assert owner.agree_forward_geometry(Context(), metadata(), 8192) is not None
+    assert len(calls) == 2
+
+
+def test_rank_disagreement_and_local_ineligibility_still_enter_shared_vote(monkeypatch):
+    calls = install_vote(monkeypatch, disagree=True)
+    assert owner.agree_forward_geometry(Context(), metadata(), 8192) is None
+    assert (
+        owner.agree_forward_geometry(Context(), metadata(context=65536), 8192) is None
+    )
+    assert len(calls) == 2
+
+
+@pytest.mark.parametrize("context", [8192, 8196, 16384, 32768, 65536])
+def test_tensor_vote_matches_object_vote_and_reuses_completed_buffers(
+    monkeypatch, context
+):
+    object_calls = install_vote(monkeypatch)
+    data = metadata(context=context)
+    expected = owner.agree_forward_geometry(Context(), data, 8192)
+    tensor_vote = owner._GeometryTensorVote(object())
+    monkeypatch.setattr(owner, "_tensor_vote", tensor_vote)
+    addresses = [
+        tensor_vote.send.data_ptr(),
+        *(p.data_ptr() for p in tensor_vote.peers),
+    ]
+    votes = []
+
+    def gather(peers, local, group):
+        assert group is tensor_vote.group
+        assert local.device.type == "cpu" and local.dtype == torch.int64
+        votes.append(local.tolist())
+        for peer in peers:
+            peer.copy_(local)
+
+    monkeypatch.setattr(owner.dist, "all_gather", gather)
+    forward = Context()
+    for _ in range(4):
+        assert owner.agree_forward_geometry(forward, data, 8192) == expected
+    assert len(votes) == 1 and len(object_calls) == 1
+    assert owner.agree_forward_geometry(Context(), data, 8192) == expected
+    assert len(votes) == 2
+    assert addresses == [
+        tensor_vote.send.data_ptr(),
+        *(p.data_ptr() for p in tensor_vote.peers),
+    ]
+    if context == 65536:
+        assert votes[0] == [owner._VOTE_SCHEMA, 0, 0, 0, 0, 0, 0, 0]
+
+
+@pytest.mark.parametrize("field", range(8))
+def test_any_tensor_vote_field_disagreement_selects_fallback(monkeypatch, field):
+    install_vote(monkeypatch)
+    monkeypatch.setattr(owner, "_tensor_vote", owner._GeometryTensorVote(object()))
+
+    def gather(peers, local, group):
+        for peer in peers:
+            peer.copy_(local)
+        peers[-1][field] += 1
+
+    monkeypatch.setattr(owner.dist, "all_gather", gather)
+    assert owner.agree_forward_geometry(Context(), metadata(), 8192) is None
+
+
+def test_tensor_vote_rejects_reentry_and_releases_buffers_after_collective_error(
+    monkeypatch,
+):
+    vote = owner._GeometryTensorVote(object())
+    geometry = owner.compact_geometry(8196)
+
+    def broken_gather(peers, local, group):
+        with pytest.raises(RuntimeError, match="Concurrent"):
+            vote.agree(geometry)
+        raise OSError("collective failed")
+
+    monkeypatch.setattr(owner.dist, "all_gather", broken_gather)
+    with pytest.raises(OSError, match="collective failed"):
+        vote.agree(geometry)
+
+    def gather(peers, local, group):
+        for peer in peers:
+            peer.copy_(local)
+
+    monkeypatch.setattr(owner.dist, "all_gather", gather)
+    assert vote.agree(geometry)
+
+
+def test_tensor_vote_retains_within_forward_metadata_consistency_check(monkeypatch):
+    install_vote(monkeypatch)
+    vote = owner._GeometryTensorVote(object())
+    monkeypatch.setattr(owner, "_tensor_vote", vote)
+    monkeypatch.setattr(vote, "agree", lambda proposal: True)
+    context = Context()
+    assert owner.agree_forward_geometry(context, metadata(), 8192) is not None
+    with pytest.raises(RuntimeError, match="differs between layers"):
+        owner.agree_forward_geometry(context, metadata(context=16384), 8192)
+
+
+def test_startup_votes_on_tensor_protocol_before_selecting_collective(monkeypatch):
+    install_vote(monkeypatch)
+    monkeypatch.setattr(owner, "_startup_signature", None)
+    monkeypatch.setattr(owner.envs, "VLLM_DCP_COMPACT_INDEX_TENSOR_VOTE", True)
+
+    def disagreement(peers, local, group):
+        peers[:] = [local] * 4
+        peers[-1] = (*local[:-2], False, local[-1])
+
+    monkeypatch.setattr(owner.dist, "all_gather_object", disagreement)
+    with pytest.raises(RuntimeError, match="differs across ranks"):
+        owner.initialize_compact_index_mode(True, (8192, 1048576, 512, 1))
+    assert owner._tensor_vote is None and owner._startup_signature is None
+
+    def agreement(peers, local, group):
+        peers[:] = [local] * 4
+
+    monkeypatch.setattr(owner.dist, "all_gather_object", agreement)
+    owner.initialize_compact_index_mode(True, (8192, 1048576, 512, 1))
+    assert owner._tensor_vote is not None
+    monkeypatch.setattr(owner.envs, "VLLM_DCP_COMPACT_INDEX_TENSOR_VOTE", False)
+    with pytest.raises(RuntimeError, match="configuration changed"):
+        owner.initialize_compact_index_mode(True, (8192, 1048576, 512, 1))
+
+
+def test_startup_rejects_mixed_local_width_modes_before_skipping_collective(
+    monkeypatch,
+):
+    install_vote(monkeypatch)
+    monkeypatch.setattr(owner, "_startup_signature", None)
+    monkeypatch.setattr(owner.envs, "VLLM_DCP_COMPACT_INDEX_LOCAL_WIDTHS", True)
+
+    def disagreement(peers, local, group):
+        peers[:] = [local] * 4
+        peers[-1] = (*local[:-3], False, *local[-2:])
+
+    monkeypatch.setattr(owner.dist, "all_gather_object", disagreement)
+    with pytest.raises(RuntimeError, match="differs across ranks"):
+        owner.initialize_compact_index_mode(True, (8192, 1048576, 512, 1))
+    assert owner._local_widths_enabled is False
+    assert owner._tensor_vote is None and owner._startup_signature is None
+
+    def agreement(peers, local, group):
+        peers[:] = [local] * 4
+
+    monkeypatch.setattr(owner.dist, "all_gather_object", agreement)
+    owner.initialize_compact_index_mode(True, (8192, 1048576, 512, 1))
+    assert owner._local_widths_enabled is True
+    monkeypatch.setattr(owner.envs, "VLLM_DCP_COMPACT_INDEX_LOCAL_WIDTHS", False)
+    with pytest.raises(RuntimeError, match="configuration changed"):
+        owner.initialize_compact_index_mode(True, (8192, 1048576, 512, 1))
+
+
+def test_small_decode_capture_dummy_and_microbatch_paths_have_no_vote(monkeypatch):
+    calls = install_vote(monkeypatch)
+    assert owner.agree_forward_geometry(Context(), metadata(), 64) is None
+    for field, value in (
+        ("cudagraph_runtime_mode", CUDAGraphMode.FULL),
+        ("is_dummy_run", True),
+        ("ubatch_slices", object()),
+    ):
+        context = Context()
+        setattr(context, field, value)
+        assert owner.agree_forward_geometry(context, metadata(), 8192) is None
+    monkeypatch.setattr(owner.torch.cuda, "is_current_stream_capturing", lambda: True)
+    assert owner.agree_forward_geometry(Context(), metadata(), 8192) is None
+    assert not calls
+
+
+def test_startup_detects_rank_mode_disagreement_and_caches_agreement(monkeypatch):
+    group = SimpleNamespace(world_size=4, cpu_group=object())
+    monkeypatch.setattr(owner, "get_dcp_group", lambda: group)
+    monkeypatch.setattr(owner, "_startup_signature", None)
+    vote = Mock(
+        side_effect=lambda peers, local, group: peers.__setitem__(
+            slice(None), [local] * 4
+        )
+    )
+    monkeypatch.setattr(owner.dist, "all_gather_object", vote)
+    owner.initialize_compact_index_mode(False, (8192, 1048576, 512, 1))
+    owner.initialize_compact_index_mode(False, (8192, 1048576, 512, 1))
+    owner.initialize_compact_index_mode(False, (2048, 65536, 256, 1))
+    assert vote.call_count == 1
+    monkeypatch.setattr(owner, "_startup_signature", None)
+    monkeypatch.setattr(
+        owner.dist,
+        "all_gather_object",
+        lambda peers, local, group: peers.__setitem__(
+            slice(None), [local] * 3 + [None]
+        ),
+    )
+    with pytest.raises(RuntimeError, match="differs across ranks"):
+        owner.initialize_compact_index_mode(True, (8192, 1048576, 512, 1))
+
+
+def test_owner_plan_keeps_declared_table_capacity_and_reserves_before_execution(
+    monkeypatch,
+):
+    from vllm.v1.worker import workspace
+
+    manager = SimpleNamespace(reserve_all=Mock())
+    monkeypatch.setattr(workspace, "current_workspace_manager", lambda: manager)
+    plan = SimpleNamespace(shapes_and_dtypes=lambda: (((2048, 65536), torch.float32),))
+    planner = Mock(return_value=plan)
+    indexer = SimpleNamespace(_b12x_indexer=object(), _plan_paged_topk=planner)
+    q = torch.empty((8192, 32, 128), dtype=torch.float8_e4m3fn, device="meta")
+    adapter = owner.CompactIndexOwner(indexer, q, 1024, 0)
+    arguments = planner.call_args.kwargs
+    assert arguments["q"].shape == (2048, 32, 128)
+    assert arguments["block_table"].shape == (2048, 1024)
+    assert arguments["block_table"].stride(0) == 0
+    assert arguments["shared_page_table"] is True
+    assert adapter.plan is plan
+    assert manager.reserve_all.call_args.args[-1] == ((2048, 65536), torch.float32)
