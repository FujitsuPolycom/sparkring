+"""Isolated four-rank owner exchange; importing opens no CUDA or RDMA resources."""
+
+from .layout import API_VERSION, DEFAULT_MAX_INPUT_BYTES, PROXY_ABI_VERSION
+
+__all__ = [
+    "API_VERSION", "PROXY_ABI_VERSION", "DEFAULT_MAX_INPUT_BYTES",
+    "MeshOwnerAllToAll", "OwnerAllToAll",
+]
+
+
+def __getattr__(name: str):
+    if name in ("MeshOwnerAllToAll", "OwnerAllToAll"):
+        from .runtime import MeshOwnerAllToAll
+
+        return MeshOwnerAllToAll
+    if name in ("AllReduce", "all_reduce", "all_gather"):
+        raise AttributeError("mesh_owner only implements owner all_to_all")
+    raise AttributeError(name)
