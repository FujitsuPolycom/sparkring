new file mode 100644
index 0000000000..87a5bf20c1
--- /dev/null
+++ b/vllm/v1/attention/backends/mla/compact_index_owner.py
@@ -0,0 +1,443 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Bounded compact C4 cache exchange for owner-scored prefill queries."""
+
+import weakref
+from dataclasses import dataclass
+from threading import Lock
+from typing import Any
+
+import torch
+import torch.distributed as dist
+
+from vllm import envs
+from vllm.distributed import get_dcp_group
+from vllm.logger import init_logger
+from vllm.triton_utils import tl, triton
+
+WORLD, ROWS, TOPK, PAGE_SIZE, PAGE_BYTES = 4, 8192, 512, 64, 8448
+MAX_CONTEXT, MAX_PAGES, TABLE_PAGES = 32768, 32, 1024
+logger = init_logger(__name__)
+_startup_signature: tuple[Any, ...] | None = None
+_forward_ref: weakref.ReferenceType[Any] | None = None
+_forward_proposal: Any = None
+_forward_decision: Any = None
+_tensor_vote: "_GeometryTensorVote | None" = None
+_VOTE_SCHEMA = 1
+_local_widths_enabled = False
+
+
+@triton.jit
+def _local_source_widths_kernel(
+    positions,
+    output,
+    position_stride,
+    output_stride,
+    CAPACITY: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    rows = tl.arange(0, BLOCK)
+    position = tl.load(positions + rows * position_stride).to(tl.int64)
+    maximum = tl.max(position, axis=0)
+    pools = (maximum + 1) // 4
+    source = tl.arange(0, 4)
+    width = pools // 4 + (pools % 4 > source).to(tl.int64)
+    width = tl.minimum(tl.maximum(width, 0), CAPACITY).to(tl.int32)
+    tl.store(output + source * output_stride, width)
+
+
+def local_source_active_widths(
+    positions: torch.Tensor, output: torch.Tensor, table_width: int
+) -> None:
+    """Derive all source maxima from the full replicated 8192-row positions."""
+    if (
+        positions.shape != (ROWS,)
+        or positions.dtype != torch.int64
+        or output.shape != (WORLD,)
+        or output.dtype != torch.int32
+        or positions.device.type != "cuda"
+        or output.device != positions.device
+        or table_width < 1
+    ):
+        raise ValueError(
+            "Local source widths require full CUDA positions and four outputs"
+        )
+    _local_source_widths_kernel[(1,)](
+        positions,
+        output,
+        positions.stride(0),
+        output.stride(0),
+        CAPACITY=table_width * PAGE_SIZE,
+        BLOCK=ROWS,
+        num_warps=8,
+    )
+
+
+@dataclass(frozen=True)
+class CompactIndexGeometry:
+    context_bound: int
+    pages_per_source: tuple[int, ...]
+    gathered_pages_per_source: int
+
+
+class _GeometryTensorVote:
+    """One synchronous CPU collective with reusable, non-reentrant buffers."""
+
+    def __init__(self, group: Any) -> None:
+        self.group = group
+        self.send = torch.empty(8, dtype=torch.int64, device="cpu")
+        self.peers = [torch.empty_like(self.send) for _ in range(WORLD)]
+        self.values = self.send.numpy()
+        self.lock = Lock()
+
+    def agree(self, proposal: CompactIndexGeometry | None) -> bool:
+        # Schema, eligibility, global context, four page counts, padded count.
+        # None participates with an explicit zero record; it never skips a vote.
+        values = (
+            (_VOTE_SCHEMA, 0, 0, 0, 0, 0, 0, 0)
+            if proposal is None
+            else (
+                _VOTE_SCHEMA,
+                1,
+                proposal.context_bound,
+                *proposal.pages_per_source,
+                proposal.gathered_pages_per_source,
+            )
+        )
+        if not self.lock.acquire(blocking=False):
+            raise RuntimeError(
+                "Concurrent compact index geometry votes are unsupported"
+            )
+        try:
+            self.values[:] = values
+            dist.all_gather(self.peers, self.send, group=self.group)
+            return all(torch.equal(peer, self.send) for peer in self.peers)
+        finally:
+            self.lock.release()
+
+
+def compact_geometry(context_bound: int) -> CompactIndexGeometry:
+    """Size only pages containing completed pools, preserving source order."""
+    if not ROWS <= context_bound <= MAX_CONTEXT:
+        raise ValueError("Compact index context is outside the bounded capacity")
+    full, tail = divmod(context_bound // 4, WORLD)
+    pages = tuple(
+        (full + int(rank < tail) + PAGE_SIZE - 1) // PAGE_SIZE for rank in range(WORLD)
+    )
+    return CompactIndexGeometry(context_bound, pages, max(pages))
+
+
+def copy_index_pages(
+    source: torch.Tensor,
+    page_ids: torch.Tensor,
+    output: torch.Tensor,
+    *,
+    safe_page_ids: torch.Tensor | None = None,
+    invalid_pages: torch.Tensor | None = None,
+) -> None:
+    """Copy planar pages, matching the scorer's zero fill for negative pages."""
+    if (
+        source.ndim != 2
+        or source.shape[1] != PAGE_BYTES
+        or source.dtype != torch.uint8
+        or output.ndim != 2
+        or output.shape[1] != PAGE_BYTES
+        or output.dtype != torch.uint8
+        or page_ids.ndim != 1
+        or page_ids.dtype != torch.int32
+        or not 0 < page_ids.numel() <= output.shape[0]
+    ):
+        raise ValueError("Compact C4 page buffers have invalid geometry")
+    count = page_ids.numel()
+    if safe_page_ids is None:
+        safe_page_ids = torch.empty_like(page_ids)
+    if invalid_pages is None:
+        invalid_pages = torch.empty_like(page_ids, dtype=torch.bool)
+    safe_page_ids, invalid_pages = safe_page_ids[:count], invalid_pages[:count]
+    torch.clamp(page_ids, min=0, out=safe_page_ids)
+    torch.lt(page_ids, 0, out=invalid_pages)
+    torch.index_select(source, 0, safe_page_ids, out=output[:count])
+    output[:count].masked_fill_(invalid_pages[:, None], 0)
+    if count < output.shape[0]:
+        output[count:].zero_()
+
+
+def initialize_compact_index_mode(enabled: bool, signature: tuple[Any, ...]) -> None:
+    """Vote on the opt-in and fixed geometry once before model execution."""
+    global _startup_signature, _tensor_vote, _local_widths_enabled
+    tensor_vote = enabled and envs.VLLM_DCP_COMPACT_INDEX_TENSOR_VOTE
+    local_widths = enabled and envs.VLLM_DCP_COMPACT_INDEX_LOCAL_WIDTHS
+    local = (
+        (enabled, *signature, local_widths, tensor_vote, _VOTE_SCHEMA)
+        if enabled
+        else (False,)
+    )
+    if _startup_signature is not None:
+        if _startup_signature != local:
+            raise RuntimeError("Compact index configuration changed within a worker")
+        return
+    group = get_dcp_group()
+    if group.world_size != WORLD:
+        raise RuntimeError("Compact index owner requires four DCP ranks")
+    peers: list[Any] = [None] * group.world_size
+    dist.all_gather_object(peers, local, group=group.cpu_group)
+    if any(peer != local for peer in peers):
+        raise RuntimeError(
+            f"Compact index mode or geometry differs across ranks: {peers}"
+        )
+    _startup_signature = local
+    _tensor_vote = _GeometryTensorVote(group.cpu_group) if tensor_vote else None
+    _local_widths_enabled = local_widths
+    logger.info(
+        "Compact C4 index owner configured: enabled=%s geometry=%s "
+        "tensor_vote=%s local_widths=%s",
+        enabled,
+        signature,
+        tensor_vote,
+        local_widths,
+    )
+
+
+def eligible_geometry(metadata: Any, rows: int) -> CompactIndexGeometry | None:
+    """Read global CPU prefill lengths; never synchronize a device scalar."""
+    if rows != ROWS or metadata is None:
+        return None
+    expected = {
+        "num_reqs": 1,
+        "num_prefills": 1,
+        "num_decodes": 0,
+        "num_decode_tokens": 0,
+        "num_actual_tokens": ROWS,
+    }
+    if any(getattr(metadata, key, None) != value for key, value in expected.items()):
+        return None
+    if getattr(metadata, "is_spec_decode", True):
+        return None
+    query = getattr(metadata, "prefill_query_lens_cpu", None)
+    context = getattr(metadata, "prefill_seq_lens_cpu", None)
+    for value in (query, context):
+        if (
+            not isinstance(value, torch.Tensor)
+            or value.device.type != "cpu"
+            or tuple(value.shape) != (1,)
+            or value.dtype not in (torch.int32, torch.int64)
+        ):
+            return None
+    assert isinstance(query, torch.Tensor) and isinstance(context, torch.Tensor)
+    if int(query[0]) != ROWS:
+        return None
+    length = int(context[0])
+    return compact_geometry(length) if ROWS <= length <= MAX_CONTEXT else None
+
+
+def agree_forward_geometry(
+    context: Any, metadata: Any, rows: int
+) -> CompactIndexGeometry | None:
+    """One control vote per 8192-row eager forward, shared by all index layers.
+
+    Every rank with the shared query tensor shape enters, even if its local
+    metadata is ineligible. Disagreement selects the existing path everywhere.
+    No vote runs for small/decode query shapes or CUDA graph execution.
+    """
+    global _forward_ref, _forward_proposal, _forward_decision
+    from vllm.config import CUDAGraphMode
+
+    if (
+        rows != ROWS
+        or context.cudagraph_runtime_mode == CUDAGraphMode.FULL
+        or context.is_dummy_run
+        or context.ubatch_slices is not None
+        or torch.cuda.is_current_stream_capturing()
+    ):
+        return None
+    proposal = eligible_geometry(metadata, rows)
+    if _forward_ref is not None and _forward_ref() is context:
+        if proposal != _forward_proposal:
+            raise RuntimeError(
+                "Compact index metadata differs between layers of one forward"
+            )
+        return _forward_decision
+    group = get_dcp_group()
+    if _tensor_vote is not None:
+        agreed = _tensor_vote.agree(proposal)
+    else:
+        peers: list[Any] = [None] * group.world_size
+        dist.all_gather_object(peers, proposal, group=group.cpu_group)
+        agreed = all(peer == proposal for peer in peers)
+    decision = proposal if proposal is not None and agreed else None
+    _forward_ref, _forward_proposal, _forward_decision = (
+        weakref.ref(context),
+        proposal,
+        decision,
+    )
+    return decision
+
+
+class CompactIndexOwner:
+    """Reuse production-width scorer plans and pre-reserved worker scratch."""
+
+    def __init__(
+        self, indexer: Any, q_buffer: torch.Tensor, table_width: int, rank: int
+    ):
+        from vllm.v1.worker.workspace import current_workspace_manager
+
+        if table_width != TABLE_PAGES or q_buffer.shape != (ROWS, 32, 128):
+            raise ValueError(
+                "Compact index owner requires the 8192-row, 1024-page declared profile"
+            )
+        self.indexer, self.module, self.rank = indexer, indexer._b12x_indexer, rank
+        self.table_width, self.owned = table_width, ROWS // WORLD
+        columns = torch.arange(table_width, device=q_buffer.device, dtype=torch.int32)
+        pages = torch.arange(
+            1, MAX_PAGES + 1, device=q_buffer.device, dtype=torch.int32
+        )
+        self.tables = torch.where(
+            columns[None, :] < pages[:, None], columns[None, :], 0
+        )
+        table = self.tables[-1:].expand(self.owned, -1)
+        self.plan = indexer._plan_paged_topk(
+            q=q_buffer[: self.owned], block_table=table, shared_page_table=True
+        )
+        self.scorer_specs = tuple(self.plan.shapes_and_dtypes())
+        self.buffer_specs = (
+            ((MAX_PAGES, PAGE_BYTES), torch.uint8),
+            ((WORLD * MAX_PAGES, PAGE_BYTES), torch.uint8),
+            ((WORLD,), torch.int32),
+            ((WORLD, self.owned), torch.int32),
+            ((self.owned, TOPK), torch.int32),
+            ((self.owned, TOPK), torch.float32),
+            ((self.owned, WORLD * TOPK, 2), torch.float32),
+            ((self.owned, TOPK), torch.int32),
+            ((ROWS, TOPK), torch.int32),
+            ((MAX_PAGES,), torch.int32),
+            ((MAX_PAGES,), torch.bool),
+        )
+        current_workspace_manager().reserve_all(*self.buffer_specs, *self.scorer_specs)
+        self._logged_pages: set[int] = set()
+
+    def run(
+        self,
+        *,
+        q: torch.Tensor,
+        weights: torch.Tensor,
+        positions: torch.Tensor,
+        cache: torch.Tensor,
+        table: torch.Tensor,
+        local_lengths: torch.Tensor,
+        output: torch.Tensor,
+        geometry: CompactIndexGeometry,
+    ) -> None:
+        from vllm.model_executor.kernels.attention.dsa.dcp_indexer_cutedsl import (
+            stable_topk_from_gathered_candidates_cutedsl,
+        )
+        from vllm.models.deepseek_v4.nvidia.b12x_indexer import _flatten_index_cache
+        from vllm.models.glm5next.nvidia.ops.glm_kpool import pool_seq_lens
+        from vllm.v1.attention.backends.mla.b12x_indexer import (
+            _pack_dcp_candidates_kernel,
+        )
+        from vllm.v1.worker.workspace import current_workspace_manager
+
+        if (
+            q.shape != (ROWS, 32, 128)
+            or weights.shape != (ROWS, 32)
+            or positions.shape != (ROWS,)
+            or output.shape != (ROWS, TOPK)
+            or table.shape != (1, self.table_width)
+        ):
+            raise RuntimeError(
+                "Compact index invocation differs from its voted geometry"
+            )
+        buffers = current_workspace_manager().get_simultaneous(
+            *self.buffer_specs, *self.scorer_specs
+        )
+        (
+            compact_storage,
+            gathered_storage,
+            active,
+            lengths,
+            indices,
+            scores,
+            ordered,
+            owned_ids,
+            global_ids,
+            safe_page_ids,
+            invalid_pages,
+        ) = buffers[: len(self.buffer_specs)]
+        scorer_scratch = buffers[len(self.buffer_specs) :]
+        pages = geometry.gathered_pages_per_source
+        local_pages = geometry.pages_per_source[self.rank]
+        compact = compact_storage[:pages]
+        gathered = gathered_storage[: WORLD * pages]
+        # Pool updates and table expansion were enqueued on this same stream.
+        # Copy only valid source pages; pad unequal source counts with zeroes.
+        copy_index_pages(
+            _flatten_index_cache(cache),
+            table[0, :local_pages],
+            compact,
+            safe_page_ids=safe_page_ids,
+            invalid_pages=invalid_pages,
+        )
+        group = get_dcp_group()
+        dist.all_gather_into_tensor(gathered, compact, group=group.device_group)
+        if _local_widths_enabled:
+            local_source_active_widths(positions, active, self.table_width)
+        else:
+            local_active = self.indexer._set_active_width(local_lengths, table)
+            dist.all_gather_into_tensor(active, local_active, group=group.device_group)
+        start, end = self.rank * self.owned, (self.rank + 1) * self.owned
+        owned_q, owned_weights = q[start:end], weights[start:end]
+        source_table = self.tables[pages - 1 : pages].expand(self.owned, -1)
+        for source in range(WORLD):
+            pool_seq_lens(
+                positions[start:end],
+                lengths[source],
+                dcp_size=WORLD,
+                dcp_rank=source,
+                pool_interleave=1,
+            )
+            binding = self.module.bind(
+                self.plan,
+                scratch=scorer_scratch,
+                q_fp8=owned_q,
+                query_weights=owned_weights,
+                index_k_cache=gathered[source * pages : (source + 1) * pages],
+                page_table=source_table,
+                cache_lengths=lengths[source],
+                active_width=active[source : source + 1],
+                output_indices=indices,
+                output_scores=scores,
+            )
+            self.module.run(binding)
+            destination = ordered[:, source * TOPK : (source + 1) * TOPK]
+            _pack_dcp_candidates_kernel[(self.owned, 1)](
+                indices,
+                scores,
+                destination,
+                indices.stride(0),
+                scores.stride(0),
+                destination.stride(0),
+                destination.stride(1),
+                source,
+                WORLD,
+                1,
+                TOPK,
+                512,
+                num_warps=8,
+            )
+        stable_topk_from_gathered_candidates_cutedsl(ordered, TOPK, out=owned_ids)
+        dist.all_gather_into_tensor(global_ids, owned_ids, group=group.device_group)
+        output.copy_(global_ids)
+        if pages not in self._logged_pages:
+            self._logged_pages.add(pages)
+            logger.info(
+                "Compact C4 index owner active: query_rows=%s owner_rows=%s "
+                "context_bound=%s pack_pages=%s local_pages=%s "
+                "pack_bytes=%s declared_table_pages=%s",
+                ROWS,
+                self.owned,
+                geometry.context_bound,
+                pages,
+                local_pages,
+                pages * PAGE_BYTES,
+                self.table_width,
+            )
diff --git a/vllm/v1/attention/backends/mla/dcp_owner_merge.py b/vllm/v1/attention/backends/mla/dcp_owner_merge.py
new file mode 100644
index 0000000000..40234a1f5a
--- /dev/null
+++ b/vllm/v1/attention/backends/mla/dcp_owner_merge.py
@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Exact row-owner routing for prefill candidates already packed as score/ID."""
+
+import torch
+import torch.distributed as dist
+
+
+def owner_workspace_shapes(rows: int, topk: int, world: int):
+    if world != 4 or rows <= 0 or rows % world or topk != 512:
+        raise ValueError("Owner merge requires positive four-way rows and 512 pools")
+    owned = rows // world
+    return (
+        ((world, owned, topk, 2), torch.float32),
+        ((owned, world * topk, 2), torch.float32),
+        ((owned, topk), torch.int32),
+        ((rows, topk), torch.int32),
+    )
+
+
+def merge_by_owner(packed, output, process_group, scratch, merge, exchange=None):
+    """Return identical global pool IDs on every rank using two collectives.
+
+    All ranks must provide equal row counts and enter in the same order.
+    The caller supplies disjoint, pre-reserved buffers and an exact stable
+    score/ID merge. Pool expansion remains the caller's responsibility.
+    """
+    world = dist.get_world_size(process_group)
+    rows, topk, fields = packed.shape
+    shapes = owner_workspace_shapes(rows, topk, world)
+    if fields != 2 or packed.dtype != torch.float32 or not packed.is_contiguous():
+        raise ValueError("Owner candidates must be contiguous FP32 score/ID pairs")
+    if len(scratch) != len(shapes):
+        raise ValueError("Owner workspace count differs")
+    for tensor, (shape, dtype) in zip(scratch, shapes):
+        if (
+            tuple(tensor.shape) != shape
+            or tensor.dtype != dtype
+            or not tensor.is_contiguous()
+        ):
+            raise ValueError("Owner workspace layout differs")
+    received, ordered, owned_ids, global_ids = scratch
+    if exchange is None:
+        dist.all_to_all_single(received.view(-1), packed.view(-1), group=process_group)
+    else:
+        exchange(packed, out=received.view_as(packed))
