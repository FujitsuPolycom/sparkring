+
+logger = init_logger(__name__)
+_runtime = None
+_capacity = 0
+
+
+def initialize_owner_transport(max_rows: int, device: torch.device) -> None:
+    """Connect once before profiling; every DCP rank must participate."""
+    global _runtime, _capacity
+    required = ((max_rows + 3) // 4) * 4 * 512 * 8
+    if _runtime is not None:
+        if required > _capacity or _runtime.device != device:
+            raise RuntimeError("Owner mesh runtime capacity or device changed")
+        return
+    group = get_dcp_group()
+    if group.world_size != 4:
+        raise RuntimeError("Owner mesh requires four DCP ranks")
+    path = Path(
+        os.getenv(
+            "VLLM_DCP_OWNER_MESH_CONFIG",
+            "/opt/spark-sircl/rocenante-overlay-config.json",
+        )
+    )
+    contract = json.loads(path.read_text())
+    if contract.get("schema") != "sparkring.glm53-rocenante-overlay-contract/v1":
+        raise RuntimeError("Owner mesh configuration schema is unsupported")
+    from vllm.third_party.sparkring_mesh_owner import (
+        MeshOwnerAllToAll,
+    )
+
+    proxy_cpu = int(os.getenv("VLLM_DCP_OWNER_PROXY_CPU", "14"))
+    get_affinity = getattr(os, "sched_getaffinity", None)
+    set_affinity = getattr(os, "sched_setaffinity", None)
+    if get_affinity is None or set_affinity is None:
+        raise RuntimeError("Owner proxy requires Linux thread affinity")
+    original_affinity = get_affinity(0)
+    errors = [None] * group.world_size
+    local_error = (
+        None
+        if proxy_cpu in original_affinity and proxy_cpu not in (10, 11, 13)
+        else "Owner proxy CPU must be available and outside transport CPUs 10/11/13"
+    )
+    torch.distributed.all_gather_object(errors, local_error, group=group.cpu_group)
+    if any(error is not None for error in errors):
+        raise RuntimeError(f"Owner proxy affinity preflight failed: {errors}")
+    # The native proxy inherits this mask at pthread_create; restore the model
+    # thread's mask immediately afterward. Existing transport threads are untouched.
+    set_affinity(0, {proxy_cpu})
+    try:
+        runtime = MeshOwnerAllToAll(
+            exchange_group=group.cpu_group,
+            device=device,
+            max_input_bytes=required,
+            hca_names=contract["canonical_hca_order"],
+            gid_index=3,
+        )
+    finally:
+        set_affinity(0, original_affinity)
+    runtime.prepare()
+    if envs.VLLM_DCP_OWNER_FUSED_ENDPOINTS:
+        runtime.prepare_pack_rows(interleave=1)
+    _runtime, _capacity = runtime, required
+    atexit.register(runtime.close)
+    # The pinned mesh health gate executes after vLLM synchronizes an output.
+    # Include this independent proxy before any generated token is published.
+    rocenante_health_gate: Any = importlib.import_module("rocenante_health_gate")
+
+    previous_health_check = rocenante_health_gate.require_health
+
+    def require_owner_health():
+        previous_health_check()
+        runtime.check_health()
+
+    rocenante_health_gate.require_health = require_owner_health
+    logger.info(
+        "GLM owner exchange initialized: rank=%s capacity=%s bytes",
+        group.rank_in_group,
+        required,
+    )
+
+
+def owner_exchange(packed: torch.Tensor, *, out: torch.Tensor) -> torch.Tensor:
+    if _runtime is None:
+        raise RuntimeError("Owner mesh was not initialized before model execution")
+    logger.info_once(
+        "GLM owner exchange active: rows=%s pools=%s bytes=%s",
+        packed.shape[0],
+        packed.shape[1],
+        packed.numel() * packed.element_size(),
+    )
+    return _runtime.all_to_all(packed, out=out)
+
+
+def owner_pack_exchange_rows(indices, scores, out, interleave):
+    if _runtime is None:
+        raise RuntimeError("Owner mesh was not initialized before model execution")
+    logger.info_once("GLM fused owner exchange active: rows=%s", indices.shape[0])
+    return _runtime.pack_all_to_all_rows(
+        indices, scores, out=out, interleave=interleave
+    )
