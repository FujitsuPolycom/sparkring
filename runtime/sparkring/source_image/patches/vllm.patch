--- /dev/null
+++ b/vllm/third_party/sparkring_mesh_owner/layout.py
@@ -0,0 +1,109 @@
+"""CPU-only layout arithmetic (no Torch/CUDA/RDMA dependency)."""
+
+from dataclasses import dataclass
+from math import prod
+
+API_VERSION = "mesh-owner-all-to-all-v1"
+ROWS_API_VERSION = "mesh-owner-receive-rows-v1"
+PROXY_ABI_VERSION = 0x4F574E01
+WORLD_SIZE = 4
+PACK_BYTES = 16
+SLOTS = 2
+FLAG_STRIDE = 128
+DEFAULT_MAX_INPUT_BYTES = 16 * 1024 * 1024
+MAX_INPUT_BYTES = ((1 << 31) - 1) // 64 * 64
+ROWS_TOPK = 512
+ROW_PACKS = ROWS_TOPK * 2 * 4 // PACK_BYTES
+
+
+def validate_input_layout(shape, element_size: int, max_input_bytes: int) -> int:
+    """Validate equal row quarters; return bytes sent to each destination."""
+    shape = tuple(int(dimension) for dimension in shape)
+    if not shape or any(dimension <= 0 for dimension in shape):
+        raise ValueError("owner input must have at least one dimension and no empty dimensions")
+    if shape[0] % WORLD_SIZE:
+        raise ValueError("owner input row count must be divisible by four")
+    if int(element_size) <= 0:
+        raise ValueError("element_size must be positive")
+    nbytes = prod(shape) * int(element_size)
+    if nbytes > int(max_input_bytes) or nbytes > MAX_INPUT_BYTES:
+        raise ValueError("owner input exceeds max_input_bytes or the signed Int32 byte bound")
+    peer_bytes = nbytes // WORLD_SIZE
+    if peer_bytes % PACK_BYTES:
+        raise ValueError("owner bytes per peer must be a positive multiple of 16")
+    return peer_bytes
+
+
+def validate_rows_layout(shape, element_size: int, max_input_bytes: int):
+    """Validate FP32 score/ID row geometry and return the fused output shape.
+
+    Runtime additionally checks the actual Torch dtype; element_size alone
+    cannot distinguish float32 from other four-byte types.
+    """
+    shape = tuple(int(dimension) for dimension in shape)
+    if len(shape) != 3 or shape[1:] != (ROWS_TOPK, 2) or element_size != 4:
+        raise ValueError("owner rows input must have FP32 [rows,512,2] layout")
+    validate_input_layout(shape, element_size, max_input_bytes)
+    return (shape[0] // WORLD_SIZE, WORLD_SIZE * ROWS_TOPK, 2)
+
+
+def rows_output_byte_offset(source: int, copy_index: int, owned_rows: int) -> int:
+    """CPU oracle for one source quarter's 16-byte pack destination.
+
+    Each source row has 256 packs; output rows concatenate sources 0..3. This
+    changes only the GPU output address, never registered receive addresses.
+    """
+    if source not in range(WORLD_SIZE) or owned_rows <= 0:
+        raise ValueError("source must be in [0,4) and owned_rows must be positive")
+    if not 0 <= copy_index < owned_rows * ROW_PACKS:
+        raise ValueError("copy_index must be within one source quarter")
+    row, column_pack = divmod(copy_index, ROW_PACKS)
+    return (row * (WORLD_SIZE * ROW_PACKS) + source * ROW_PACKS + column_pack) * PACK_BYTES
+
+
+def split_stripes(peer_bytes: int) -> tuple[tuple[int, int], tuple[int, int]]:
+    """The same pack-aligned two-way split used by native split_stripes."""
+    if peer_bytes <= 0 or peer_bytes % PACK_BYTES:
+        raise ValueError("peer_bytes must be a positive multiple of 16")
+    first = ((peer_bytes // PACK_BYTES + 1) // 2) * PACK_BYTES
+    return ((0, first), (first, peer_bytes - first))
+
+
+@dataclass(frozen=True)
+class RegionLayout:
+    slot_bytes: int
+    recv_off: int
+    flag_off: int
+    send_off: int
+    ctrl_off: int
+    total_bytes: int
+
+    @classmethod
+    def from_capacity(cls, max_input_bytes: int):
+        capacity = int(max_input_bytes)
+        if capacity < 64 or capacity > MAX_INPUT_BYTES or capacity % 64:
+            raise ValueError("max_input_bytes must be a multiple of 64 in [64, 2147483584]")
+        slot_bytes = (capacity + 4095) // 4096 * 4096
+        flag_off = WORLD_SIZE * SLOTS * slot_bytes
+        send_off = flag_off + WORLD_SIZE * SLOTS * 2 * FLAG_STRIDE
+        ctrl_off = send_off + SLOTS * slot_bytes
+        return cls(slot_bytes, 0, flag_off, send_off, ctrl_off, ctrl_off + FLAG_STRIDE)
+
+    def transfers(self, source: int, seq: int, input_bytes: int):
+        """Yield (destination, path, source offset, receive offset, length)."""
+        if source not in range(WORLD_SIZE):
+            raise ValueError("source must be in [0,4)")
+        if input_bytes <= 0 or input_bytes % 64:
+            raise ValueError("input_bytes must be a positive multiple of 64")
+        peer_bytes = validate_input_layout((4, input_bytes // 4), 1, self.slot_bytes)
+        slot = seq & 1
+        for destination in range(WORLD_SIZE):
+            if destination == source:
+                continue
+            for path, (offset, length) in enumerate(split_stripes(peer_bytes)):
+                yield (
+                    destination, path,
+                    self.send_off + slot * self.slot_bytes + destination * peer_bytes + offset,
+                    self.recv_off + (source * SLOTS + slot) * self.slot_bytes + offset,
+                    length,
+                )
