+                key = self._launcher_key()
+                if capturing and not _alltoall_cute.is_launcher_prepared(*key):
+                    raise RuntimeError("call owner prepare() before CUDA graph capture")
+                launcher = _alltoall_cute.get_launcher(*key)
+                if out is None:
