+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU routing oracle; does not qualify CUDA kernels or network transport."""
+
+from unittest.mock import patch
+
+import torch
+
+from vllm.v1.attention.backends.mla import dcp_owner_merge as owner
+
+
+def stable(data, k, out):
+    ids = data[:, :, 1].to(torch.int32)
+    order = torch.argsort(torch.where(ids >= 0, ids, 2147483647), stable=True)
+    scores = data[:, :, 0].gather(1, order)
+    ranked = torch.argsort(scores, descending=True, stable=True)[:, :k]
+    out.copy_(ids.gather(1, order).gather(1, ranked))
+
+
+def test_owner_routes_ties_invalids_and_global_ids():
+    torch.manual_seed(7)
+    rows, k, world = 12, 512, 4
+    candidates = []
+    for rank in range(world):
+        scores = torch.randint(0, 8, (rows, k)).float()
+        ids = (torch.arange(k) * 4 + rank).expand(rows, -1).float().clone()
+        scores[:, -20:] = -float("inf")
+        ids[:, -20:] = -1
+        candidates.append(torch.stack((scores, ids), -1))
+    oracle = torch.empty((rows, k), dtype=torch.int32)
+    stable(torch.cat(candidates, dim=1), k, oracle)
+    for rank in range(world):
+        lo, hi = rank * (rows // world), (rank + 1) * (rows // world)
+        scratch = [
+            torch.empty(shape, dtype=dtype)
+            for shape, dtype in owner.owner_workspace_shapes(rows, k, world)
+        ]
+
+        def exchange(receive, send, group, rank=rank, lo=lo, hi=hi):
+            assert torch.equal(send, candidates[rank].flatten())
+            receive.copy_(torch.stack([x[lo:hi] for x in candidates]).flatten())
+
+        def gather(output, owned, group, lo=lo, hi=hi):
+            assert torch.equal(owned, oracle[lo:hi])
+            output.copy_(oracle)
+
+        result = torch.empty_like(oracle)
+        with (
+            patch.object(owner.dist, "get_world_size", return_value=4),
+            patch.object(owner.dist, "all_to_all_single", side_effect=exchange),
+            patch.object(owner.dist, "all_gather_into_tensor", side_effect=gather),
+        ):
+            owner.merge_by_owner(candidates[rank], result, None, scratch, stable)
+        assert torch.equal(result, oracle)
+
+
+def test_invalid_owner_geometry_rejects_before_dividing():
+    import pytest
+
+    for rows, topk, world in [(12, 512, 0), (3, 512, 4), (0, 512, 4), (16, 1024, 4)]:
+        with pytest.raises(ValueError):
+            owner.owner_workspace_shapes(rows, topk, world)
