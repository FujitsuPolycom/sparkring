--- /dev/null
+++ b/vllm/third_party/sparkring_mesh_owner/runtime.py
@@ -0,0 +1,791 @@
+"""Dedicated managed-mesh owner all-to-all; never shares a serving proxy."""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+import os
+import threading
+from contextlib import contextmanager
+from typing import Any, Optional, Sequence
+
+import torch
+import torch.distributed as dist
+from torch.distributed import ProcessGroup
+
+from . import _alltoall_cute, _pack_alltoall_cute
+from .pack_layout import DEFAULT_MAX_POOL_SIZE, TOPK, validate_pack_contract
+from .layout import (API_VERSION, DEFAULT_MAX_INPUT_BYTES, PACK_BYTES, RegionLayout, validate_input_layout)
+from ._path_config import (
+    OPPOSITE_PATHS_ENV,
+    PATH_COUNT,
+    opposite_path_count as _opposite_path_count,
+    peer_hca_map as _peer_hca_map,
+    validate_owner_mapping,
+)
+from ._proxy import Layout, Proxy, load as _load_proxy_library
+
+logger = logging.getLogger(__name__)
+
+SUPPORTED_WORLD_SIZES = (4,)
+DEFAULT_THREADS = 512
+DEFAULT_BLOCKS = 8
+
+DEFAULT_GID_INDEX = 3
+# Polls of a peer flag before the kernel gives up (each poll is a system-scope
+# load of host memory, roughly a microsecond): about 20 s.
+DEFAULT_SPIN_LIMIT = 20_000_000
+
+
+def _env_list(*names: str) -> tuple[str, ...]:
+    """First non-empty comma-separated list among the environment variables ``names``."""
+    for name in names:
+        raw = os.getenv(name)
+        if raw:
+            items = []
+            for item in raw.split(","):
+                item = item.strip().lstrip("=^")
+                if item:
+                    items.append(item.split(":")[0])
+            if items:
+                return tuple(items)
+    return ()
+
+
+def _env_int(*names: str, default: int) -> int:
+    """First integer-valued environment variable among ``names``, else ``default``."""
+    for name in names:
+        raw = os.getenv(name)
+        if raw:
+            return int(raw)
+    return default
+
+
+def default_gid_index() -> int:
+    """Use MESH_OWNER_GID_INDEX or the managed route default, 3."""
+
+    return _env_int("MESH_OWNER_GID_INDEX", default=DEFAULT_GID_INDEX)
+
+
+def discover_hcas(gid_index: Optional[int] = None) -> tuple[str, ...]:
+    """Return MESH_OWNER_HCA or the managed mesh's canonical device order."""
+
+    explicit = _env_list("MESH_OWNER_HCA")
+    if explicit:
+        return explicit
+    from ._path_config import CANONICAL_TP4_HCAS
+
+    return CANONICAL_TP4_HCAS
+
+
+def is_supported(device: torch.device | int | str | None = None) -> bool:
+    """True on an integrated GPU with at least one active RDMA device.
+
+    The kernel reads pinned host memory in place, which needs an integrated
+    (unified-memory) GPU such as the DGX Spark GB10.
+    """
+
+    if not torch.cuda.is_available():
+        return False
+    index = torch.cuda.current_device() if device is None else torch.device(device).index
+    props = torch.cuda.get_device_properties(index if index is not None else 0)
+    if not getattr(props, "is_integrated", False):
+        return False
+    return len(discover_hcas()) > 0
+
+
+def _normalize_device(device: torch.device | int | str) -> torch.device:
+    """Coerce an int, string, or device into a CUDA ``torch.device`` with an index."""
+    if isinstance(device, int):
+        device = torch.device("cuda", device)
+    elif not isinstance(device, torch.device):
+        device = torch.device(device)
+    if device.type != "cuda":
+        raise ValueError("owner all-to-all requires a CUDA device")
+    if device.index is None:
+        device = torch.device("cuda", torch.cuda.current_device())
+    return device
+
+
+def _capture_id(stream: torch.cuda.Stream) -> int:
+    """CUDA's id of the capture ``stream`` is in, 0 when it is not capturing.
+
+    Two captures are distinct even on the same stream, and one capture can be
+    joined by several streams; the id identifies the capture itself.
+    """
+
+    from cuda.bindings import runtime as cudart
+
+    info = cudart.cudaStreamGetCaptureInfo(stream.cuda_stream)
+    if info[0] != cudart.cudaError_t.cudaSuccess:
+        return 0
+    if info[1] != cudart.cudaStreamCaptureStatus.cudaStreamCaptureStatusActive:
+        return 0
+    return int(info[2])
+
+
+def _exchange(local: object, group: ProcessGroup) -> list[object]:
+    """All-gather one picklable object from every rank of ``group``."""
+    gathered: list[object] = [None] * dist.get_world_size(group=group)
+    dist.all_gather_object(gathered, local, group=group)
+    return gathered
+
+
+class MeshOwnerAllToAll:
+    """Dedicated owner all-to-all over the DGX Spark 200 GbE fabric."""
+
+    algorithm = API_VERSION
+
+    def __init__(
+        self,
+        *,
+        exchange_group: ProcessGroup,
+        device: torch.device | int | str,
+        max_input_bytes: Optional[int] = None,
+        max_size: Optional[int] = None,
+        max_gather_bytes: Optional[int] = None,
+        hca_names: Optional[Sequence[str]] = None,
+        gid_index: Optional[int] = None,
+        threads: int = DEFAULT_THREADS,
+        blocks: int = DEFAULT_BLOCKS,
+    ) -> None:
+        """Allocate the pinned region, build and connect the proxy, and start it."""
+        self.rank = dist.get_rank(group=exchange_group)
+        self.world_size = dist.get_world_size(group=exchange_group)
+        self._group = exchange_group
+        self._closed = False
+        self._lock = threading.Lock()
+        self._proxy: Optional[Proxy] = None
+        self._last_stream: Optional[torch.cuda.Stream] = None
+        self._capture_stream: Optional[torch.cuda.Stream] = None
+        self._capture_id = 0
+        path_error: Optional[str] = None
+        self._opposite_paths = PATH_COUNT
+        self._peer_hca_map: tuple[tuple[int, ...], ...] = tuple()
+        try:
+            self.device = _normalize_device(device)
+            self._stream_event = torch.cuda.Event()
+            if self.world_size not in SUPPORTED_WORLD_SIZES:
+                raise ValueError(
+                    f"unsupported owner all-to-all world size {self.world_size}; "
+                    f"supported sizes are {SUPPORTED_WORLD_SIZES}"
+                )
+            capacities = [
+                int(value) for value in (max_input_bytes, max_size, max_gather_bytes)
+                if value is not None
+            ] or [DEFAULT_MAX_INPUT_BYTES]
+            for capacity in capacities:
+                RegionLayout.from_capacity(capacity)
+            self.max_input_bytes = max(capacities)
+            cpu_layout = RegionLayout.from_capacity(self.max_input_bytes)
+            if int(threads) % 32 != 0 or int(threads) < 32 or int(threads) > 1024:
+                raise ValueError("threads must be a multiple of 32 between 32 and 1024")
+            if int(blocks) < 1 or int(blocks) & (int(blocks) - 1) != 0:
+                # The kernels find the last arriving block with a modulo of a
+                # free-running 32-bit counter, which survives the counter wrap only
+                # for a power-of-two block count.
+                raise ValueError("blocks must be a positive power of two")
+            if self.world_size != 4 or int(threads) != 512 or int(blocks) != 8:
+                raise ValueError("owner prototype requires world_size=4, threads=512, blocks=8")
+            self.max_size = self.max_input_bytes
+            self._threads = int(threads)
+            self._blocks = int(blocks)
+            self.gid_index = default_gid_index() if gid_index is None else int(gid_index)
+            self.spin_limit = _env_int("MESH_OWNER_SPIN_LIMIT", default=DEFAULT_SPIN_LIMIT)
+            if self.spin_limit < 1 or self.spin_limit > 0xFFFFFFFF:
+                raise ValueError("MESH_OWNER_SPIN_LIMIT must be in [1,4294967295]")
+            if self.gid_index != 3:
+                raise ValueError("owner mesh route contract requires GID index 3")
+            names = tuple(hca_names) if hca_names else discover_hcas(self.gid_index)
+            if not names:
+                raise RuntimeError("no active RDMA device found for the owner all-to-all")
+            self.hca_names = names
+            self._opposite_paths = _opposite_path_count(
+                self.world_size, len(self.hca_names)
+            )
+            self._peer_hca_map = _peer_hca_map(
+                self.world_size,
+                self.rank,
+                len(self.hca_names),
+                self._opposite_paths,
+            )
+            validate_owner_mapping(
+                self.hca_names,
+                self.world_size,
+                self.rank,
+                self._peer_hca_map,
+                self._opposite_paths,
+            )
+        except Exception as exc:  # noqa: BLE001 - voted across every rank below
+            path_error = str(exc)
+        path_statuses = _exchange(
+            (path_error, self._opposite_paths), exchange_group
+        )
+        path_failures = [
+            f"rank {index}: {status[0]}"
+            for index, status in enumerate(path_statuses)
+            if status[0] is not None
+        ]
+        path_counts = {int(status[1]) for status in path_statuses}
+        if len(path_counts) != 1:
+            path_failures.append(
+                f"ranks selected different {OPPOSITE_PATHS_ENV} values: "
+                f"{sorted(path_counts)}"
+            )
+        if path_failures:
+            raise RuntimeError(
+                "owner all-to-all path preflight failed: " + "; ".join(path_failures)
+            )
+
+        error: Optional[str] = None
+        try:
+            slot_bytes = cpu_layout.slot_bytes
+            self._layout = Layout(self.world_size, slot_bytes)
+            self._slot_bytes = slot_bytes
+            for field in ("recv_off", "flag_off", "send_off", "ctrl_off", "total_bytes"):
+                if getattr(self._layout, field) != getattr(cpu_layout, field):
+                    raise RuntimeError(f"owner proxy layout mismatch: {field}")
+
+            with torch.cuda.device(self.device):
+                # Pinned, zero-initialised: flags and the control record start at 0
+                # and the first sequence number is 1.
+                self._region = torch.zeros(
+                    self._layout.total_bytes, dtype=torch.uint8, device="cpu", pin_memory=True
+                )
+                self._counters = torch.zeros(4, dtype=torch.int32, device=self.device)
+            host_ptr = self._region.data_ptr()
+            device_ptr = self._device_pointer(host_ptr)
+            if device_ptr != host_ptr:
+                raise RuntimeError(
+                    "owner all-to-all needs host pointers that are directly device "
+                    "accessible (integrated GPU with unified addressing)"
+                )
+            self._recv_base = host_ptr + self._layout.recv_off
+            self._flag_base = host_ptr + self._layout.flag_off
+            self._send_base = host_ptr + self._layout.send_off
+            self._ctrl_base = host_ptr + self._layout.ctrl_off
+            # ctrl record (kernel-written): seq, nbytes, error seq, missing peer,
+            # nbytes per slot (the proxy uses these when it has to catch up)
+            self._ctrl_words = self._region[
+                self._layout.ctrl_off : self._layout.ctrl_off + 28
+            ].view(torch.int32)
+            self._error_word = self._ctrl_words[2:3]
+            # numpy view of the control words: reading it costs nanoseconds, so the
+            # health check before and after every launch stays off the profile.
+            self._ctrl_np = self._ctrl_words.numpy()
+            self._epoch_address = self._counters.data_ptr()
+
+            self._proxy = Proxy(
+                world_size=self.world_size,
+                rank=self.rank,
+                hca_names=self.hca_names,
+                gid_index=self.gid_index,
+                region_ptr=host_ptr,
+                region_bytes=self._layout.total_bytes,
+                slot_bytes=slot_bytes,
+                peer_hca_map=self._peer_hca_map,
+                opposite_paths=self._opposite_paths,
+            )
+            blob = self._proxy.local_blob()
+        except Exception as exc:  # noqa: BLE001 - reported collectively below
+            error = str(exc)
+            blob = b""
+        # Every rank publishes the configuration the protocol depends on; the
+        # ranks must agree exactly, and all of them see the same verdict.
+        config = {}
+        if error is None:
+            config = {
+                "api_version": API_VERSION,
+                "proxy_abi": _load_proxy_library().roce_abi_version() if error is None else None,
+                "world_size": self.world_size,
+                "hca_count": len(self.hca_names),
+                "slot_bytes": slot_bytes,
+                "slots": self._layout.slots,
+                "paths": self._layout.paths,
+                "opposite_paths": self._opposite_paths,
+                "origin_paths_per_rank": 2 * (self.world_size - 2) + self._opposite_paths
+                if self.world_size == 4
+                else PATH_COUNT * (self.world_size - 1),
+                "two_wave_threshold_bytes": (
+                    self._proxy.two_wave_threshold_bytes()
+                    if self._proxy is not None
+                    else None
+                ),
+                "wave_mode": self._proxy.wave_mode() if self._proxy is not None else None,
+                "flag_stride": self._layout.flag_stride,
+                "max_size": self.max_size,
+                "max_input_bytes": self.max_input_bytes,
+                "spin_limit": self.spin_limit,
+                "threads": self._threads,
+                "blocks": self._blocks,
+                "operation": API_VERSION,
+            }
+        statuses = _exchange((error, blob, config), exchange_group)
+        failures = [f"rank {i}: {s[0]}" for i, s in enumerate(statuses) if s[0] is not None]
+        if not failures:
+            reference = statuses[0][2]
+            for i, s in enumerate(statuses):
+                differing = {k: (reference[k], s[2].get(k)) for k in reference if s[2].get(k) != reference[k]}
+                if differing:
+                    failures.append(f"rank {i} configuration differs from rank 0: {differing}")
+        if failures:
+            self.close()
+            raise RuntimeError("owner all-to-all setup failed: " + "; ".join(failures))
+        try:
+            self._proxy.connect([s[1] for s in statuses])
+            self._proxy.start()
+        except Exception as exc:  # noqa: BLE001
+            error = str(exc)
+        verdicts = _exchange(error, exchange_group)
+        failures = [f"rank {i}: {v}" for i, v in enumerate(verdicts) if v is not None]
+        if failures:
+            self.close()
+            raise RuntimeError("owner all-to-all connect failed: " + "; ".join(failures))
+        if self.rank == 0:
+            logger.info(
+                "Mesh owner exchange ready: world=%d hcas=%s gid_index=%d max_size=%d",
+                self.world_size,
+                ",".join(self.hca_names),
+                self.gid_index,
+                self.max_size,
+            )
+
+    @staticmethod
+    def _device_pointer(host_ptr: int) -> int:
+        """Device address of pinned host memory (``cudaHostGetDevicePointer``)."""
+        from cuda.bindings import runtime as cudart
+
+        err, ptr = cudart.cudaHostGetDevicePointer(host_ptr, 0)
+        if err != cudart.cudaError_t.cudaSuccess:
+            raise RuntimeError(f"cudaHostGetDevicePointer failed: {err}")
+        return int(ptr)
+
+
+    @classmethod
+    def from_exchange_group(cls, *, exchange_group, device, **kwargs):
+        return cls(exchange_group=exchange_group, device=device, **kwargs)
+
+    @classmethod
+    def from_process_group(cls, *, process_group, device, **kwargs):
+        return cls(exchange_group=process_group, device=device, **kwargs)
+
+    def for_stream(self, stream=None, **kwargs):
+        return self
+
+    def _launcher_key(self):
+        return (
+            self.world_size, self.rank, self._threads, self._layout.slots,
+            self._layout.flag_stride, self._opposite_paths, self.device.index,
+        )
+
+    def prepare(self):
+        """Compile the byte-copy launcher before graph capture; no payload is sent."""
+        with self._lock, torch.cuda.device(self.device):
+            self.check_health()
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError("owner prepare() must run before CUDA graph capture")
+            _alltoall_cute.get_launcher(*self._launcher_key())
+
+
+    def prepare_pack(self, *, interleave=1):
+        """Compile fused packing before capture; does not allocate packed scratch."""
+        # Bound-only check also keeps the scalar interleave within signed Int32.
+        validate_pack_contract(4, interleave, 1, self.max_input_bytes)
+        with self._lock, torch.cuda.device(self.device):
+            self.check_health()
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError("prepare_pack() must run before CUDA graph capture")
+            _pack_alltoall_cute.get_launcher(*self._launcher_key(), int(interleave))
+
+    def pack_all_to_all(
+        self, indices, scores, out=None, *, interleave=1,
+        max_pool_size=DEFAULT_MAX_POOL_SIZE, stream=None,
+    ):
+        """Pack int32 local IDs/fp32 scores directly into the registered send slot.
+
+        Input shape is [rows,512], output is fp32[rows,512,2] in source order.
+        max_pool_size is an exclusive bound on every nonnegative local ID.
+        Positive out-of-bound IDs poison the runtime during staging.
+        """
+        with self._lock:
+            self.check_health()
+            for name, tensor, dtype in (
+                ("indices", indices, torch.int32), ("scores", scores, torch.float32)
+            ):
+                if not isinstance(tensor, torch.Tensor):
+                    raise TypeError(f"{name} must be a torch.Tensor")
+                if (
+                    tensor.dtype != dtype or tensor.device != self.device
+                    or tensor.layout != torch.strided or tensor.ndim != 2
+                    or tensor.shape[1] != TOPK or not tensor.is_contiguous()
+                    or tensor.is_conj() or tensor.is_neg()
+                ):
+                    raise ValueError(f"{name} must be contiguous CUDA {dtype}[rows,512] on the runtime device")
+                if tensor.data_ptr() % PACK_BYTES:
+                    raise ValueError(f"{name} must be 16-byte aligned")
+            if scores.shape != indices.shape:
+                raise ValueError("indices and scores must have equal shape")
+            rows = int(indices.shape[0])
+            peer_bytes = validate_pack_contract(rows, interleave, max_pool_size, self.max_input_bytes)
+            nbytes = peer_bytes * self.world_size
+            shape = (rows, TOPK, 2)
+            if out is not None:
+                if not isinstance(out, torch.Tensor):
+                    raise TypeError("out must be a torch.Tensor")
+                if (
+                    out.dtype != torch.float32 or out.device != self.device
+                    or tuple(out.shape) != shape or out.layout != torch.strided
+                    or not out.is_contiguous() or out.is_conj() or out.is_neg()
+                    or out.data_ptr() % PACK_BYTES
+                ):
+                    raise ValueError("out must be aligned contiguous CUDA float32[rows,512,2]")
+                for tensor in (indices, scores):
+                    source_bytes = tensor.numel() * tensor.element_size()
+                    if tensor.data_ptr() < out.data_ptr() + nbytes and out.data_ptr() < tensor.data_ptr() + source_bytes:
+                        raise ValueError("out must not overlap indices or scores")
+            context = torch.cuda.stream(stream) if stream is not None else _nullcontext()
+            with torch.cuda.device(self.device), context:
+                capturing = torch.cuda.is_current_stream_capturing()
+                key = (*self._launcher_key(), int(interleave))
+                if capturing and not _pack_alltoall_cute.is_launcher_prepared(*key):
+                    raise RuntimeError("call prepare_pack(interleave=...) before CUDA graph capture")
+                launcher = _pack_alltoall_cute.get_launcher(*key)
+                if out is None:
+                    out = torch.empty(shape, dtype=torch.float32, device=self.device)
+                self._order_stream(capturing)
+                launcher(
+                    indices.data_ptr(), scores.data_ptr(), out.data_ptr(),
+                    peer_bytes // PACK_BYTES, nbytes, int(max_pool_size),
+                    self._recv_base, self._flag_base, self._send_base, self._ctrl_base,
+                    self._slot_bytes, self._epoch_address, self.spin_limit, self._blocks,
+                )
+                current = torch.cuda.current_stream(self.device)
+                indices.record_stream(current)
+                scores.record_stream(current)
+                out.record_stream(current)
+                self._mark_stream(capturing)
+        if not capturing:
+            self.check_health()
+        return out
+
+    def prepare_pack_rows(self, *, interleave=1):
+        """Compile fused packing before capture; does not allocate packed scratch."""
