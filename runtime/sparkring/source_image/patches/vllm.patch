+            (boundary,)
+            if end % block_size
+            and start < boundary < end
+            and (boundary - start) % 16 == 0
+            else ()
+        )
+    return (
+        [p - start for p in targets] + [0] * (capacity - len(targets)),
+        [p // block_size - 1 for p in targets] + [-1] * (capacity - len(targets)),
+    )
