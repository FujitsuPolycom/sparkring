+    local_seq_lens = rounds * cp_kv_cache_interleave_size + remainder
+    local_seq_lens = tl.where(offsets < num_reqs, local_seq_lens, 0)
+    tl.store(out_ptr + offsets, local_seq_lens, mask=offsets < max_num_reqs)
