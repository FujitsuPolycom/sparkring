index 0000000000..c054e0ae08
--- /dev/null
+++ b/vllm/third_party/sparkring_mesh_owner/pack_layout.py
@@ -0,0 +1,38 @@
+"""CPU admission and reference mapping for direct candidate staging."""
+
+from operator import index
+
+from .layout import validate_input_layout
+
+TOPK = 512
+MAX_ROWS = 8192
+DEFAULT_MAX_POOL_SIZE = 1 << 22
+MAX_EXACT_ID = 1 << 24  # Strict upper bound, matching production float ID wire.
+PACK_API_VERSION = "mesh-owner-pack-all-to-all-v1"
+
+
+def validate_pack_contract(rows, interleave, max_pool_size, max_input_bytes):
+    rows, interleave, max_pool_size = map(index, (rows, interleave, max_pool_size))
+    if rows < 4 or rows > MAX_ROWS or rows % 4:
+        raise ValueError("pack_all_to_all requires a multiple of four rows in [4,8192]")
+    if interleave < 1 or max_pool_size < 1:
+        raise ValueError("interleave and max_pool_size must be positive integers")
+    last = max_pool_size - 1
+    largest_global_id = (last // interleave) * (4 * interleave) + 3 * interleave + last % interleave
+    if largest_global_id >= MAX_EXACT_ID:
+        raise ValueError("max_pool_size/interleave can generate a global ID >= 2**24")
+    return validate_input_layout((rows, TOPK, 2), 4, max_input_bytes)
+
+
+def reference_candidate(local_index, score, rank, interleave=1, max_pool_size=DEFAULT_MAX_POOL_SIZE):
+    """Exact scalar production mapping; invalid positive IDs violate admission."""
+    local_index, rank = index(local_index), index(rank)
+    validate_pack_contract(4, interleave, max_pool_size, 4 * TOPK * 8)
+    if rank not in range(4):
+        raise ValueError("rank must be in [0,4)")
+    if local_index < 0:
+        return float("-inf"), -1.0
+    if local_index >= max_pool_size:
+        raise ValueError("local candidate ID exceeds max_pool_size")
+    global_id = (local_index // interleave) * (4 * interleave) + rank * interleave + local_index % interleave
+    return score, float(global_id)
