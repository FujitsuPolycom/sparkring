+    def __del__(self) -> None:  # pragma: no cover - defensive teardown
+        """Release an open transport without relying on module globals at shutdown."""
+        try:
+            if self._closed:
+                return
+            self.close()
+        except Exception:
+            pass
+
+
+class _nullcontext:
+    def __enter__(self):
+        """No-op context entry."""
+        return None
+
+    def __exit__(self, *exc):
+        """No-op context exit."""
+        return False
