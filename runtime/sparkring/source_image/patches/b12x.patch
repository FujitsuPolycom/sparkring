+  -w /src local/glm53-r13-acceptance-eval:full-seven-flashinfer-b12x-da8f2cb3 \
+  -lc 'unset NCCL_GRAPH_FILE; PYTHONPATH=/src /opt/venv/bin/python -m pytest -q tests/gemm/test_mxfp8_linear.py'
+```
