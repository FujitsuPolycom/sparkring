+def test_four_checkpoint_binding_normalizes_cache_hit_fallback_and_clears_rows():
+    from vllm.model_executor.layers.mamba.gdn import kimi_gdn_linear_attn as module
+
+    observed = []
+
+    def bind(plan, **kwargs):
