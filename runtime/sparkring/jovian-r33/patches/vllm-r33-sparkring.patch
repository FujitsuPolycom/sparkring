+        get_state_dtype=lambda: (torch.float32, torch.float32),
+    )
+    plan = module.KimiGatedDeltaNetAttention._make_b12x_kda_prefill_plan(layer, 8)
+    assert isinstance(plan, OneCheckpointCaps)
