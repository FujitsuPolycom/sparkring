# syntax=docker/dockerfile:1.7
FROM local/sparkring:r33-arm64-foundation
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY torchvision/*.whl arm-wheels/*.whl /tmp/media-wheels/
COPY torchaudio/*.whl /tmp/torchaudio/
RUN python3 -m pip install --no-deps --force-reinstall /tmp/media-wheels/*.whl \
    && python3 -m pip install --no-deps --force-reinstall /tmp/torchaudio/*.whl \
    && rm -rf /tmp/media-wheels /tmp/torchaudio
COPY verify_media.py /opt/sparkring-build/verify_media.py
