# R33 GLM-5.3 NVFP4-Spark TP4/DCP1. Mesh endpoints come from the managed renderer.
SOURCE_IMAGE_PROFILE=tp4-dcp1
TENSOR_PARALLEL_SIZE=4
DECODE_CONTEXT_PARALLEL_SIZE=1
NODE_COUNT=4
NODE_RANK=<0-through-3>
MASTER_ADDR=<rank-0-management-address>
MAX_MODEL_LEN=1048576
KV_CACHE_MEMORY_BYTES=25769803776
NUM_SPECULATIVE_TOKENS=3
MAX_CUDAGRAPH_CAPTURE_SIZE=64
CUDAGRAPH_CAPTURE_SIZES=4,8,12,16,20,24,28,32,36,40,44,48,52,56,60,64
VLLM_B12X_KDA_PREFILL_COALESCING=1
VLLM_GLM53_MHC_PREFILL_SHARD=1
VLLM_GDN_SPEC_DECODE_METADATA_FASTPATH=1
PYTHONPATH=/opt/sparkring/sircl/python
SIRCL_ENABLED=1
VLLM_SPARK_TP4_MODE=custom
VLLM_SPARK_TP4_VOCAB_MODE=custom
VLLM_SPARK_SHARED_CAPTURE_STREAM=1
SPARK_TP4_HEALTH_GATE=1
NCCL_SWITCHLESS_RING_ONLY=1
NCCL_IB_HCA=<all-four-connected-hcas-with-port-1-selection>
NCCL_IB_PRESERVE_PCI_DOMAIN=1
NCCL_IB_ROUTE_DIAGNOSTICS=1
SPARKCACHE_ENABLED=0
