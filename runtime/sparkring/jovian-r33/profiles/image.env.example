# One qualified immutable image must be selected for every rank and topology.
# Replace both values from the same R33 construction receipt. A mutable tag is rejected.
SPARKRING_R33_IMAGE_REF=ghcr.io/fujitsupolycom/sparkring@sha256:<registry-manifest-sha256>
SPARKRING_R33_IMAGE_ID=sha256:<docker-config-sha256>
SPARKRING_R33_IMAGE_RECEIPT=/srv/sparkring/private/r33-image-receipt.json
# Keep the currently deployed image receipt and archive until both candidate profiles pass.
SPARKRING_ROLLBACK_RECEIPT=/srv/sparkring/private/rollback-image-receipt.json
